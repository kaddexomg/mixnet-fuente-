PROCEDURE GETBRpe
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC
YFACTOR=1
FFF=ROW()
CCC=COL()
CHKU=.F.
DO CASE
CASE ICAMPO=1
 @ FFF,CCC GET XITEM VALID CHKPITEM()
CASE ICAMPO=2
 @ FFF,CCC GET XUNIDAD WHEN W1() VALID SEL_UNI(UNIREF,@XUNIDAD,CHKU)
CASE ICAMPO=3
 @ FFF,CCC GET XBULTO  WHEN W1()   PICT "99999" VALID XBULTO>0
CASE ICAMPO=4
 @ FFF,CCC GET XCANTIDAD WHEN W1() PICT "999999.999"
CASE ICAMPO=5
 @ FFF,CCC GET XPRECIO  WHEN W1()  PICT cMasPrecPed VALID XPRECIO>0 .AND. CAMBUL(XCANTIDAD,XBULTO)*XPRECIO<89999999.99

** ocai 29/1/18
*CASE ICAMPO=6
*@ FFF,CCC GET XDESC  WHEN W1()    PICT "999.99"  VALID XDESC>=0 .AND. XDESC<=100.00

CASE ICAMPO=7
 @ FFF,CCC GET XDESCRIP PICT '@S35'
OTHERWISE
 SALIR=.T.
 RETURN
ENDCASE
READ
SALIR=ESCAPAR(1)
FUTREN()
RETURN

