PROCEDURE GETPED
* CAPTURA REGISTRO
private ed_renglon

SET KEY 279 TO
SET KEY -7 TO
if vtas_autor='S'
   SET KEY -8 TO
endif

DO WHILE .T.

 IF !DUPLI_DOC
    KEYBOARD SALIDA+IF(PV_EDN='S',SALIDA,'')
 ENDIF

 ED_RENGLON:=.F.
 IF PV_EDN='N'.AND.!MODIFICA
  @ 3,15 SAY SPACE(8)
 ENDIF

 IF vtas_mdcli='N'
    SET KEY -9 TO TOMA_DATO1()
    MENSAJ('F10 = Mas datos del '+IF(GESTION='VEN','Cliente','Proveedor'))
 ENDIF

 @  3,15 GET XNUMPED  PICT [@!] WHEN PV_EDN='S' VALID CHK_CLAVE(XNUMPED,'Pedido')
 @  3,31 GET XEMISION VALID CHKEJER(XEMISION)  .AND. !CHK_BLOCK(XEMISION)
 @  3,51 GET XENTREGA valid xentrega>=xemision
 @  3,72 GET XCAMBIO PICT '9999.99' WHEN vtas_edcamb='S' VALID !Empty(xcambio)
 @  4,15 GET XCLIENTE VALID CHCLI(@XCLIENTE)
 @  4,25 GET XNOMCLI VALID TOMA_DATO1(vtas_mdcli) PICT "@S35"
 @  4,72 GET Xcodsuc  WHEN hay_sucursal VALID BSucursal(@xcodsuc,5,50)
 @  5,15 GET XCODVEN VALID CHVEN(XCODVEN,5,25)
 @  6,74 SAY Xestatus
 @  6,15 GET XCOMEN1
 @  7,15 GET XCOMEN2
 @  7,74 GET XTARIFA
 LEER()
 IF ESCAPAR()
  IF ENTRO
   DO BELL
   IF DECIS([¨ Desea cancelar la operaci¢n ?],1)=[S]
    SALIR=.T.
   ELSE
    LOOP
   ENDIF
  ELSE
   SALIR=.T.
  ENDIF
 ENDIF

 IF SALIR
  SET KEY -7 TO DUP_PED
  IF PV_EDN='S'
   //CANCNUM(MXNUMPED,XNUMPED)
   CANCNUM(CFILNUM,XNUMPED)
  ENDIF
  DUPLI_DOC:=.F.
  SET KEY 279 TO REIMPRIM
  RETURN
 ENDIF

 IF EMPTY(XCLIENTE)
  KEYBOARD REPLICATE(SALIDA,2)
  LOOP
 ENDIF

 @ 7,74 SAY XTARIFA

 ENTRO=.T.

 IF ABRIR([MXCTASER],MXCTASER,[S],MXCTSEX1)
 IF ABRIR([BUFFER],BUFFER,[E])
  IF DUPLI_DOC
   REPLACE ALL DESPACHO WITH 0, DESBULTO WITH 0,ESTATUS WITH 'PE'
   DUPLI_DOC:=.F.
  ENDIF

  GO TOP
  RECAPED()
  GO TOP

  CLEAR TYPEAHEAD
  FP_TOTAL()
  SETCOLOR(C_TIT2)
  ed_renglon=.t.

  SET KEY -7 TO SER0000
  SET KEY -9 TO PIDE_COTIZ
  ustre:='USTREVEN'+Alltrim(Str(subopcion))
  ClvT:=&ustre
  &ustre.:='SSS'
  nTReg := LastRec()
  EDC([RPE],[],RSUBTIT,RCAMPO,.T.,.T.,.T.,.F.,.F.,.F.,.F.,.F.,'<ENTER>=INVENTARIO  F8=SERVICIOS  F10=COTIZACIONES  <ESC>=GRABAR',.T.)
  &ustre.:=ClvT

  SET KEY -7 TO

  @ maxrow()-5,8 SAY SPACE(35)

  SELECT BUFFER
  GO TOP
  IF LASTREC()=0 .OR. EOF()
   SELECT MXENCPED
   PANPED()
   CONFORME='N'
  ELSE
   nTReg:=LastRec()
   IF nTReg>0 .AND. pv_rengpag > 0 .AND. nTReg > pv_rengpag
      Alerta('SE INCLUYERON MAS RENGLONES QUE EL LIMITE POR RENGLONES ACEPTADO...')
      Alerta('LIMITE = '+ALLTRIM(STR(pv_rengpag,2))+' REGISTRO(S), DEBE BORRAR='+alltrim(str(ABS(PV_RENGPAG-nTReg))))
      CONFORME='N'
   ELSE
    CONFORME=CONFIRMA()
   ENDIF
  ENDIF

  DO CASE
   CASE CONFORME='S'
    IF PV_EDN='N'.AND.!MODIFICA
      //XNUMPED:=PROXINUM(MXNUMPED)
      XNUMPED:=PROXINUM(CFILNUM)
    ENDIF
    SELECT MXENCPED
    XNUMPED:=NEW_NUM(XNUMPED)
    SELECT BUFFER
    XESTATUS:=ESTAT_PED()
    REPLACE ALL  NUMPED WITH XNUMPED , EMISION WITH XEMISION, cliente with xcliente,codsuc with xcodsuc
   CASE CONFORME='C'
    IF PV_EDN='S'
     //CANCNUM(MXNUMPED,XNUMPED)
     CANCNUM(CFILNUM,XNUMPED)
    ENDIF
  ENDCASE
  CERRAR([BUFFER])
 ENDIF
 CERRAR('MXCTASER')
 ENDIF

EXIT
ENDDO
if vtas_autor='S'
   SET KEY -8 TO AUT_PED
endif
SELECT MXENCPED
SET KEY 279 TO REIMPRIM
SET KEY -7 TO DUP_PED
RETURN

