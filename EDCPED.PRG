STATIC FUNCTION INC_COTPED
PRIVATE tiene,ulias,Z_NUMERO
tiene = .f.
ulias = select()
IF ABRIR("MXENCCOT",G_CAMINO+[MXENCCOT.DBF],[S],G_CAMINO+[MXENCZX3.NTX])
 SEEK(XCLIENTE)
 IF FOUND()
  IF !EMPTY(XCODSUC)
     COPY TO (BUFCON) WHILE CLIENTE = XCLIENTE FOR ESTATUS<>'OK' .AND. CODSUC=XCODSUC
  ELSE
     COPY TO (BUFCON) WHILE CLIENTE = XCLIENTE FOR ESTATUS<>'OK'
  ENDIF
  IF ABRIR("BUFcon",bufcon,[S])
   if !eof()
    tiene=.t.
    Z_NUMERO=SPACE(8)
    satelite([ COTIZACIONES ],'NUMCOT','CODSUC','EMISION', 'FACSELPROG',LISTACOT)
    CERRAR("BUFCON")
    delete file (BUFCON)
    IF !EMPTY(Z_NUMERO)
     IF ABRIR("MXRENCOT",G_CAMINO+[MXRENCOT.DBF],[S],G_CAMINO+[MXRECZX1.NTX])
      SEEK(Z_NUMERO)
      IF !FOUND()
       CERRAR("MXRENCOT")
      ELSE
       COPY TO (BUFCOT) WHILE NUMCOT=Z_NUMERO
       CERRAR("MXRENCOT")
       ABRIR([BUFCOT],BUFCOT,[E])
       replace all cantidad with cantidad-despacho,;
                   precio   with if(xrecargo$"N2",precio+(precio*IVA(IVA,XEMISION)/100),PRECIO),;
                   bulto    with bulto   -desbulto,;
                   tot_ren  with CAMBUL(cantidad,bulto)*precio*(1-desc/100)

       delete for !difcero(tot_ren).AND.!EMPTY(ITEM)
       pack
       cerrar("BUFCOT")
      *******************************************************
       SELECT BUFFER
       APPEND FROM (BUFCOT)
       DELETE FILE (BUFCOT)

       VER_EX(1)

       RECAPED()
       IF EN_MENUH
        GO TOP
        NOFLECHA()
        PRIPAG()
        RECAPED()
       ELSE
        RECALCULA:=.T.
       ENDIF

      ENDIF
     ENDIF
    ENDIF
   ELSE
    CERRAR("BUFCON")
   endif
  endif

 ENDIF
 if !tiene
  PARE("Cliente no tiene COTIZACIONES")
 endif
ENDIF
CERRAR("MXENCCOT")
SELECT (ULIAS)
RETURN 0

