FUNCTION CHKpitem
LOCAL PRICHAR

IF LASTKEY()=5
 RETURN .T.
ENDIF

UNIREF = []
CHKU   = .F.

PRICHAR=SUBSTR(XITEM,1,1)

DO CASE
 CASE PRICHAR$[*]
  RETURN .T.
 CASE PRICHAR$[\/]
  SELE MXCTASER
  SEEK(SUBSTR(XITEM,2,5))
  IF !FOUND()
   SER0000()
   SELE BUFFER
   RETURN .F.
  ELSE
   XDESCRIP=PAD(MXCTASER->NOMSER,50)
   XPRECIO=MXCTASER->PRESER
   LPRECIO=MXCTASER->PRESER
   XIVA   =MXCTASER->IVA
   if !modifica
      if pv_cccli='N'
         XCODCON:=mxctainv->codcon
      else
         xcodcon:=mxctacli->codcon
      endif
   endif
   CHKU=.F.
   IF vtas_pbul='S'
      KEYBOARD REPLICATE(SALIDA,2)
   ELSE
      KEYBOARD REPLICATE(SALIDA,3)
   ENDIF
  ENDIF
  SELE BUFFER
OTHERWISE
  SELECT MXCTAINV
  SET ORDER TO 1
  LO_ENCONTRO:=.F.
  IF EMPTY(XITEM)
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       RETURN .T.
    ENDIF
     SELECT BUFFER
     RETURN .F.
  ENDIF
  IF DBSEEK(XITEM)
     LO_ENCONTRO:=.T.
  ELSE
     //LO_ENCONTRO:=.F.
     LO_ENCONTRO:=CHEQ_CODEXT()
  ENDIF
  IF LO_ENCONTRO
    CHKU=.T.
    XITEM:=CODART
    STORE UNIDAD TO XUNIDAD,UNIREF
    XULT_COSTO = MXCTAINV->ULT_COSTO
    XDESCRIP   = PAD(MXCTAINV->NOMART,50)
    XIVA       = MXCTAINV->IVA
    if !modifica
       if pv_cccli='N'
          XCODCON:=mxctainv->codcon
       else
          xcodcon:=mxctacli->codcon
       endif
    endif
    if pv_asc='S'
       xprecio    := MXCTAINV->costo_act
    else
       IF !MODIFICA
          GET_TARIFZ()
          LPRECIO:=XPRECIO
          XCANTIDAD  = IF(MXCTAINV->CAN_BUL>0,MXCTAINV->CAN_BUL,1)
       ELSEIF MODIFICA .AND. MITEM <> XITEM
          GET_TARIFZ()
          LPRECIO:=XPRECIO
       ENDIF
    endif
  ELSE
     SET ORDER TO 2
     IF DBSEEK(XITEM)
        LO_ENCONTRO:=.T.
     ELSE
        LO_ENCONTRO:=.F.
     ENDIF
  ENDIF
  SET ORDER TO 1
  IF LO_ENCONTRO
    CHKU=.T.
    XITEM:=CODART
    STORE UNIDAD TO XUNIDAD,UNIREF
    XULT_COSTO = MXCTAINV->ULT_COSTO
    XDESCRIP   = PAD(MXCTAINV->NOMART,50)
    XIVA       = MXCTAINV->IVA
    if !modifica
       if pv_cccli='N'
          XCODCON:=mxctainv->codcon
       else
          xcodcon:=mxctacli->codcon
       endif
    endif
    if pv_asc='S'
       xprecio    := MXCTAINV->costo_act
    else
       IF !MODIFICA
          GET_TARIFZ()
          LPRECIO:=XPRECIO
          XCANTIDAD  = IF(MXCTAINV->CAN_BUL>0,MXCTAINV->CAN_BUL,1)
       ELSEIF MODIFICA .AND. MITEM <> XITEM
          GET_TARIFZ()
          LPRECIO:=XPRECIO
       ENDIF
    endif
  ENDIF
  IF !LO_ENCONTRO
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       RETURN .T.
    ENDIF
     SELECT BUFFER
     RETURN .F.
  ELSE
     SELECT BUFFER
     IF vtas_pbul='S'
        KEYBOARD REPLICATE(SALIDA,2)
     ELSE
**      KEYBOARD REPLICATE(SALIDA,3)
        KEYBOARD REPLICATE(SALIDA,4) && antes 3 ocai 28/7/8
     ENDIF

  ENDIF
ENDCASE
SELECT BUFFER
RETURN .T.

