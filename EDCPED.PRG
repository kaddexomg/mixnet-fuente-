FUNCTION GEN_PED
PARAMETER REVERSO
PRIVATE XCANTIDAD,XITEM,XESTATUS,XDESPACHO,selant,mi_cotiz,ybulto,ycantidad
REVERSO= PCOUNT()=1
SELECT MXRENPED
SEEK(XNUMPED)
WHILE !EOF() .AND. NUMPED=XNUMPED
 XITEM=ITEM
 SELECT MXCTAINV
 SEEK(XITEM)
 IF FOUND()
  MENSAJ([Actualizando PEDIDOS ...])
  SELECT MXRENPED
  XCANTIDAD = CAMBUL(CANTIDAD,BULTO)
  xdespacho = DESPACHO*IF(DESBULTO>0,DESBULTO,1)
  XESTATUS  = ESTATUS
  ybulto    = bulto
  act_cot   = !Empty(numcot)
  mi_cotiz  = numcot
  ycantidad = cantidad
  SELECT MXCTAINV
  IF XESTATUS="PE"
   REC_LOCK(0)
   IF REVERSO
     REPLACE PEDIDO WITH PEDIDO-(XCANTIDAD-XDESPACHO)
     if act_cot
      selant:=Select()
      ABRIR("MXRENCOT",G_CAMINO+[MXRENCOT.DBF],[S],G_CAMINO+[MXRECZX2.NTX],G_CAMINO+[MXRECZX1.NTX])
      Rev_Cot(mi_cotiz)
      Cerrar('MXRENCOT')
      DbSelectar(selant)
     endif
   ELSE
     REPLACE PEDIDO WITH PEDIDO+(XCANTIDAD-XDESPACHO)
   ENDIF
   UNLOCK
  ENDIF
 ENDIF
 SELECT MXRENPED
 SKIP
ENDDO
RETURN 0

