Function BufferRqc(Buffer,modifica,cValue)
 Local uSelAnt:=Select()
 DbSelectar("MXRENRQC")
 IF !MODIFICA
    IF File(buffer) .AND. Dbvacio(Buffer)=1
       IF DECIS('Existe un archivo temporal con informaci¢n, ¨ Desea usarlo ?')='N'
          COPY STRUCTURE TO (BUFFER)
       ENDIF
    ELSE
       COPY STRUCTURE TO (BUFFER)
    ENDIF
 ELSE
   SEEK cValue
   IF File(buffer) .AND. Dbvacio(Buffer)=1
      IF DECIS('Existe un archivo temporal con informaci¢n, ¨ Desea usarlo ?')='N'
         COPY TO (BUFFER) WHILE NUMRQC = cVALUE
      ENDIF
   ELSE
      COPY TO (BUFFER) WHILE NUMRQC = cVALUE
   ENDIF
 ENDIF
 DbSelectar(uSelAnt)
Return nil

Function BBufferRqc(buffer)
  DELETE FILE (buffer)
Return nil

FUNCTION RQCCHKITEM
LOCAL PRICHAR
EXMIN:=0
IF LASTKEY()=5
 RETURN .T.
ENDIF
UNIREF = []
CHKU   = .F.
PRICHAR=SUBSTR(XITEM,1,1)
DO CASE
 CASE PRICHAR=[\]
  SELE MXCTASER
  SEEK(SUBSTR(XITEM,2,5))
  IF !FOUND()
   SER0000()
   SELE BUFFER
   RETURN .F.
  ELSE
   xpeso:=0
   XDESCRIP=PAD(MXCTASER->NOMSER,50)
   XPRECIO:=E_IMPORTE(MXCTASER->PRESER,XEMISION)
   IF !MODIFICA
      XCODCON:=REFCON
   ENDIF
   LPRECIO=XPRECIO
   XIVA   =MXCTASER->IVA
   XULT_COSTO = 0
   XRALMACEN:=SPACE(2)
   CHKU=.F.
  * KEYBOARD REPLICATE(SALIDA,4)
  ENDIF
  SELE BUFFER
 CASE PRICHAR=[*]
  xpeso:=0
  STORE 0 TO XBULTO,XCANTIDAD
  XIVA=' '
 OTHERWISE
  SELECT MXCTAINV
  SET ORDER TO 1
  LO_ENCONTRO:=.F.
  IF EMPTY(XITEM)
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       XRALMACEN:=SPACE(2)
       RETURN .T.
    ENDIF
    SELECT BUFFER
    RETURN .F.
  ENDIF
  IF DBSEEK(XITEM)
     LO_ENCONTRO:=.T.
  ELSE
     LO_ENCONTRO:=.F.
  ENDIF
  IF LO_ENCONTRO
     XEXMIN:=EXMIN
     XEXMAX:=EXMAX
     IF !MODIFICA
        XCODCON:=CODCON
     ENDIF
     xpeso:=peso
     COPI_ART()
  ELSE
     SET ORDER TO 2
     IF DBSEEK(XITEM)
        LO_ENCONTRO:=.T.
     ELSE
        LO_ENCONTRO:=.F.
     ENDIF
  ENDIF
  SET ORDER TO 1
  IF LO_ENCONTRO
     XITEM :=CODART
     XEXMIN:=EXMIN
     XEXMAX:=EXMAX
     XCODCON:=CODCON
     XPESO  :=PESO
     COPI_ART()
  ENDIF
  IF !LO_ENCONTRO
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       XRALMACEN:=SPACE(2)
       RETURN .T.
    ENDIF
     SELECT BUFFER
     RETURN .F.
  ELSE
     SELECT BUFFER
*     KEYBOARD REPLICATE(SALIDA,4)
  ENDIF
ENDCASE

RETURN .T.

STATIC PROC COPI_ART
 CHKU=.T.
 STORE UNIDAD TO XUNIDAD,UNIREF
 XULT_COSTO = MXCTAINV->ULT_COSTO
 IF !MODIFICA
  GET_TARIFA()
  XCANTIDAD  = IF(MXCTAINV->CAN_BUL>0,MXCTAINV->CAN_BUL,1)
 ELSEIF MODIFICA.AND.XITEM<>MITEM
  GET_TARIFA()
 ENDIF
 XIVA       = MXCTAINV->IVA
 XDESCRIP   = PAD(MXCTAINV->NOMART,50)
 LPRECIO   := xprecio
 XPRECIO_MAX:=E_IMPORTE(MXCTAINV->PRECIO_MAX,XEMISION)
 XPRECIO_MIN:=E_IMPORTE(MXCTAINV->PRECIO_MIN,XEMISION)
RETURN

