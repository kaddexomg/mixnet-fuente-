@ CONTLIN,22 GET BNUMDOC
@ CONTLIN,31 GET BCONCEPTO PICT [@S27]
@ CONTLIN,58 GET URELA VALID URELA$[= \< \> \<=\>=\<>]
@ CONTLIN,61 GET BIMPORTE PICT PIC17
leer()
SALIR=ESCAPAR()
IF !SALIR
  TCODMOVBAN=UPPER(TRIM(BCODMOVBAN))
  TTIPBAN=BTIPBAN
  TNUMDOC=BNUMDOC
  TCONCEPTO=TRIM(BCONCEPTO)
  POR_INDICE=.F.
  IF !EMPTY(TCODMOVBAN)
   YKEY=TCODMOVBAN
   POR_INDICE=.T.
  ENDIF
  IF nMostrar=1
     BCONDICION=IF(EMPTY(TNUMDOC),[.T.],[TNUMDOC=NUMDOC])+IF(EMPTY(BCONCEPTO),[],[.AND.TCONCEPTO$CONCEPTO])+IF(EMPTY(BIMPORTE),[],[.AND.ABS(IMPORTE)]+URELA+[ABS(BIMPORTE)])+;
     IF(EMPTY(BFECHA_MOV),[],[.AND.FECHA_MOV=BFECHA_MOV])+IF(EMPTY(TTIPBAN),[],[.AND.TIPBAN=TTIPBAN])
  ELSE
     BCONDICION=IF(EMPTY(TNUMDOC),[.T.],[TNUMDOC=NUMDOC])+IF(EMPTY(BCONCEPTO),[],[.AND.TCONCEPTO$BENEFICIA])+IF(EMPTY(BIMPORTE),[],[.AND.ABS(IMPORTE)]+URELA+[ABS(BIMPORTE)])+;
     IF(EMPTY(BFECHA_MOV),[],[.AND.FECHA_MOV=BFECHA_MOV])+IF(EMPTY(TTIPBAN),[],[.AND.TIPBAN=TTIPBAN])
   ENDIF
  POR_AMBOS=POR_INDICE.AND.!BCONDICION==[.T.]
ENDIF
RETURN

FUNCTION IGUALAU2
* IGUAL AUXILIAR
IF ORIGEN$[CXC/CXP/REM] .AND. MULTICAN
  alerta([ATENCION. Movimiento proveniente de una cancelaci¢n m£ltiple.])
ENDIF
IF ORIGEN<>DOC_ORIGEN
 DO CASE
  CASE ORIGEN$[CXC,REM]
   AUX=[Ctas. por cobrar (]+TIPORG+[ ]+TRIM(NUMORG)+[)]
  CASE ORIGEN=[CXP]
   AUX= [Ctas. por pagar (]+TIPORG+[ ]+TRIM(NUMORG)+[)]
  CASE ORIGEN=[FAC]
   AUX=[la Factura No.]+NUMORG
  CASE ORIGEN=[CAJ]
   AUX=[Caja]
  CASE ORIGEN=[CPA]
   AUX=[la Compra No.]+NUMORG
  OTHERWISE
   RETURN .T.
 ENDCASE
 alerta([Doc. debe ser alterado desde ]+AUX)
 RETURN .F.
ENDIF
RETURN .T.

