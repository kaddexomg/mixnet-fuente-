SELECT MXTRABAN
AUDITORIA([Acceso a mantenimiento de transacci¢n bancaria],xCODMOVBAN+[ ]+XNUMDOC+[ ]+XTIPBAN,CODMOVBAN+[ ]+NUMDOC+[ ]+TIPBAN,IF(MODIFICA,[MOD],[INC]))
IF MODIFICA
   dReg:=recno()
   SET ORDER TO 3
   IF dbseek(lcodmovban+'ND'+lnumdoc)
      DO WHILE CODMOVBAN+TIPBAN+NUMDOC=lcodmovban+'ND'+lnumdoc .AND. !EOF()
         IF tiporg$'TF.DB'
            REV_BAN()
            REC_LOCK(0)
            DELETE
            UNLOCK
          ENDIF
         DBSKIP()
       ENDDO
   ENDIF
   /*
   IF dbseek(lcodmovban+'ND'+lnumdoc) .AND. tiporg$'DB.TF'
      REV_BAN()
      REC_LOCK(0)
      DELETE
      UNLOCK
   ENDIF
   */
   DBGOTO(dReg)
   dReg:=0
   REC_LOCK(0)
   REV_BAN()
   UNLOCK
ELSE
 SELECT MXTRABAN
 DREG:=RECNO()
 SET ORDER TO 3
 UNLOCK
 WHILE !FLOCK()
 END
 IF DBSEEK(XCODMOVBAN+XTIPBAN+XNUMDOC)
  GOTO DREG
  DELETE
  UNLOCK
  PARE('TRANSACCION RECHAZADA POR DUPLICIDAD')
  SET ORDER TO 1
  GO TOP
  SALIR:=.T.
  RETURN
 ELSE
  UNLOCK
  SET ORDER TO 1
  GOTO DREG
  REC_LOCK(0)
 ENDIF
ENDIF
