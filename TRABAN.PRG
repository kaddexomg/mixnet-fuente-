leer()
if !salir .and. DbVacio(mxcctcon,'S')=1
   Pide_CCosto()
endif
SETCOLOR(UCOLOR)
RESTSCREEN(CONTLIN+1,0,CONTLIN+4,78,GSCR)
RETURN 0

