PROCEDURE ELITBA
* ELIMINACION DE REGISTRO
PRIVATE XCODBAN,XDEP,LAST,PROX,XFECHA_DEP,YCM
SELECT MXTRABAN
XDEP       = NUMDOC
XCODBAN    = CODMOVBAN
XFECHA_DEP = FECHA_MOV
YCM        = CODMOVBAN+TIPBAN+NUMDOC
VCAJ       = VIENE_CAJ
BCL        = CODMOVBAN+'ND'+NUMDOC
XTIP       = TIPBAN
XTORG      = TIPORG
BDESGBAN(YCM)
REV_BAN()
if xtip$'CH.AN'
   DESBLOQUEAR_CORR(xcodban+xdep)
endif
SELECT MXTRABAN
AUDITORIA([Mantenimiento ]+CONCEPTO,XCODBAN+[ ]+XDEP+[ ]+XTIP,,[ELI])
REC_LOCK(0)
DELETE
UNLOCK
IF !xtorg$'DB.TF'.AND.xTIP$[CH.TR.ND]
   SELECT MXTRABAN
   SET ORDER TO 3
   IF dbseek(BCL)
      DO WHILE codmovban+'ND'+numdoc=bcl
         IF tiporg$'DB.TF' .AND. rlock()
            lIdb=.T.
            REV_BAN()
            DELETE
            UNLOCK
         ENDIF
         dbskip()
      ENDDO
   ENDIF
ENDIF
IF VIENE_CAJ
 SELECT MXTRACAJ
 SET ORDER TO 2
 SEEK(DTOS(XFECHA_DEP)+XCODBAN+XDEP)
 IF !EOF()
  DO WHILE !FLOCK()
  ENDDO
  LAST=.F.
  DO WHILE !LAST
   SKIP
   IF EOF() .OR. CODBAN<>XCODBAN .OR. DEPOSITO<>XDEP .OR. FECHA_DEP<>XFECHA_DEP
    LAST=.T.
   ELSE
    PROX=RECNO()
   ENDIF
   SKIP -1
   AUDITORIA([Mantenimiento Desmarcaje por eliminacion de registro bancario]+concepto,XCODBAN+[ ]+XDEP+[ ]+XTIP+' DOC. CAJA:'+NUMORG,,[ELI])
   IF FORMAPAG='ND'.AND.TIPORG='DE'.AND.IMPORTE<0.AND.ORIGEN='BAN'
    DELETE
   ELSE
    REPLACE DEPOSITO WITH [], CODBAN WITH [] , FECHA_DEP WITH FECNUL
    Act_Caja(codcaj,importe,0)
   ENDIF
   IF !LAST
    GOTO PROX
   ENDIF
  ENDDO
  UNLOCK
  SET ORDER TO 1
 ENDIF
 SELECT MXTRABAN
 VIENE_CAJ=.F.
ENDIF
UCOD:='\'
SET ORDER TO 1
RETURN

