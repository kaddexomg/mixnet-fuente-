STATIC FUNCTION CHCODBAN(EL_COD,NO_INFO)
LOCAL USEL,DEVO,XREG,UCOLOR:=SETCOLOR()
IF LASTKEY()=5
 RETURN .T.
ENDIF
DEVO =.T.
USEL=SELECT()
SELECT MXCTABAN
SEEK(EL_COD)
IF !FOUND()
   BAN0000()
   DEVO=.F.
ELSE
  IF BAN_BCON='N'
     IF !Rlock()
        PARE('REGISTRO ESTA BLOQUEADO, POSIBLEMENTE POR PROCESO DE CONCILIACION...')
        SETCOLOR(UCOLOR)
        DbSelectar(USEL)
        RETURN .F.
     ELSE
        Dbunlock()
     ENDIF
  ENDIF
  IF EMPTY(NO_INFO)
     SETCOLOR(C_TIT)
     @ MAXROW()-5,10 SAY PAD(NOMCOD(el_cod,[MXCTABAN],"TRIM(NOMBRE)+' '+CUENTA"),42)
     XREG:=RECNO()
     SELECT MXDAABAN
     GOTO XREG
     @ MAXROW()-5,57 say TRANS(BS(MXCTABAN->SALDO_ACT),tran21)
  ENDIF
ENDIF
SELE (USEL)
SETCOLOR(UCOLOR)
RETURN DEVO

static proc depban(ZBANCO)
LOCAL YNUMDOC, YFECHA_MOV, PRIMERO:=.T., XREG
PRIVATE I_MANUAL:=.T.

SELECT MXTRABAN
XREG:=RECNO()

  BEGIN SEQUENCE
  WHILE .T.
   SELECT MXTRACAJ
   CTL_MAN()
   YFECHA_MOV:=MXTRACAJ->FECHA_CAJ
   IF PRIMERO
    YNUMDOC:=PROX_DOC(ZBANCO,'DP',SUBSTR(DTOS(YFECHA_MOV),5)+'0000')
   ELSE
    YNUMDOC:=PROX_DOC(ZBANCO,'DP',YNUMDOC)
   ENDIF
   REC_LOCK(0)
   REPLACE CODBAN WITH ZBANCO, DEPOSITO WITH YNUMDOC, FECHA_DEP WITH YFECHA_MOV
   UNLOCK
   select mxtraban
   ARCHIBAN(ZBANCO,YFECHA_MOV,'DP',YNUMDOC,'DEPOSITO ELECTRONICO ',MXTRACAJ->IMPORTE,'CAJ')
   IF PRIMERO
    XREG:=RECNO()
    PRIMERO:=.F.
   ENDIF
   YNUMDOC:=PROX_DOC(ZBANCO,'ND',YNUMDOC)
   ARCHIBAN(ZBANCO,YFECHA_MOV,'ND',YNUMDOC,'DESCUENTO SOBRE VENTAS ',-MXTRACAJ->IMPORTE*MXCTATAR->POR_DCTO/100,'BAN')
   YNUMDOC:=PROX_DOC(ZBANCO,'ND',YNUMDOC)
   ARCHIBAN(ZBANCO,YFECHA_MOV,'ND',YNUMDOC,'RETENCION ISLR ',-MXTRACAJ->IMPORTE*MXCTATAR->POR_DCTO1/100,'BAN')
  ENDDO
  END
  UCOD:='\'
  SELECT MXTRABAN
  GOTO XREG
  POSPAG(RECNO())
return

STATIC FUNC PROX_DOC(EL_COD,EL_TIP,EL_DOC)
LOCAL USEL:=SELECT()
SELECT MXTRABAN
SET ORDER TO 3
WHILE .T.
 EL_DOC:=PAD(PROX_SIMB(EL_DOC),8)
 SEEK(EL_COD+EL_TIP+EL_DOC)
 IF !FOUND()
  EXIT
 ENDIF
ENDDO
SET ORDER TO 1
SELECT(USEL)
RETURN EL_DOC

STATIC PROC ARCHIBAN(ZBANCO,ZFECHA,ZTIPO,ZNUMDOC,ZCONCEPTO,ZIMPORTE,ZORIGEN)
PRIVATE XCODMOVBAN:=ZBANCO,XFECHA_MOV:=ZFECHA,XTIPBAN:=ZTIPO,XNUMDOC:=ZNUMDOC,XCONCEPTO:=ZCONCEPTO,XIMPORTE:=ZIMPORTE
PRIVATE XORIGEN:='BAN',XTIPORG:='',XNUMORG:='',XMULTICAN:=.F.,DOC_ORIGEN:=ZORIGEN
   select mxtraban
   ADD_REC(0)
   ARC_BAN()
RETURN

