PROC DEPTAR
 PARAMETERS P1,P2,P3
 local GSCR,UCOLOR,xdesde:=xhasta:=ctod(g_fecha), XPUNTOVEN:='N', BSCR:=SAVESCREEN(MAXROW()-2,0,MAXROW(),79)
 PRIVATE xcodtar:=space(3),ZBANCO:=SPACE(5),ZCAJA:=SPACE(2),modifica:=.t.
 SET KEY -8 TO
 SET KEY -9 TO
 IF ABRIR([MXCTATAR],MXCTATAR,[S],MXCTTAX1)
    OFF_KEY()
    UCOLOR=SETCOLOR()
    GSCR=SAVESCREEN(7,30,16,77)
    LIMPIA()
    MENSAJ(MEN2)
    SETCOLOR(C_TEX1)
    BOXSOM([ DEPOSITO/TARJETA ],7,30,14,76)
    @ 08,32 SAY [Tarjeta:] GET Xcodtar PICT [@!] VALID val_tar(xcodtar,8,45)
    @ 09,32 SAY [  Desde:] GET Xdesde
    @ 10,32 SAY [  Hasta:] GET Xhasta VALID xdesde<=xhasta
    @ 11,32 SAY [  Banco:] GET ZBANCO VALID CHCODBAN(ZBANCO)
    @ 12,32 SAY [   Caja:] GET ZCAJA  VALID CHK_CLV(MXCTACAJ,MXCTCAX1,[EDCCAJ],ZCAJA)
    @ 13,32 say [¨Punto de ventas?(S/N)] GET XPUNTOVEN PICT '!' VALID XPUNTOVEN$'SN'
    LEER()
    IF EMPTY(ZCAJA)
       PARE('CODIGO DE LA CAJA NO PUEDE QUEDAR VACIO')
       SETCOLOR(UCOLOR)
       RESTSCREEN(7,30,16,77,GSCR)
       SELECT MXTRABAN
       ON_KEY()
       SET KEY -8 TO CAJ0000
       SET KEY -9 TO DEPTAR
       RESTSCREEN(MAXROW()-2,0,MAXROW(),79,BSCR)
       RETURN nil
    ENDIF
    SETCOLOR(UCOLOR)
    RESTSCREEN(7,30,16,77,GSCR)
    IF !escapar() .AND. !EMPTY(XCODTAR)
       PARE('LOS REGISTROS DE LA CAJA '+ZCAJA+' SERAN FILTRADOS, ESTO PUEDE TARDAR')
       SELECT MXTRACAJ
       SET FILTER TO CODCAJ = ZCAJA
       DATETAR(XCODTAR,xdesde,xhasta,XPUNTOVEN,ZBANCO)
       SELECT MXTRACAJ
       SET FILTER TO
    ENDIF
    CERRAR('MXCTATAR')
 ENDIF
 SELECT MXTRABAN
 ON_KEY()
 SET KEY -8 TO CAJ0000
 SET KEY -9 TO DEPTAR
 RESTSCREEN(MAXROW()-2,0,MAXROW(),79,BSCR)
RETURN

STATIC FUNCTION VAL_TAR(LA_TAR, fil,col)
 LOCAL USEL:=SELECT(),DEVO:=.F.
 IF LASTKEY()=5
    RETURN .T.
 ENDIF
 SEEK(LA_TAR)
 IF !FOUND()
  edit_ventana([EDCTAR])
 ELSE
  IF VALTYPE(FIL)='N'
   @ fil,col SAY SUBSTR(NOMCOD(LA_TAR,[MXCTATAR],[NOMTAR]),1,30)
  ENDIF
  DEVO=.T.
 ENDIF
 SELE (USEL)
 OFF_KEY()
RETURN DEVO

STATIC PROC DATETAR(XCODTAR,xdesde,XHASTA,MPV,ZBANCO)
LOCAL XTOT:=0,XR1,XR2, qfile:=g_camino+'qw'+estacion+'.dbf', QREG,inc,umod,ucol
PRIVATE II_LISTASI:='',LE_TARJE:=TRIM(MXCTATAR->NOMTAR), CON_DEBI:=IF(MPV='N',2,0)
PRIVATE DOC_ORIGEN:=[CAJ],SALIR:=.F.

MENSAJ(MEN4)
dbcreate(qfile,{{'FECHA_CAJ','D',8,0},{'NUMORG','C',8,0},{'NUMPAG','C',16,0},{'IMPORTE','N',12,2},{'REG','C',5,0},{'CODCAJ','C',2,0}})

IF ABRIR('QFILE',QFILE,'E')
 SELECT MXTRACAJ
 set soft on
 SEEK(dtos(xdesde))
 set soft off
 WHILE !EOF() .and. fecha_caj<=xhasta
  IF SUBSTR(NOMPAG,1,3)=XCODTAR.and.FORMAPAG='TA'.and. EMPTY(DEPOSITO).AND. IMPORTE>0
   XTOT:=XTOT+IMPORTE
   QREG:=STRZERO(RECNO(),5)
   II_LISTASI:=II_LISTASI+QREG+[\]
   SELECT QFILE
   APPEND BLANK
   REPLACE FECHA_CAJ WITH MXTRACAJ->FECHA_CAJ ,;
           NUMPAG    WITH MXTRACAJ->NUMPAG ,;
           NUMORG    WITH MXTRACAJ->NUMORG ,;
           IMPORTE   WITH MXTRACAJ->IMPORTE,;
           REG       WITH QREG,;
           CODCAJ    WITH MXTRACAJ->CODCAJ
  ENDIF

  SELECT MXTRACAJ
  SKIP
 ENDDO

 IF DIFCERO(XTOT)

  select QFILE
  GO TOP
  uinc:=ctl_men[1]
  umod:=ctl_men[2]
  ucol:=ctl_men[4]
  store .f. to ctl_men[1],ctl_men[2],ctl_men[4]
  EDIT_VENTANA('DEPTAR')
  ctl_men[1]:=  uinc
  ctl_men[2]:=  umod
  ctl_men[4]:=  ucol
  MENSAJ(MEN4)

  GO TOP
  XTOT:=0
  II_LISTASI:=''
  DBEVAL({||XTOT:=XTOT+IMPORTE, II_LISTASI:=II_LISTASI+QFILE->REG+'\'})
 ENDIF
 CERRAR('QFILE')
 DELETE FILE (QFILE)
ENDIF
SELECT MXTRACAJ
IF DIFCERO(XTOT)
 if MPV$'N'
  RPLCAJA(XCODTAR,-XTOT*MXCTATAR->POR_DCTO/100, 'DESCUENTO/VENTAS')
  XR1:=RECNO()
  RPLCAJA(XCODTAR,-XTOT*MXCTATAR->POR_DCTO1/100,'RETENCION ISLR')
  XR2:=RECNO()
  SALIR:=.F.
  DEPOSITA(ZBANCO)
  IF ESCAPAR()
   SELECT MXTRACAJ
   GOTO XR1
   REC_LOCK(0)
   DELETE
   UNLOCK
   GOTO XR2
   REC_LOCK(0)
   DELETE
   UNLOCK
  ENDIF
 else
  DEPBAN(ZBANCO)
 endif
ELSE
 PARE('NO HAY DOCUMENTOS')
ENDIF

RETURN

STATIC PROCEDURE RPLCAJA(XCODTAR,XIMPORTE,XNUMPAG)
* REEMPLAZO EN EL REGISTRO
SELECT MXTRACAJ
IF ADD_REC()
 REPLACE CODCAJ    WITH ZCAJA,;
         FECHA_CAJ WITH CTOD(G_FECHA),;
         ORIGEN    WITH 'BAN',;
         TIPORG    WITH 'DE',;
         NUMORG    WITH 'ND'+STRZERO(MONTH(FECHA_CAJ),2)+STRZERO(DAY(FECHA_CAJ),2),;
         FORMAPAG  WITH 'ND',;
         NUMPAG    WITH XNUMPAG,;
         NOMPAG    WITH XCODTAR,;
         IMPORTE   WITH XIMPORTE
 II_LISTASI:=II_LISTASI+STRZERO(RECNO(),5)+[\]
 *ACT_CAJA(ZCAJA,-XIMPORTE,0)
ENDIF
RETURN

