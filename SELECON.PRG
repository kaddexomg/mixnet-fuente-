PROCEDURE SELMAN
* SELECCION
IF STR(DEBITOS,16,2)<>STR(CREDITOS,16,2) .AND. TIP_SEL=3
 PARE([Asiento descuadrado])
 EN_SEL=.T.
ELSE
 IF TIP_SEL=3 .OR. TIP_SEL=2
  DO MULTISEL
 ELSE
  IF TIP_SEL=1
   DO DOSSEL
  ELSE
   IF TIP_SEL=0
    FECHA1=FECHA_ASI
    ASI1=ASIENTO
   ENDIF
  ENDIF
 ENDIF
ENDIF
RETURN


