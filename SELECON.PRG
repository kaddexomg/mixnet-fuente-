PROCEDURE BCONFUN
* BUSQUEDA
@ CONTLIN, 2+MARGEN GET BCODIGO
@ CONTLIN,23+MARGEN GET BNOMBRE
CUR_ON()
READ
CUR_OFF()
SALIR=ESCAPAR() .OR. ( EMPTY(BCODIGO) .AND. EMPTY(BNOMBRE) )
IF !SALIR
 IF !EMPTY(BCODIGO)
  TCODIGO=UPPER(TRIM(BCODIGO))
  YKEY=TCODIGO
 ELSE
  TNOMBRE=UPPER(TRIM(BNOMBRE))
  BCONDICION=[TNOMBRE$UPPER(NOMBRE)]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN



