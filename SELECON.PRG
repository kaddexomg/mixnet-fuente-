PROCEDURE BUSMAN
PRIVATE TFECHA_ASI,TASIENTO,TDESC_ASI
VERTBUS([UBUSMAN])
RETURN

PROCEDURE UBUSMAN
*@ CONTLIN-1,COLIZQ-1 TO CONTLIN+1,COLDER+1
@ CONTLIN, 2+MARGEN GET BFECHA_ASI
@ CONTLIN,13+MARGEN GET BASIENTO
@ CONTLIN,22+MARGEN GET BDESC_ASI
CUR_ON()
READ
CUR_OFF()

SALIR=ESCAPAR()
IF !SALIR
 TASIENTO=UPPER(TRIM(BASIENTO))
 IF EMPTY(BFECHA_ASI)
  TDESC_ASI=UPPER(TRIM(BDESC_ASI))
  BCONDICION=IF(EMPTY(BASIENTO),[.T.],[ASIENTO=TASIENTO])+IF(EMPTY(BDESC_ASI),[],[.AND.TDESC_ASI$DESC_ASI])
  POR_INDICE=.F.
 ELSE
  YKEY=UPPER(TRIM(DTOS(BFECHA_ASI)+TASIENTO))
 ENDIF
ENDIF
RETURN

