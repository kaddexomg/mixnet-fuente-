***************************************************************
* FUNCIONES PARA EVALUAR FORMULAS
FUNCTION CALCULA
PARAMETER EL_CONCEP
PRIVATE XEXPRESION,RES,ULT_REG
PRIVATE V1,V2,V3,V4,V5,V6,V7
RES=0.00
SELECT FORMULA
ULT_REG=RECNO()
SEEK(EL_CONCEP)
IF !EOF()
 XEXPRESION=ALLTRIM(EXPRESION)
 * EVALUACION DE LA FORMULA
 IF !EMPTY(XEXPRESION)
  V1=CALSAL(VAR1)
  V2=CALSAL(VAR2)
  V3=CALSAL(VAR3)
  V4=CALSAL(VAR4)
  V5=CALSAL(VAR5)
  V6=CALSAL(VAR6)
  V7=CALSAL(VAR7)
  PARFOR(XEXPRESION)
  RES= &XEXPRESION
  RES= ROUND(RES,2)
 ENDIF
ENDIF
SELECT FORMULA
GOTO ULT_REG
RETURN(RES)

FUNCTION CALSAL
PARAMETER EL_COD
PRIVATE XSALDO,XREG

XSALDO=0
IF !EMPTY(EL_COD)
 SELECT MXCTACON
 SEEK(EL_COD)
 IF FOUND()
  XREG=RECNO()
  SELECT MXDAACON
  GOTO XREG
  XSALDO=SALDO_ACT(YPER)
 ENDIF
 SELECT FORMULA
ENDIF
RETURN XSALDO


FUNCTION PARFOR
PARAMETER MI_LINEA
PRIVATE LA_LINEA,POS,LA_VAR,TEMP,EL_VAL

IF 'F'$MI_LINEA

 LA_LINEA=TRIM(MI_LINEA)
 DO WHILE LEN(LA_LINEA)>=4
  POS=AT('F',UPPER(LA_LINEA))
  IF POS<>0
   LA_VAR=UPPER(SUBSTR(LA_LINEA,POS,4))
   EL_VAL=SUBSTR(LA_VAR,2,3)
   IF !(LA_VAR$LISTA_FOR)
    *******************************
    LISTA_FOR=LISTA_FOR+' '+LA_VAR
    ******************************
    TEMP=CALCULA(EL_VAL)
    PUBLIC &LA_VAR
    &LA_VAR=TEMP
   ENDIF
  ENDIF
  LA_LINEA=TRIM(SUBSTR(LA_LINEA,POS+3,LEN(TRIM(LA_LINEA))))
 ENDDO
ENDIF
RETURN 0

