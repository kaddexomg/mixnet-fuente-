PROCEDURE DCON0404
PRIVATE TOT_DEB,TOT_CRE,XAPU
SELECT MXCTACON
IF !II_MAYOR .AND. !MARCA
 SKIP
 RETURN
ELSE
 CTL_MAN()
ENDIF

XAPU=RECNO()

IF IMPRE
 SI_TOTALF=!II_MAYOR
 XCODIGO=CODIGO
 XNOMBRE=NOMBRE
 SELECT MXDAACON
 GOTO XAPU
 STORE 0.00 TO TOT_DEB,TOT_CRE
 J=0
 FOR I=NPER1 TO NPER2
  IF I>NPER1
   XCODIGO=SPACE(20)
   XNOMBRE=SPACE(25)
  ENDIF
  II=STRZERO(I,2)
  ESCRIBE(XCODIGO+[ ]+SUBSTR(XNOMBRE,1,25)+[ ]+SUBSTR(MESPER(I),1,3)+[ ]+TRANS(BS(DEB&II),TRAN21)+[ ]+TRANSFORM(BS(CRE&II),TRAN21)+[ ]+TRANSFORM(BS(DEB&II)-BS(CRE&II),TRAN21))
  TOT_DEB=TOT_DEB+BS(DEB&II)
  TOT_CRE=TOT_CRE+BS(CRE&II)
  J=J+1
 NEXT
 TOTF_DEB=TOTF_DEB+TOT_DEB
 TOTF_CRE=TOTF_CRE+TOT_CRE
 IF J>1
  ESCRIBE([TOTAL]+SPACE(46)+TRANS(TOT_DEB,TRAN21)+[ ]+TRANS(TOT_CRE,TRAN21)+[ ]+TRANSFORM(TOT_DEB-TOT_CRE,TRAN21))
  ESCRIBE([])
 ENDIF
ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(REPLICATE('=',79))
 ESCRIBE([CODIGO: ]+CODIGO)
 ESCRIBE([NOMBRE: ]+NOMBRE)
 ESCRIBE(REPLICATE('=',79))
 ESCRIBE([MES                            DEBE                 HABER                 SALDO])
 ESCRIBE(REPLICATE('=',79))
 SETCOLOR(C_TEX2)
 SELECT MXDAACON
 GOTO XAPU
 STORE 0.00 TO TOT_DEB,TOT_CRE
 FOR I=NPER1 TO NPER2
  II=STRZERO(I,2)
  ESCRIBE(PAD(MESPER(I),10)+[ ]+CHR(16)+[  ]+TRANSFORM(BS(DEB&II),TRAN21)+[ ]+TRANSFORM(BS(CRE&II),TRAN21)+[ ]+TRANSFORM(BS(DEB&II)-BS(CRE&II),TRAN21))
  TOT_DEB=TOT_DEB+BS(DEB&II)
  TOT_CRE=TOT_CRE+BS(CRE&II)
 NEXT
 ESCRIBE(REPLICATE('-',79))
 ESCRIBE([TOTAL      ]+CHR(16)+[  ]+TRANSFORM(TOT_DEB,TRAN21)+[ ]+TRANSFORM(TOT_CRE,TRAN21)+[ ]+TRANSFORM(TOT_DEB-TOT_CRE,TRAN21),C_TIT2)
 ESCRIBE(REPLICATE('=',79))
 CONTLIN=MAXLIN+1
ENDIF
SELECT MXCTACON
IF !I_MANUAL
 SKIP
ENDIF
RETURN

