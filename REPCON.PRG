PROCEDURE DETBALPLA
* DETALLE BALANCE SEGUN PLAN DE CUENTAS
PRIVATE I,HIJO,INGRESOS,EGRESOS,CAPITAL
HIJO = (COD3=TRIM(COD2))
RES  = .F.
IF ES_BALA
 I=1
 J=2
ELSE
 I=4
 J=5
ENDIF
SELEC MXCTACON
SET FILTER TO NIVCOD<4
* INGRESOS
SEEK(COD4)
IF FOUND()
 INGRESOS=BUSSALDO()
ELSE
 INGRESOS=0
ENDIF
* EGRESOS
SEEK(COD5)
IF FOUND()
 EGRESOS=BUSSALDO()
ELSE
 EGRESOS=0
ENDIF
IF ES_BALA
 *PATRIMONIO
 NOMCAP=SPACE(25)
 SEEK(COD3)
 IF FOUND()
  NOMCAP=NOMBRE
  CAPITAL=BUSSALDO()
 ELSE
  CAPITAL=0
  NOMCAP=[]
 ENDIF
ENDIF
DO WHILE I<=J
 STORE 0 TO N1,N2,N3,NIVEL
 II=STR(I,1)
 COD=COD&II
 SEEK(COD)
 IF FOUND()
  N1=NIVCOD
  XNOMBRE1=NOMBRE
  TOT1=BUSSALDO()
  ESCRIBE([])
  IF !HIJO .AND. I=2
   NOMCAP= SUBSTR(TRIM(XNOMBRE1)+' Y '+NOMCAP,1,25)
   IF IMPRE
    ESCRIBE(SPACE(10)+NOMCAP)
   ELSE
    ESCRIBE(SPACE(1)+NOMCAP)
   ENDIF
  ELSE
   IF IMPRE
    ESCRIBE(SPACE(10)+XNOMBRE1)
   ELSE
    ESCRIBE(SPACE(1)+XNOMBRE1)
   ENDIF
  ENDIF
  ESCRIBE([])
  SKIP
  N2=NIVCOD
  IF N2>=N1+1
   NIVEL=N2
   DO WHILE N2=NIVEL .AND. !EOF()
    SETCOLOR(C_TEX2)
    XNOMBRE2=NOMBRE
    TOT2=BUSSALDO()
    IF IMPRE
     ESCRIBE(SPACE(1)+XNOMBRE2)
    ELSE
     ESCRIBE(XNOMBRE2)
    ENDIF
    SKIP
    N3=NIVCOD
    IF N3>=N2+1
     NIVEL=N3
     DO WHILE NIVEL>=N3 .AND. !EOF()
      IF NIVEL=N3
       XNOMBRE3=NOMBRE
       SALDO=BUSSALDO()
       IF SALDO<>0.00
        IF IMPRE
         ESCRIBE(SPACE(2)+XNOMBRE3+SPACE(8)+TRANS(SALDO,TRAN21))
        ELSE
         ESCRIBE(' '+XNOMBRE3+' '+TRANS(SALDO,TRAN21))
        ENDIF
       ENDIF
      ENDIF
      SKIP
      IF CODIGO=TRIM(COD3) .AND. !RES
       LOCATE REST FOR CODIGO<>TRIM(COD3)
      ENDIF
      NIVEL=NIVCOD
     ENDDO
     SETCOLOR(C_TIT2)
    ELSE
     NIVEL=N3
    ENDIF
    SETCOLOR(C_TEX2)
    IF RES
     RESULTADO=INGRESOS+EGRESOS
     TOT2=TOT2+RESULTADO
     TOT1=TOT1+RESULTADO
     IF !HIJO
      TOT1=TOT1+CAPITAL
     ENDIF
     IF IMPRE
      ESCRIBE(SPACE(2)+'RESULTADO DEL PERIODO     '+SPACE(12)+ TRANS(RESULTADO,TRAN21))
     ELSE
      ESCRIBE(' RESULTADO DEL PERIODO               '+ TRANS(RESULTADO,TRAN21))
     ENDIF
     NIVEL=-1
    ENDIF
    IF IMPRE
     ESCRIBE(SPACE(40)+REPL('-',21))
     ESCRIBE(' TOTAL '+XNOMBRE2+SPACE(25)+TRANS(TOT2,TRAN21))
    ELSE
     ESCRIBE(SPACE(32)+REPL('-',26))
     SETCOLOR(C_TIT2)
     ESCRIBE('TOTAL '+XNOMBRE2+SPACE(1)+TRANS(TOT2,TRAN21))
    ENDIF
    ESCRIBE([])
    IF ES_BALA .AND. I=2 .AND. NIVEL<>N2
     I=3
     SEEK(COD3)
     IF FOUND()
      RES=.T.
      N2=NIVCOD
      NIVEL=N2
      LOOP
     ENDIF
    ENDIF
   ENDDO
  ENDIF
  IF !HIJO .AND. I=3
   IF IMPRE
    ESCRIBE(SPACE(5)+'  TOTAL '+NOMCAP+SPACE(46)+TRANS(TOT1,TRAN21))
   ELSE
    ESCRIBE(' TOTAL '+NOMCAP+SPACE(10)+TRANS(TOT1,TRAN21))
   ENDIF
  ELSE
   IF IMPRE
    ESCRIBE(SPACE(5)+'  TOTAL '+XNOMBRE1+SPACE(41)+TRANS(TOT1,TRAN21))
   ELSE
    ESCRIBE(' TOTAL '+XNOMBRE1+SPACE(5)+TRANS(TOT1,TRAN21))
   ENDIF
  ENDIF
  IF IMPRE
   ESCRIBE(SPACE(84)+REPL('=',21))
  ELSE
   ESCRIBE(SPACE(42)+repl('=',21))
  ENDIF
  IF  I=1 .OR. I=3
   * CTAS. ORDEN ACTIVO
   IF I=1
    SEEK(COD6)
   ELSE
    SEEK(COD7)
   ENDIF
   IF !EOF()
    ESCRIBE([])
    MI_NOMBRE=NOMBRE
    MI_SALDO=BUSSALDO()
    IF IMPRE
     ESCRIBE(SPACE(5)+'  TOTAL '+MI_NOMBRE+SPACE(63)+TRANS(MI_SALDO,TRAN21))
    ELSE
     ESCRIBE(' TOTAL '+MI_NOMBRE+SPACE(5)+TRANS(MI_SALDO,TRAN21))
    ENDIF
   ENDIF
  ENDIF
  IF I=5
   ESCRIBE([])
   RESULTADO=INGRESOS+EGRESOS
   IF !EMPTY(COD4) .AND. !EMPTY(COD5)
    IF IMPRE
     ESCRIBE(SPACE(2)+'RESULTADO DEL PERIODO'+SPACE(61)+TRANS(RESULTADO,TRAN21))
    ELSE
     ESCRIBE('RESULTADO DEL PERIODO'+SPACE(21)+TRANS(RESULTADO,TRAN21))
    ENDIF
   ENDIF
  ENDIF
  CONTLIN=MAXLIN+1
 ENDIF
 I=I+1
ENDDO
I_CONDICION=[.F.]
RETURN

