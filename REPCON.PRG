         IIF(II_IMP1=0,[],[IMPORTE>=]+LTRIM(STR(II_IMP1,12,G_REDONDO)))+[ ]+;
         IIF(II_IMP2=0,[],[IMPORTE<=]+LTRIM(STR(II_IMP2,12,G_REDONDO)))

