PROCEDURE DETBALDEF
DECLARE RAMA[10],TOT[10],BNOMBRE[10],XIMPRES[10]
PRIVATE XRAMA,XIMPRESION,FUERA,FACTOR,MAX_NIV
PRIVATE ULT_COM,SALDO, XNOMBRE,XCODIGO,XSIGNO, M_REG
FACTOR=1
FUERA=.F.
MAX_NIV=II_MAXNIV
ULT_COM=[**]
SELE RDBCON
SEEK(II_FICBAL)
*SALDO=0
DO WHILE !EOF() .AND. RDBCON->CODREP=II_FICBAL
 ULT_NIVEL=NIVEL
 SALDO=0
 XNOMBRE=NOMBRE
 XCODIGO=CODBAL
 XSIGNO=IF(SIGNO=[-],-1,1)
 XRAMA=IMPRESION<>[N]
 XIMPRESION=IMPRESION
 M_REG=RECNO()
 IF !EMPTY(XCODIGO)
  IF XCODIGO=[/] .OR. XCODIGO=[\]
   SALDO=CALCNUC(SUBSTR(XCODIGO,2,3))*XSIGNO
  ELSE
   IF CAMCTL(RDBCON->ID_COM)
    SELE MXCTACON
    SEEK(XCODIGO)
    IF !EOF()
     SALDO=BUSSALDO()*XSIGNO
    ENDIF
   ENDIF
  ENDIF
 ENDIF
 SELE RDBCON
 SKIP
 SALTAR = (NIVEL=1 .AND. !EOF())
 IF EOF() .OR. CODREP<>II_FICBAL
  FUERA=.T.
  XNIVEL=1
 ELSE
  XNIVEL=NIVEL
 ENDIF
 IF XNIVEL<=ULT_NIVEL
  IF ULT_NIVEL=1
   XRSW=.T.
  ELSE
   XRSW=RAMA[ULT_NIVEL-1]
  ENDIF
  IF ULT_NIVEL<=MAX_NIV .AND. XRSW
   IF DIFCERO(SALDO)
    ESCRIBE(XNOMBRE+SPACE(7)+TRANS(SALDO,TRAN21))
   ENDIF
  ENDIF
  I=ULT_NIVEL-1
  DO WHILE I>=1
   TOT[I]=TOT[I]+SALDO
   I=I-1
  ENDDO
  IF XNIVEL=ULT_NIVEL
   LOOP
  ELSE
   I=ULT_NIVEL-1
   DO WHILE I>=XNIVEL
    IF I<=MAX_NIV
     IF !RAMA[I]
       ESCRIBE(BNOMBRE[I]+SPACE(7)+TRANS(TOT[I],TRAN21))
     ELSE
      STRTOTAL=IF(XIMPRES[I],[TOTAL ]+BNOMBRE[I],BNOMBRE[I]+SPACE(6))
     IF IMPRE
       ESCRIBE(STRTOTAL+SPACE(36/MAX_NIV*(MAX_NIV-I))+TRANS(TOT[I],TRAN21))
       ESCRIBE(SPACE(44+(36/MAX_NIV*(MAX_NIV-I)))+'---------------------')
     ELSE
      SETCOLOR(C_TIT2)
      ESCRIBE(STRTOTAL+SPACE(16/MAX_NIV*(MAX_NIV-I))+TRANS(TOT[I],TRAN21))
      ESCRIBE(SPACE(44+(16/MAX_NIV*(MAX_NIV-I)))+'---------------------')
      SETCOLOR(C_TEX2)
     ENDIF
     IF IMPRE .AND. XIMPRES[I]
        ESCRIBE([])
     ENDIF
     ENDIF
    ENDIF
    TOT[I]=0
    I=I-1
   ENDDO
   IF !FUERA .AND. SALTAR .AND. CONTLIN<>1
    CONTLIN=MAXLIN+1
    ESCRIBE([])
   ENDIF
  ENDIF
 ELSE
  IF ULT_NIVEL=MAX_NIV
   XRAMA=.F.
  ENDIF
   IF ULT_NIVEL<=MAX_NIV .AND. XRAMA .AND. XIMPRESION<>[T]
    SETCOLOR(C_TIT2)
    ESCRIBE([])
    ESCRIBE(XNOMBRE)
    SETCOLOR(C_TEX2)
   ENDIF
  TOT[ULT_NIVEL]     = 0
  BNOMBRE[ULT_NIVEL] = XNOMBRE
  XIMPRES[ULT_NIVEL] = XIMPRESION<>[T]
  IF ULT_NIVEL>1
   RAMA[ULT_NIVEL]=XRAMA .AND. RAMA[ULT_NIVEL-1]
  ELSE
   RAMA[ULT_NIVEL]=XRAMA
  ENDIF
 ENDIF
 SELE RDBCON
 IF FUERA
  EXIT
 ENDIF
ENDDO
I_CONDICION=[.F.]
CERRAR([MXRENCON])
CERRAR([MXDAACON])
CERRAR([MXCTACON])
SELECT RDBCON
RETURN
**************

FUNCTION CAMCTL(MID_COM)
LOCAL CTADBF,CTANTX,TRADBF,TRANTX,CA
IF ULT_COM<>MID_COM
 SELE CONTROL
 LOCATE FOR ID_EMP=MID_COM
 IF !EOF()
  CA=TRIM(CAMINO)+[\]+IF(EMPTY(G_TIT_EJ),[],[EJ]+SUBSTR(G_TIT_EJ,11,3)+[\])
  CTADBF=CA+[MXCTACON.DBF]
  CTANTX=CA+[MXCTCOX1.NTX]
  DAADBF=CA+[MXDAACON.DBF]
  TRADBF=CA+[MXRENCON.DBF]
  TRANTX=CA+[MXRECOX2.NTX]
  IF ULT_COM<>[**]
   CERRAR([MXDAACON])
   CERRAR([MXRENCON])
   CERRAR([MXCTACON])
  ENDIF
  ULT_COM=MID_COM
  IF ABRIR([MXCTACON],CTADBF,[S],CTANTX)
   IF ABRIR([MXDAACON],DAADBF,[S])
    IF ABRIR([MXRENCON],TRADBF,[S],TRANTX)
     RETURN .T.
    ENDIF
   ENDIF
  ENDIF
  RETURN .F.
 ELSE
  RETURN .F.
 ENDIF
ENDIF
RETURN .T.

FUNCTION CALCNUC
PARAMETER EL_NUCLEO
* CALCULA EL RESULTADO DE UNA CUENTA FINANCIERA
DECLARE TOTN[10]
PRIVATE SALDO,XNIVEL,XCODIGO,M_REG,XSIGNO,FUERA,ULT_NIVEL,UU_COM,ULT_REG
TOTN[1]=0
SELE RDBCON
ULT_REG=RECNO()
UU_COM=ULT_COM
SEEK(EL_NUCLEO)
DO WHILE !EOF() .AND. CODREP=EL_NUCLEO
 ULT_NIVEL=NIVEL
 SALDO=0
 XCODIGO=CODBAL
 XSIGNO=IF(SIGNO=[-],-1,1)
 M_REG=RECNO()
 IF !EMPTY(XCODIGO)
  IF SUBSTR(XCODIGO,1,1)$[/\]
   SALDO=CALCNUC(SUBSTR(XCODIGO,2,3))*XSIGNO
  ELSE
   IF CAMCTL(RDBCON->ID_COM)
    SELE MXCTACON
    SEEK(XCODIGO)
    IF !EOF()
     SALDO=BUSSALDO()*XSIGNO
    ENDIF
   ENDIF
  ENDIF
 ENDIF
 SELE RDBCON
 SKIP
 FUERA=  (NIVEL=1 .OR. CODREP<>EL_NUCLEO)
 IF EOF() .OR. FUERA
  XNIVEL=1
 ELSE
  XNIVEL=NIVEL
 ENDIF
 IF XNIVEL<=ULT_NIVEL
  I=ULT_NIVEL-1
  DO WHILE I>=1
   TOTN[I]=TOTN[I]+SALDO
   I=I-1
  ENDDO
  IF XNIVEL=ULT_NIVEL
   LOOP
  ELSE
   I=ULT_NIVEL-1
   DO WHILE I>=XNIVEL
    IF I>1
     TOTN[I]=0
    ENDIF
    I=I-1
   ENDDO
  ENDIF
 ELSE
  TOTN[ULT_NIVEL]     = 0
 ENDIF
 IF FUERA
  EXIT
 ENDIF
ENDDO
SELECT RDBCON
GOTO ULT_REG
ULT_COM=UU_COM
RETURN TOTN[1]

