PROCEDURE DCON0409
SELECT MXCTACON

IF !II_MAYOR .AND. !MARCA
 SKIP
 RETURN
ELSE
 CTL_MAN()
ENDIF
IF NPER1=0
 NPER1=1
ENDIF

IF IMPRE
 XCODIGO=CODIGO
 XNOMBRE=NOMBRE
 M_REG=RECNO()
 STORE 0.00 TO TOT_PRE,TOT_SAL
 J=0
 FOR I=NPER1 TO NPER2
  II=STRZERO(I,2)
  SELE MXDAACON
  GOTO M_REG
  XSAL=ABS(BS(DEB&II)-BS(CRE&II))
  SELE MXPSPCON
  GOTO M_REG
  XPRE=PRE&II
  XDIF=XPRE-XSAL
  IF I>NPER1
   XCODIGO=SPACE(20)
   XNOMBRE=SPACE(25)
  ENDIF
  ESCRIBE(XCODIGO+[ ]+SUBSTR(XNOMBRE,1,25)+[ ]+PAD(MESPER(I),10)+[ ]+TRANS(XPRE,TRAN22)+[ ]+TRANSFORM(XSAL,TRAN22)+[ ]+TRANSFORM(XDIF,TRAN22))
  TOT_PRE = TOT_PRE + XPRE
  TOT_SAL = TOT_SAL + XSAL
  J=J+1
 NEXT
 IF J>1
  ESCRIBE([TOTAL]+SPACE(53)+TRANS(TOT_PRE,TRAN22)+[ ]+TRANS(TOT_SAL,TRAN22)+[ ]+TRANSFORM(TOT_PRE-TOT_SAL,TRAN22))
  ESCRIBE([])
 ENDIF
ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(REPLICATE('=',79))
 ESCRIBE([CODIGO: ]+CODIGO+[       NOMBRE: ]+NOMBRE)
 M_REG=RECNO()
 ESCRIBE(REPLICATE('=',79))
 ESCRIBE([MES                   PRESUPUESTO                  SALDO             DIFERENCIA])
 ESCRIBE(REPLICATE('=',79))
 SETCOLOR(C_TEX2)
 STORE 0.00 TO TOT_SAL,TOT_PRE
 FOR I=NPER1 TO NPER2
  II=STRZERO(I,2)
  SELE MXDAACON
  GOTO M_REG

  * 28/8/96
  *  XSAL=ABS(DEB&II-CRE&II)
  XSAL=BS(DEB&II)-BS(CRE&II)

  SELE MXPSPCON
  GOTO M_REG
  XPRE=BS(PRE&II)
  XDIF=XPRE-XSAL
  ESCRIBE(PAD(MESPER(I),10)+[ ]+TRANS(XPRE,TRAN22)+[ ]+TRANS(ABS(XSAL),TRAN22)+[ ]+TRANS(XPRE-ABS(XSAL),TRAN22))
  TOT_SAL=TOT_SAL+XSAL
  TOT_PRE=TOT_PRE+XPRE
 NEXT
 ESCRIBE(REPLI('=',79),C_TIT2)
 ESCRIBE([TOTAL      ]+TRANSFORM(TOT_PRE,TRAN22)+[ ]+TRANS(ABS(TOT_SAL),TRAN22)+[ ]+TRANSFORM(TOT_PRE-ABS(TOT_SAL),TRAN22),C_TIT2)
 ESCRIBE(REPLI('=',79),C_TIT2)
 CONTLIN=MAXLIN+1
ENDIF
SELECT MXCTACON
IF !I_MANUAL
 SKIP
ENDIF
RETURN

