PROCEDURE HCON0405
*ENCABEZADO MAYOR GENERAL
IF UNA_VEZ
 CTL_MAN()
 PROXSIN()
 UNA_VEZ=.F.
ENDIF
IF IMPRE
 DO PONFEC
 IF II_SALTO
  TITULA(1)
  XCODANT=NIV_ANT(MXCTACON->CODIGO)
  XNOMANT=BUSANTER(XCODANT)
  IF !EMPTY(XCODANT)
   ? 'CODIGO: '+XCODANT+' NOMBRE: '+XNOMANT
  ENDIF
  ? 'CODIGO: '+MXCTACON->CODIGO+' NOMBRE: '+MXCTACON->NOMBRE
  ? 'FECHAS: '+LTRIM(SUBTIT2)
  CONTLIN=CONTLIN+3
 ELSE
  TITULA()
 ENDIF
 if !empty(ii_ccto)
    ? 'Centro de costo: '+if(MXCCTCON->(DbSeek(ii_ccto)),MXCCTCON->nomdpto,[No registrado])
 endif
 ? REPLICATE([=],I_ANCHO)
 ? 'FECHA      ASIENTO  REFERENCIA CONCEPTO DEL MOVIMIENTO                              DEBE                 HABER                 SALDO'
   *--------   -------  ---------- -----------------------------------     -----------------     -----------------     -----------------
 ? REPLICATE([=],I_ANCHO)
 CONTLIN=CONTLIN+3
 IF CONTINUA .AND. !II_SALTO
  ESCRIBE([CODIGO:]+MXCTACON->CODIGO+[ NOMBRE:]+MXCTACON->NOMBRE+[ (... CONTINUACION)])
 ENDIF
ELSE
 * POR PANTALLA
 XCODANT=NIV_ANT(MXCTACON->CODIGO)
 XNOMANT=BUSANTER(XCODANT)
 TITULA()
 SETCOLOR(C_TIT2)
 IF !EMPTY(XCODANT)
  ? 'CODIGO: '+XCODANT+' NOMBRE: '+XNOMANT
 ENDIF
 ? 'CODIGO: '+MXCTACON->CODIGO+' NOMBRE: '+MXCTACON->NOMBRE
 if !empty(ii_ccto)
    ? 'Centro de costo: '+if(MXCCTCON->(DbSeek(ii_ccto)),MXCCTCON->nomdpto,[No registrado])
 endif
 ? REPLICATE('=',79)
 ? [FECHA      ASIENTO  REFER.  CONCEPTO                  IMPORTE             SALDO]
 *  --------   -------- ------- --------------- ----------------- -----------------
 ? REPLICATE('=',79)
 CONTLIN=CONTLIN+4
ENDIF
RETURN

FUNCTION PROXSIN
PRIVATE MI_SEL
MI_SEL=SELECT()
IF !II_ZERO
DO WHILE .T.
 SELEC TRACON
 SET SOFT ON
 SEEK(MXCTACON->CODIGO+TRIM(SUBSTR(DTOS(II_FEC1-1),1,6)))
 SET SOFT OFF
 DO WHILE !EOF() .AND. CODMOV=MXCTACON->CODIGO .AND. FECHA_ASI<=II_FEC1-1
  SKIP
 ENDDO

 IF !EOF() .AND. CODMOV=MXCTACON->CODIGO .AND. FECHA_ASI<=II_FEC2
  EXIT
 ELSE

  SELECT MXCTACON
  IF ABORT()
   BREAK
  ENDIF

  IF I_MANUAL
   CTL_MAN()
  ELSE

   SKIP
   IF EOF()
    BREAK
   ENDIF

  ENDIF

 ENDIF
ENDDO

ENDIF

SELECT (MI_SEL)
RETURN 0


PROCEDURE DCON0405
PRIVATE XREG
* DETALLE MAYOR GENERAL
SELECT MXCTACON
*BUSCA SALDOS EN EL ARCHIVO DE DATOS ACTUALIZABLES Y MOVIMIENTOS
IF EMPTY(II_FEC2)
 II_FEC2=FECMAX
ENDIF
SELECT MXCTACON
XREG=RECNO()
if g_nacional
 SELE MXDAACON
 GOTO XREG
 XSALDO=SALDO_ANT(PERIODO(II_FEC1-1))
 SELEC TRACON
 SET SOFT ON
 SEEK(MXCTACON->CODIGO+TRIM(SUBSTR(DTOS(II_FEC1-1),1,6)))
 SET SOFT OFF
else
 xsaldo:=0
 SELEC TRACON
 SEEK(MXCTACON->CODIGO)
endif
DO WHILE !EOF() .AND. CODMOV=MXCTACON->CODIGO .AND. FECHA_ASI<=II_FEC1-1
  if if(Empty(ii_ccto),.t.,CodDpto=ii_ccto)
     XSALDO=XSALDO+e_importe(IMPORTE,fecha_asi)
  endif
  SKIP
ENDDO
IF IMPRE
 IF !II_SALTO
  ESCRIBE([CODIGO:]+MXCTACON->CODIGO)
  ESCRIBE([NOMBRE:]+MXCTACON->NOMBRE)
  CONTINUA=.T.
 ENDIF
 STORE 0 TO XDEBITOS,XCREDITOS,DEBMES,CREMES
 ESCRIBE(SPACE(28)+[ SALDO AL ]+DTOC(II_FEC1-1)+[  --------------->]+SPACE(45)+TRANS(XSALDO,TRAN21))
ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(SPACE(41)+' SALDO AL '+DTOC(II_FEC1-1)+' '+STR(XSALDO,17,G_REDONDO))
 SETCOLOR(C_TEX2)
ENDIF
SELE TRACON
DO WHILE !EOF() .AND. CODMOV=MXCTACON->CODIGO .AND. FECHA_ASI<=II_FEC2
 MIMES =MONTH(FECHA_ASI)
 XFECHA=DTOC(FECHA_ASI)
if if(Empty(ii_ccto),.t.,CodDpto=ii_ccto)
 XSALDO=XSALDO+e_importe(IMPORTE,fecha_asi)
 IF !IMPRE
  ESCRIBE(XFECHA+' '+ASIENTO+' '+SUBSTR(REFER,1,8)+' '+SUBSTR(CONCEPTO,1,14)+' '+STR(e_importe(IMPORTE,fecha_asi),17,G_REDONDO)+' '+STR(XSALDO,17,G_REDONDO))
 ELSE
  ESCRIBE(XFECHA+[ ]+ASIENTO+[ ]+REFER+[ ]+CONCEPTO+[ ]+IF(IMPORTE>0,TRANS(e_importe(IMPORTE,fecha_asi),TRAN21)+SPACE(22),SPACE(22)+TRANS(e_importe(-IMPORTE,fecha_asi),TRAN21))+[ ]+TRANS(XSALDO,TRAN21))
  IF IMPORTE>0
   XDEBITOS=XDEBITOS + e_importe(IMPORTE,fecha_asi)
   DEBMES=DEBMES     + e_importe(IMPORTE,fecha_asi)
  ELSE
   XCREDITOS=XCREDITOS - e_importe(IMPORTE,fecha_asi)
   CREMES=CREMES       - e_importe(IMPORTE,fecha_asi)
  ENDIF
 ENDIF
endif
 SKIP
if if(Empty(ii_ccto),.t.,CodDpto=ii_ccto)
 IF IMPRE
  IF MIMES<>MONTH(FECHA_ASI) .OR. EOF()
   ESCRIBE(SPACE(25)+[    TOTAL ]+UPPER(PAD(G_MESES[MIMES],12))+[ -----------------> ]+TRANS(DEBMES,TRAN21)+[ ]+TRANS(CREMES,TRAN21)+[ ]+TRANS(XSALDO,TRAN21))
   ESCRIBE([])
   STORE 0 TO DEBMES,CREMES
  ENDIF
 ELSE
  IF MIMES<>MONTH(FECHA_ASI) .AND. !EOF() .AND. FECHA_ASI<=II_FEC2
   ESCRIBE([])
  ENDIF
 ENDIF
endif
ENDDO
* TOTAL PARCIAL EN MAYOR GENERAL
IF IMPRE
 IF II_SALTO
  ESCRIBE(REPLICATE([=],I_ANCHO))
 ENDIF
 ESCRIBE(SUBSTR(MXCTACON->NOMBRE,1,25)+[    TOTAL AL ]+DTOC(II_FEC2)+[  ---------------> ]+TRANS(XDEBITOS,TRAN21)+[ ]+TRANS(XCREDITOS,TRAN21)+[ ]+TRANS(XSALDO,TRAN21))
 IF II_SALTO
  ESCRIBE(REPLICATE([=],I_ANCHO))
 ELSE
  CONTINUA=.F.
  ESCRIBE([])
 ENDIF
ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(SPACE(41)+' SALDO AL '+DTOC(II_FEC2)+' '+STR(XSALDO,17,G_REDONDO))
 SETCOLOR(C_TEX2)
ENDIF
