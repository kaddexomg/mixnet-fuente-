PROCEDURE DCON0406
local fec1,fec2
* DETALLE BALANCE DE COMPROBACION
SELECT MXCTACON
XNIVCOD=NIVCOD
IF XNIVCOD<MAXNIVEL .AND. XNIVCOD<>0
 SKIP
 RETURN
ENDIF
XCODIGO = CODIGO
XNOMBRE = NOMBRE
XMARCA  = MARCA
XAPU=RECNO()
SELE MXDAACON
GOTO XAPU
if g_nacional
   if empty(ii_ccto)
    XSALDO_ANT = bs(SALDO_ANT(YPER))
    XDEBITOS   = bs(DEB&YPER.)
    XCREDITOS  = bs(CRE&YPER.)
   else
    fec1:=pri_day(ii_fec)
    fec2:=ult_day(ii_fec)
    xsaldo_ant:=0
    xdebitos:=0
    xcreditos:=0
    select mxrencon
    SEEK(trim(XCODIGO))
    DO WHILE !EOF() .AND. CODMOV=trim(XCODIGO)
       if if(empty(ii_ccto),.t.,CodDpto=ii_ccto)
          if fecha_asi<fec1
             XSALDO_ANT += e_importe(IMPORTE,fecha_asi)
          else
             if fecha_asi<=fec2
                if importe>0
                   xdebitos  += e_importe(IMPORTE,fecha_asi)
                 else
                   xcreditos += e_importe(-IMPORTE,fecha_asi)
                endif
             endif
           endif
       endif
       SKIP
    ENDDO
    SELE MXDAACON
   endif
else
   fec1:=pri_day(ii_fec)
   fec2:=ult_day(ii_fec)
   xsaldo_ant:=0
   xdebitos:=0
   xcreditos:=0
   select mxrencon
   SEEK(trim(XCODIGO))
   DO WHILE !EOF() .AND. CODMOV=trim(XCODIGO)
      if if(empty(ii_ccto),.t.,CodDpto=ii_ccto)
         if fecha_asi<fec1
            XSALDO_ANT += e_importe(IMPORTE,fecha_asi)
         else
            if fecha_asi<=fec2
               if importe>0
                  xdebitos  += e_importe(IMPORTE,fecha_asi)
                else
                  xcreditos += e_importe(-IMPORTE,fecha_asi)
               endif
            endif
         endif
      endif
      SKIP
   ENDDO
   SELE MXDAACON
endif
IF !XMARCA
 IF qq_mov() .OR. II_ZERO
  NIVEL++
  IF !II_IMAGEN
   TOT_DEB[NIVEL]=XDEBITOS
   TOT_CRE[NIVEL]=XCREDITOS
   TOT_SAL[NIVEL]=XSALDO_ANT
  ELSE
   TOT_DEB[NIVEL]=0
   TOT_CRE[NIVEL]=0
   TOT_SAL[NIVEL]=0
  ENDIF
  ESCRIBE([])
  IF IMPRE
   ESCRIBE(XCODIGO+SPACE(NIVEL)+XNOMBRE)
  ELSE
   SETCOLOR(C_TIT2)
   ESCRIBE(XCODIGO+' '+XNOMBRE)
   SETCOLOR(C_TEX2)
  ENDIF
  ESCRIBE([])
  XNAME[NIVEL]=XNOMBRE
 ENDIF
ELSE
 IF II_IMAGEN
  SELE MXCTACON
  PASA=IMAGEN(PAD(II_DESDE,I_LARGO))
  SELE MXDAACON
 ELSE
  PASA=.T.
 ENDIF
 IF ((DIFCERO(XSALDO_ANT) .OR. DIFCERO(XDEBITOS) .OR. DIFCERO(XCREDITOS)) .OR. II_ZERO) .AND. PASA
  XSALDO_ACT=XSALDO_ANT+XDEBITOS-XCREDITOS
  IF IMPRE
   ESCRIBE(IF(XNIVCOD=0,XCODIGO+[ ]+SUBSTR(XNOMBRE,1,20)+SPACE(1),XCODIGO+SPACE(4)+SUBSTR(XNOMBRE,1,20))+[ ]+TRANS(XSALDO_ANT,TRAN21)+[ ]+TRANS(XDEBITOS,TRAN21)+[ ]+TRANS(XCREDITOS,TRAN21)+[ ]+TRANS(XSALDO_ACT,TRAN21))
  ELSE
   ESCRIBE(XCODIGO+[ ]+SUBSTR(XNOMBRE,1,14)+[ ]+TRANS(XSALDO_ANT,TRAN21)+[ ]+TRANS(XSALDO_ACT,TRAN21))
  ENDIF
  TSALDO_ANT=TSALDO_ANT+XSALDO_ANT
  TDEBITOS=TDEBITOS+XDEBITOS
  TCREDITOS=TCREDITOS+XCREDITOS
  IF II_IMAGEN .AND. XNIVCOD<>0
   FOR W=1 TO XNIVCOD
    TOT_DEB[W]=TOT_DEB[W]+XDEBITOS
    TOT_CRE[W]=TOT_CRE[W]+XCREDITOS
    TOT_SAL[W]=TOT_SAL[W]+XSALDO_ANT
   NEXT
  ENDIF
 ENDIF
 IF XNIVCOD=0
  NIVEL=0
 ENDIF
ENDIF
SELE MXCTACON
SKIP
* SUBTOTAL EN BALANCE DE COMPROBACION
J=NIVCOD
IF (MARCA .AND. J=NIVEL+1)
 RETURN
ENDIF
IF !(&I_CONDICION) .OR. EOF() .OR. J<MAXNIVEL
 J=MAXNIVEL
ENDIF
DO WHILE NIVEL>=J
 YANT=TOT_SAL[NIVEL]
 YDEB=TOT_DEB[NIVEL]
 YCRE=TOT_CRE[NIVEL]
 YSAL=YANT+YDEB-YCRE
 IF (YANT<>0 .OR. YDEB<>0 .OR. YCRE<>0) .OR. II_ZERO
  IF IMPRE
   ESCRIBE(SPACE(45)+REPLICATE('-',87))
   XLINEA = [= TOTAL =]+SPACE(11+NIVEL)+SUBSTR(XNAME[NIVEL],1,20)+SPACE(4-NIVEL)+[ ]
   ESCRIBE(XLINEA+TRANS(YANT,TRAN21)+' '+TRANS(YDEB,TRAN21)+' '+TRANS(YCRE,TRAN21)+' '+TRANS(YSAL,TRAN21))
  ELSE
   ESCRIBE([])
   SETCOLOR(C_TIT2)
   ESCRIBE(SPACE(10)+[TOTAL ]+SUBSTR(XNAME[NIVEL],1,19)+[ ]+TRANS(YANT,TRAN21)+[ ]+TRANS(YSAL,TRAN21))
   SETCOLOR(C_TEX2)
  ENDIF
 ENDIF
 NIVEL=NIVEL-1
ENDDO
RETURN

PROCEDURE FCON0406
