PROCEDURE DCON0402
LOCAL R_SIGNO
* DETALLE DIARIO GENERAL
SELECT MXENCCON
CTL_MAN()
IF &I_CRITERIO
 XFECHA_ASI=FECHA_ASI
 XASIENTO=ASIENTO
 IF IMPRE
  ESCRIBE([FECHA: ]+DTOC(FECHA_ASI)+[   ASIENTO: ]+ASIENTO+SPACE(10)+[NOMBRE: ]+DESC_ASI)
 ELSE
  SETCOLOR(C_TIT2)
  ESCRIBE([FECHA: ]+DTOC(FECHA_ASI)+[   ASIENTO: ]+ASIENTO+[   NOMBRE: ]+DESC_ASI)
  SETCOLOR(C_TEX2)
 ENDIF
 SELECT MXRENCON
 SEEK(DTOS(XFECHA_ASI)+XASIENTO)
 DO WHILE !EOF() .AND. (DTOS(FECHA_ASI)+ASIENTO=DTOS(XFECHA_ASI)+XASIENTO)
   XNOMBRE=NOMCOD(CODMOV,[MXCTACON])
   R_SIGNO:=RSG(CONCEPTO)
   IF IMPRE
    ESCRIBE(CODMOV+[ ]+SUBSTR(XNOMBRE,1,25)+[ ]+REFER+[ ]+SUBSTR(CONCEPTO,1,30)+[ ]+IF(IMPORTE>0,TRANS(e_importe(r_signo*IMPORTE,xfecha_asi),TRAN21),SPACE(22)+TRANS(e_importe(-r_signo*IMPORTE,xfecha_asi),TRAN21)))
   ELSE
    ESCRIBE(CODMOV+[ ]+SUBSTR(XNOMBRE,1,15)+[ ]+SUBSTR(REFER,1,7)+[ ]+IF(IMPORTE>0,STR(e_importe(r_signo*IMPORTE,fecha_asi),16,g_redondo),SPACE(18)+STR(e_importe(-r_signo*IMPORTE,xfecha_asi),16,g_redondo)))
   ENDIF
   IF IMPORTE>0
    XDEBITOS =XDEBITOS +r_signo*e_importe(IMPORTE,xfecha_asi)
   ELSE
    XCREDITOS=XCREDITOS+r_signo*e_importe(IMPORTE,xfecha_asi)
   ENDIF
   SKIP
 ENDDO
 * totales
 IF IMPRE
  ESCRIBE(SPACE(89)+REPL('-',43))
  ESCRIBE(SPACE(60)+'     TOTAL ASIENTO: '+XASIENTO+' '+TRANS(XDEBITOS,TRAN21)+[ ]+TRANS(-XCREDITOS,TRAN21))
  ESCRIBE([])
 ELSE
  ESCRIBE(SPACE(20)+'TOTAL ASIENTO: '+XASIENTO+[ ]+STR(XDEBITOS,17,G_REDONDO)+[ ]+STR(-XCREDITOS,17,G_REDONDO),C_TIT2)
  ESCRIBE([])
 ENDIF
 TOT_DEBI=TOT_DEBI+XDEBITOS
 TOT_CRED=TOT_CRED+XCREDITOS
 STORE 0 TO XDEBITOS,XCREDITOS

ENDIF
SELECT MXENCCON
IF !I_MANUAL
 SKIP
ENDIF
RETURN


