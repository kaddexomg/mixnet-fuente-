DO DCON0407
RETURN

FUNCTION BUSSALDO
LOCAL TU_SALDO,MI_REG
SELECT MXCTACON
MI_REG=RECNO()
SELECT MXDAACON
GOTO MI_REG
IF ES_BALA
 if g_nacional
    IF DEFINIDO.AND.!EMPTY(RDBCON->CODREG)
       TU_SALDO:=SALDO_AJU(RDBCON->CODREG,MXCTACON->CODIGO,FECNUL,II_FEC1)
    ELSE
       IF II_FEC1=ULT_DAY(II_FEC1) .AND. empty(ccto)
          TU_SALDO=SALDO_ACT(YPER)
       ELSE
          TU_SALDO=SALDO_FEC(MXCTACON->CODIGO,FECNUL,II_FEC1)
       ENDIF
    ENDIF
 else
    TU_SALDO:=SALDO_ext(MXCTACON->CODIGO,FECNUL,II_FEC1)
 endif
ELSE
 if g_nacional
    IF DEFINIDO.AND.!EMPTY(RDBCON->CODREG)
       TU_SALDO:=SALDO_AJU(RDBCON->CODREG,MXCTACON->CODIGO,II_FEC1,II_FEC2)
    ELSE
       IF II_FEC2=ULT_DAY(II_FEC2) .AND. empty(ccto)
          TU_SALDO=SALDO_ENT(YPER1,YPER2)
       ELSE
          TU_SALDO=SALDO_FEC(MXCTACON->CODIGO,II_FEC1,II_FEC2)
       ENDIF
    ENDIF
 else
    TU_SALDO=SALDO_ext(MXCTACON->CODIGO,II_FEC1,II_FEC2)
 endif
ENDIF

SELECT MXCTACON
RETURN (bs(TU_SALDO))


