PROCEDURE TPO0000
PARAMETERS P1,P2,P3
PRIVATE ULT_ALIAS
DECLARE RCAMPO[ 3],RSUBTIT[ 3]
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)

PRIVATE XCODTPO,XNOMTPO,XCOSTPO
PRIVATE BCODTPO,BNOMTPO

BCODTPO=SPACE(5)
BNOMTPO=SPACE(35)
DO CAMTPO
DO SUBTPO
ULT_ALIAS=ALIAS()

IF ABRIR([MXCTATPO],MXCTATPO,[S],MXCTTPX1)
 DO EDC WITH [TPO],[ COSTOS ADICIONALES ],RSUBTIT,RCAMPO,.T.,.T.,.T.,.T.,.F.,.F.,.F.,.F.
 CERRAR()
ENDIF
RESEL()
RETURN


PROCEDURE SUBTPO
RSUBTIT[ 1]=[C¢digo]
RSUBTIT[ 2]=[Nombre]+SPACE(29)
RSUBTIT[ 3]=[      Costo]
RETURN

PROCEDURE CAMTPO
RCAMPO[ 1]=[CODTPO]
RCAMPO[ 2]=[NOMTPO]
RCAMPO[ 3]=[COSTPO]
RETURN

PROCEDURE DEFTPO
* VALORES POR DEFECTO
XCODTPO    = SPACE(  5)
XNOMTPO    = SPACE( 35)
XCOSTPO    = 0
RETURN

PROCEDURE ASGTPO
* ASIGNACION DE REGISTRO A MEMORIA
XCODTPO    = CODTPO
XNOMTPO    = NOMTPO
XCOSTPO    = COSTPO
RETURN

PROCEDURE RPLTPO
* REEMPLAZO EN EL REGISTRO
AUDITORIA([Acceso a mantenimiento de costos adicionales],xcodtpo,codtpo,IF(MODIFICA,[MOD],[INC]))
REPLACE CODTPO WITH XCODTPO,NOMTPO WITH XNOMTPO,COSTPO WITH XCOSTPO
RETURN

PROCEDURE MASTPO
* MASCARA DE LA VENTANA
LINSIM()
RETURN

PROCEDURE GETTPO
* CAPTURA REGISTRO
@ CONTLIN, 2+MARGEN GET XCODTPO  PICT [@!] VALID CHK_CLAVE(XCODTPO,[CODIGO])
@ CONTLIN, 9+MARGEN GET XNOMTPO
@ CONTLIN,45+MARGEN GET XCOSTPO    PICT "9999999.99"
READ
SALIR=ESCAPAR()
RETURN

PROCEDURE DETTPO
* DETALLE
@ CONTLIN, 2+MARGEN SAY CODTPO
@ CONTLIN, 9+MARGEN SAY NOMTPO
@ CONTLIN,45+MARGEN SAY COSTPO

RETURN


PROCEDURE GETBTPO
* CAPTURA DE CAMPOS EN MODO BROWSE
DO CASE
CASE ICAMPO=1
@ ROW(),COL() GET XCODTPO  PICT [@!] VALID CHKDUP(XCODTPO,[CODIGO])
CASE ICAMPO=2
@ ROW(),COL() GET XNOMTPO
CASE ICAMPO=3
@ ROW(),COL() GET XCOSTPO    PICT "9999999.99"
ENDCASE
READ
RETURN

PROCEDURE ELITPO
* ELIMINACION DE REGISTRO
AUDITORIA([Acceso a mantenimiento de costos adicionales],codtpo,,[ELI])
DELETE
RETURN

PROCEDURE CRDTPO
* COORDENADAS DE LA VENTANA
TOPE= 7
FONDO=17
COLIZQ= 1
COLDER=56
RETURN

PROCEDURE SELTPO
KEYBOARD CODTPO
RETURN

PROCEDURE BUSTPO
PRIVATE TCODTPO,TNOMTPO
VERTBUS([BFUNTPO])
RETURN

PROCEDURE BFUNTPO
* BUSQUEDA
@  CONTLIN,2+MARGEN GET BCODTPO PICT [@!]
@  CONTLIN,9+MARGEN GET BNOMTPO
LEER()
SALIR=ESCAPAR() .OR. ( EMPTY(BCODTPO) .AND. EMPTY(BNOMTPO) )

IF !SALIR
 IF !EMPTY(BCODTPO)
  TCODTPO=TRIM(BCODTPO)
  YKEY=TCODTPO
 ELSE
  TNOMTPO=TRIM(BNOMTPO)
  BCONDICION=[TNOMTPO$NOMTPO]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN




