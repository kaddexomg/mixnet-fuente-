PROCEDURE GETRDP
* CAPTURA REGISTRO

SET KEY -7 TO SELINFINV
MENSAJ("F8=ALMACEN",MAXROW())

@ CONTLIN, 2 GET XITEM PICT ITEM_MASK VALID CHKTPO(XITEM)
@ CONTLIN, 18 GET XDESCRIP PICT '@S23'
READ
SALIR=ESCAPAR()
SET KEY -7 TO
MENSAJ("",MAXROW())
IF !EMPTY(XITEM).AND.!SALIR
 @ CONTLIN,42 GET XCANT  PICT "999999.99999"  VALID XCANT>0
 @ CONTLIN,55 GET XCOSTO PICT "9999999.99"
 READ
 SALIR=ESCAPAR(1)
 IF XCOSTO=0 .AND. !SALIR
  @ CONTLIN,66 GET XCOSTO_TOT PICT PIC12
  READ
  SALIR=ESCAPAR()
  XCOSTO=DIV(XCOSTO_TOT,XCANT,10)
  XCOSTO_TOT := CAMBIO_IMPORTE(XCOSTO_TOT,XEMISION)
 ENDIF
 IF !SALIR
  XCOSTO := CAMBIO_IMPORTE(XCOSTO,XEMISION)
  XCOSTO_TOT=ROUND( XCANT*XCOSTO,2 )
  @ CONTLIN,66 SAY XCOSTO_TOT  PICT PIC12
  CONFORME=[S]
 ENDIF
ENDIF
IF EMPTY(XITEM)
 CONFORME=[S]
 XCANT   =0
ENDIF
IF INV_CODCON='S'.AND. !SALIR .AND. !EMPTY(XITEM)
  CUENTACON()
ENDIF
RETURN


