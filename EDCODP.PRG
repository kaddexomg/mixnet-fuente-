FUNCTION CHKTPO(YITEM)
local t
IF LASTKEY()=5
 RETURN .T.
ENDIF

IF TRIM(UPPER(YITEM))='HT'
 IF ABRIR('MXRENHDP',MXRENHDP,'S',MXREHDX1)
  SEEK(XNUMODP)
  XCANTIDAD:=0
  xcant:=0
  WHILE !EOF().AND.NUMODP=XNUMODP
   xcant+=horastrab(hora_INI,hora_FIN)*xfactor_us/100
   XCANTIDAD+=CANTIDAD
   skip
  ENDDO
  cerrar('MXRENHDP')
  XDESCRIP:=PAD('HORAS TRABAJADAS',35)
  XCOSTO  :=0
  IF ABRIR('MXTABLIN',MXTABLIN,'S',MXTALIX1)
   SEEK(XLINEA_P)
   IF FOUND()
     XCOSTO  :=MXTABLIN->COSTO
   ENDIF
   CERRAR('MXTABLIN')

   @  5,12 SAY XCANTIDAD  PICT '999999.999'

  ENDIF
  SELECT BUFFER
  RETURN .T.
 ENDIF
ENDIF


SELECT MXCTAINV
SEEK(YITEM)
IF FOUND()
 XDESCRIP=NOMART
 XCOSTO  =COSTO_ACT
ELSE

 SELECT MXCTATPO
 SEEK(substr(YITEM,1,5))
 IF !FOUND()
  DO TPO0000
  IF LASTKEY()=27
   KEYBOARD ESCAPE
   WAIT
   SELECT BUFFER
   RETURN .T.
  ENDIF
  SELECT BUFFER
  RETURN .F.
 ELSE
  XDESCRIP=NOMTPO
  XCOSTO  =COSTPO
 ENDIF
ENDIF
SELECT BUFFER
RETURN .T.


