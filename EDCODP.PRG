PROCEDURE GETODP
* CAPTURA REGISTRO
ENTRO=.F.
private ed_renglon
ed_renglon=.t.
SET KEY 279 TO
if modifica
 if ustr_edoalm='N' .and. almacen1<>ustr_almuser
   SET CURSOR OFF
   Pare(men10)
   SALIR=.T.
   RETURN
 endif
endif
DO WHILE .T.
 SETCOLOR(C_TIT2)
 @  3,12 GET XNUMODP  PICT [@!] VALID (CHKDUP(XNUMODP,[ORDEN DE PRODUCCION]) .AND. !EMPTY(XNUMODP)) .OR. LASTKEY()=5
 @  3,37 GET XEMISION  VALID !CHK_BLOCK(XEMISION)
 @  3,68 GET XTERMINO   valid xtermino>=xemision .or. empty(xtermino)
 @  4,12 GET XCODART    PICT ITEM_MASK VALID CHEKART(XCODART)
 @  5,12 GET XCANTIDAD  PICT XMQTY VALID XCANTIDAD>0 .OR. LASTKEY()=5
 @  5,41 GET XFACTOR_US PICT '999.99'
 @  5,57 GET Xlinea_p VALID CHKLIN(XLINEA_P)
 @  6,74 GET XALMACEN1 pict '!!' when g_multi .and. ustr_edalm='S' VALID CHALM(XALMACEN1,xemision) .and. Chk_baf(xalmacen1,xemision)
 @  7,74 GET XALMACEN2 pict '!!' when g_multi VALID CHALM(XALMACEN2,,,1) .and. Chk_baf(xalmacen1,xemision)
 @  6,15 GET XCOMEN1
 @  7,15 GET XCOMEN2
 READ
 IF ESCAPAR()
  IF ENTRO
   DO BELL
   IF DECIS([¨ Desea cancelar la operaci¢n ?],1)=[S]
    CANCNUM(MXNUMODP,XNUMODP)
    SALIR=.T.
    SET KEY 279 TO REIMPRIM
    RETURN
   ELSE
    LOOP
   ENDIF
  ELSE
   CANCNUM(MXNUMODP,XNUMODP)
   SALIR=.T.
   SET KEY 279 TO REIMPRIM
   RETURN
  ENDIF
 ENDIF
 IF EMPTY(XCODART)
  LOOP
 ENDIF
 ENTRO=.T.
 XESTATUS=IF(!EMPTY(XTERMINO),'OK','PE')
 xexpande:=if(!modifica.and.conforme<>'N',decis('¨ Desglose de componentes ?'),xexpande)
 IF ABRIR([BUFFER],BUFFER,[E])
  IF XCOMPUESTO='S'
   IF XEXPANDE='S'
    IF !MODIFICA .and. conforme<>'N'
     EXPANART()
    ENDIF
   ELSE
    LOCATE FOR ITEM='00001'
    IF EOF()
     APPEND BLANK
    ENDIF
    XCOSTO=CALCOSPOS()
    REPLACE ITEM      WITH '00001',   ;
            CANTIDAD  WITH XCANTIDAD ,   ;
            COSTO_TOT WITH XCOSTO*XCANTIDAD,;
            DESCRIP   WITH 'COMPONENTES'
    GO TOP


   ENDIF

  ELSE
   LOCATE FOR ITEM='00001'
   IF !EOF()
    DELETE
    PACK
   ENDIF
  ENDIF

  SETCOLOR(C_TEX2)
  RECAODP()
  DP_TOTAL()
  GO TOP
  SETCOLOR(C_TIT2)
  VACIO=.F.
  WHILE .T.
   IF MODIFICA
     SET KEY -9 TO HISODP
   ELSE
     SET KEY -9 TO
   ENDIF
   ustre:='USTREINV'+Alltrim(Str(subopcion))
   ClvT:=&ustre
   &ustre.:='SSS'
   EDC([RDP],[],RSUBTIT,RCAMPO,.T.,.T.,.T.,.F.,.F.,.T.,.T.,.F.,IF(MODIFICA,'F10=HISTORICO DE PRODUCCION',''))
   &ustre.:=ClvT
   SELECT BUFFER
   REPLACE ALL  NUMODP WITH XNUMODP, EMISION WITH XEMISION, ESTATUS WITH XESTATUS
   GO TOP
   IF LASTREC()=0 .OR. EOF()
    VACIO=.T.
    EXIT
   ENDIF

    * PIE **********
   ok=.t.
   EXIT
    ****************
  ENDDO

  HAZ_FORART(XEXPANDE='S')

  CERRAR([BUFFER])

  IF VACIO
   SELECT MXENCODP
   DO PANODP
   LOOP
  ENDIF
  IF !OK
   DO PANODP
   KEYBOARD [N]
  ENDIF

  CONFORME=CONFIRMA()
  IF CONFORME<>[S]
   IF CONFORME=[C]
    CANCNUM(MXNUMODP,XNUMODP)
   ENDIF
  ENDIF
 ENDIF
 EXIT
ENDDO
SELECT MXENCODP
SET KEY -9 TO HISODP
SET KEY 279 TO REIMPRIM
RETURN


