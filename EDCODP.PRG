DO MENSAJ WITH [Grabando ORDEN DE PRODUCCION ...]
AUDITORIA([Acceso a mantenimiento de orden de producci¢n],xnumodp+' '+dtoc(xemision),numodp+' '+dtoc(emision),IF(MODIFICA,[MOD],[INC]))
REPLACE NUMODP WITH XNUMODP,EMISION  WITH XEMISION
REPLACE COMEN1 WITH XCOMEN1,COMEN2 WITH XCOMEN2, ALMACEN1 WITH XALMACEN1,;
        ALMACEN2 WITH XALMACEN2

REPLACE TERMINO    WITH XTERMINO,   ;
        CODART     WITH XCODART ,   ;
        CANTIDAD   WITH XCANTIDAD,  ;
        TOT_ODP    WITH XTOT_ODP,;
        ESTATUS    WITH XESTATUS,;
        EXPANDE WITH XEXPANDE,;
        FACTOR_US WITH XFACTOR_US,;
        LINEA_P WITH XLINEA_P

SELECT MXRENODP
DO WHILE !FLOCK()
ENDDO
IF MODIFICA
 SEEK(LNUMODP)
 DELETE WHILE NUMODP = LNUMODP
ENDIF
APPEND FROM (BUFFER)
UNLOCK

INTERODP()
LIMPIA()

