PROCEDURE GETBRDP
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC
FFF=ROW()
CCC=COL()

DO CASE
CASE ICAMPO=1
 @ FFF,CCC GET XITEM PICT ITEM_MASK VALID CHKTPO()
READ
CASE ICAMPO=2
 @ FFF,CCC GET XDESCRIP PICT '@S25'
READ
CASE !EMPTY(XITEM)
 DO CASE
 CASE ICAMPO=3
  @ FFF,CCC GET XCANT  PICT XMQTY
  READ
 CASE ICAMPO=4
  @ CONTLIN,55 get xcosto  PICT XMCOS
  READ
 CASE ICAMPO=5
  @ CONTLIN,66 GET xCOSTO_TOT PICT XMCOS
 READ
 SALIR=ESCAPAR()
 IF !SALIR
  XCOSTO=DIV(XCOSTO_TOT,XCANT)
 ENDIF
 RETURN
 ENDCASE

OTHERWISE
 SALIR=.T.
 RETURN
ENDCASE
SALIR=ESCAPAR()
IF !SALIR
 XCOSTO_TOT=ROUND( XCANT*XCOSTO,2 )
ENDIF
RETURN

