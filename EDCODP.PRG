FUNCTION VERSAL
* VERIFICA SALIDA DE MATERIALES
LOCAL I,L:=LEN(FORART), xex_act:=0
PRIVATE  USEL,DEVO,EXI
DEVO=.T.
USEL=SELECT()
MENSAJ("VERIFICANDO SALIDA DE MATERIALES ...")
FOR I:=1 TO L
 SELECT MXCTAINV
 SEEK(FORART[I])
 IF FOUND()
  xex_act:=EXIST(XEMISION,XALMACEN)
  EXI:=xex_act-canart[i]
  IF EXI<0
   PARE('ARTICULO '+ALLTRIM(CODART)+' NO TIENE EXISTENCIAS SUFICIENTES. FALTAN:'+ALLTRIM(STR(CANART[I]-xex_act,10,3)))
   DEVO=.F.
  ENDIF
 ENDIF
NEXT
SELECT (USEL)
RETURN DEVO


FUNCTION GENSAL
* GENERA SALIDA DE MATERIALES
LOCAL I,L:=LEN(FORART)
PRIVATE  USEL, RETO,XALMACEN:=XALMACEN1
USEL=SELECT()
RETO=.F.
IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
 IF VERSAL()
  IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX1,MXTRINX2,MXTRINX3)
   DO MENSAJ WITH [Generando SALIDA en INVENTARIO ...]
   FOR I:=1 TO L
    SELECT MXCTAINV
    SEEK(FORART[I])
    IF FOUND()
     XCANTIDAD  = CANART[I]
     XCOSTO_TOT = 0
     XCODMOVART = FORART[I]
     XTIPINV    = 'SA'
     XFECHA_MOV = MXENCODP->EMISION
     XNUMDOC    = MXENCODP->NUMODP
     XORIGEN    = 'PRO'
     XUNIDAD    = MXCTAINV->UNIDAD
     SELECT MXTRAINV
     ADD_REC(0)
     ARC_INV()
    ENDIF
   NEXT
   CERRAR('MXTRAINV')
   RETO=.T.
  ENDIF
 ENDIF
 CERRAR('MXEXTINV')
ENDIF
SELECT (USEL)
RETURN RETO


FUNCTION RE_GENSAL
PARAMETER EL_NUM
* REVERSA MOVIMIENTOS DE INVENTARIO
LOCAL I,L:=LEN(LFORART)

PRIVATE  USEL
USEL=SELECT()
IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
 IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX1,MXTRINX3)
  FOR I=1 TO L
   SELECT MXCTAINV
   SEEK(LFORART[I])
   IF FOUND()
     XITEM      = CODART
     SELECT MXTRAINV
     SET ORDER TO 2
     SEEK(EL_NUM+[SA]+XITEM+'PRO')
     IF FOUND()
      SET ORDER TO 1
      DO MENSAJ WITH [Reversando SALIDA en INVENTARIO ...]
      SW_RECAL = .F.
      SELECT MXTRAINV
      REV_INV()
      SELECT MXTRAINV
      REC_LOCK(0)
      DELETE
      UNLOCK
      IF SW_RECAL
       RECALCOS(XITEM)
      ENDIF
     ENDIF
   ENDIF
  NEXT
  CERRAR('MXTRAINV')
 ENDIF
 CERRAR('MXEXTINV')
ENDIF
SELECT (USEL)
RETURN 0


