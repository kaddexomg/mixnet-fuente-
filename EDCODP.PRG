STATIC PROC HAZ_FORART(EX)
LOCAL  USEL

FORART:={}
CANART:={}
USEL=SELECT()
IF !EX
 SELECT MXCOMINV
 SEEK(XCODART)
 DO WHILE !EOF() .AND. CODART=XCODART
  SELECT MXCTAINV
  SEEK(MXCOMINV->ITEM)
  IF FOUND()
   AADD(FORART,MXCOMINV->ITEM)
   AADD(CANART,MXCOMINV->CANTIDAD)
  ENDIF
  SELECT MXCOMINV
  SKIP
 ENDDO
ENDIF

 SELECT BUFFER
 DO WHILE !EOF()
  SELECT MXCTAINV
  SEEK(BUFFER->ITEM)
  IF FOUND()
   AADD(FORART,BUFFER->ITEM)
   AADD(CANART,BUFFER->CANTIDAD)
  ENDIF
  SELECT BUFFER
  SKIP
 ENDDO
 GO TOP
SELECT (USEL)

RETURN

STATIC PROC HAZ_LFORART(YNUMODP)
LOCAL USEL
LFORART:={}
SELECT MXENCODP
IF MXENCODP->EXPANDE='S'
 SELECT MXRENODP
 SEEK(YNUMODP)
 WHILE !EOF() .AND. NUMODP=YNUMODP
  SELECT MXCTAINV
  SEEK(MXRENODP->ITEM)
  IF FOUND()
   AADD(LFORART,MXRENODP->ITEM)
  ENDIF
  SELECT MXRENODP
  SKIP
 ENDDO
ELSE

 SELECT MXCOMINV
 SEEK(MXENCODP->CODART)
 WHILE !EOF() .AND. CODART=MXENCODP->CODART
  SELECT MXCTAINV
  SEEK(MXCOMINV->ITEM)
  IF FOUND()
   AADD(LFORART,MXCOMINV->ITEM)
  ENDIF
  SELECT MXCOMINV
  SKIP
 ENDDO

ENDIF
SELECT (USEL)

RETURN




