* TABLA DE CONVERSION DE UNIDADES
PROCEDURE INV0313
PARAMETERS P1,P2,P3
PRIVATE ULT_ALIAS
DECLARE RCAMPO[ 7],RSUBTIT[ 7]
PRIVATE XUNID,XUNID1,XEQUI1,XUNID2,XEQUI2,XUNID3,XEQUI3

DO CAMTCN
DO SUBTCN
ULT_ALIAS=ALIAS()

IF ABRIR([TABLA],MXUNI,[S])
 INIT_VER()
 DO EDC WITH [TCN],[ TABLA DE CONVERSION DE UNIDADES ],RSUBTIT,RCAMPO,.T.,.T.,.T.,.T.,.F.,.F.,.F.,.F.
 CERRAR()
ENDIF
DO RESEL
RETURN


PROCEDURE SUBTCN
RSUBTIT[ 1]=[Referencia]
STORE [Unidad] TO RSUBTIT[ 2],RSUBTIT[ 4],RSUBTIT[ 6]
STORE [  Factor] TO RSUBTIT[ 3],RSUBTIT[ 5],RSUBTIT[ 7]
RETURN

PROCEDURE CAMTCN
RCAMPO[ 1]=[UNID]
RCAMPO[ 2]=[UNID1]
RCAMPO[ 3]=[EQUI1]
RCAMPO[ 4]=[UNID2]
RCAMPO[ 5]=[EQUI2]
RCAMPO[ 6]=[UNID3]
RCAMPO[ 7]=[EQUI3]
RETURN

PROCEDURE DEFTCN
* VALORES POR DEFECTO
STORE SPACE(3) TO XUNID,XUNID1,XUNID2,XUNID3
STORE 0 TO XEQUI1,XEQUI2,XEQUI3
RETURN

PROCEDURE ASGTCN
* ASIGNACION DE REGISTRO A MEMORIA
XUNID    = UNID
XUNID1     = UNID1
XEQUI1     = EQUI1
XUNID2     = UNID2
XEQUI2     = EQUI2
XUNID3     = UNID3
XEQUI3     = EQUI3
RETURN

PROCEDURE RPLTCN
* REEMPLAZO EN EL REGISTRO
AUDITORIA([Acceso a mantenimiento de tablas de conversi¢n de unidades],xunid,unid,if(modifica,[MOD],[INC]))
REPLACE UNID     WITH XUNID
REPLACE UNID1      WITH XUNID1
REPLACE EQUI1      WITH XEQUI1
REPLACE UNID2      WITH XUNID2
REPLACE EQUI2      WITH XEQUI2
REPLACE UNID3      WITH XUNID3
REPLACE EQUI3      WITH XEQUI3
RETURN

PROCEDURE MASTCN
* MASCARA DE LA VENTANA
DO LINSIM
RETURN

PROCEDURE GETTCN
* CAPTURA REGISTRO
@ CONTLIN, 2+MARGEN GET XUNID  PICT [!!!]  VALID CHKSEC([UNID=XUNID],[Referencia])
@ CONTLIN,13+MARGEN GET XUNID1     PICT [!!!]
@ CONTLIN,20+MARGEN GET XEQUI1     PICT "9999.999"
@ CONTLIN,29+MARGEN GET XUNID2     PICT [!!!]
@ CONTLIN,36+MARGEN GET XEQUI2     PICT "9999.999"
@ CONTLIN,45+MARGEN GET XUNID3     PICT [!!!]
@ CONTLIN,52+MARGEN GET XEQUI3     PICT "9999.999"
LEER()
SALIR=ESCAPAR()
RETURN

PROCEDURE DETTCN
* DETALLE
@ CONTLIN, 2+MARGEN SAY UNID
@ CONTLIN,13+MARGEN SAY UNID1
@ CONTLIN,20+MARGEN SAY EQUI1
@ CONTLIN,29+MARGEN SAY UNID2
@ CONTLIN,36+MARGEN SAY EQUI2
@ CONTLIN,45+MARGEN SAY UNID3
@ CONTLIN,52+MARGEN SAY EQUI3

RETURN


PROCEDURE GETBTCN
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC
BR_CAMPO=[X]+RCAMPO[ICAMPO]

DO CASE
CASE ICAMPO=1
 @ ROW(),COL() GET XUNID  PICT [!!!]  VALID CHKSEC([UNID=XUNID],[Referencia])
CASE STR(ICAMPO,1)$[2,4,6]
 @ ROW(),COL() GET &BR_CAMPO PICT [!!!]
OTHERWISE
 @ ROW(),COL() GET &BR_CAMPO PICT [9999.999]
ENDCASE

READ
CLEAR GETS
RETURN

