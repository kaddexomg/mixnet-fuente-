DO CASE
 CASE PRICHAR$[\/]
  SELE MXCTASER
  SEEK(SUBSTR(XITEM,2,5))
  IF !FOUND()
   SER0000()
   SELE BUFFER
   RETURN .F.
  ELSE
   CopiServ()
   SELECT BUFFER
   RETURN .T.
  ENDIF
  SELE BUFFER
 CASE PRICHAR$[*-]
  SELE BUFFER
  RETURN .T.
 OTHERWISE
  SELECT MXCTAINV
  SET ORDER TO 1
  LO_ENCONTRO := .F.
  IF EMPTY(XITEM)
     SELINFINV(,,,'TPV')
     IF LASTKEY()=27
        KEYBOARD SALIDA
        WAIT
        SELECT BUFFER
        RETURN .F.
     ENDIF
     CopiArt()
     SELECT BUFFER
     RETURN .F.
  ENDIF
  IF DBSEEK(XITEM)
     LO_ENCONTRO:=.T.
  ELSE
     LO_ENCONTRO:=.F.
     LO_ENCONTRO:=CHEQ_CODEXT()
  ENDIF
  IF LO_ENCONTRO
     CopiArt()
  ELSE
     SET ORDER TO 2
     IF DBSEEK(XITEM)
        LO_ENCONTRO:=.T.
     ELSE
        LO_ENCONTRO:=.F.
     ENDIF
  ENDIF
  SET ORDER TO 1
  IF LO_ENCONTRO
     CopiArt()
  ENDIF
  IF !LO_ENCONTRO
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       RETURN .T.
    ENDIF
     SELECT BUFFER
     RETURN .F.
  ELSE
     CopiArt()
     SELECT BUFFER
  ENDIF
ENDCASE
SELECT BUFFER
RETURN .T.

STATIC Function CopiArt()
   w_var1     := MXCTAINV->UNIDAD
   w_mem[1,1] := MXCTAINV->CODART
   w_mem[2,1] := MXCTAINV->IVA
   if modifica
      if w_mem[1,1] <> BUFFER->ITEM
         w_mem[3,1] := MXCTAINV->nomart
      endif
   else
      w_mem[3,1] := MXCTAINV->nomart
   endif
   w_mem[4,1] := if(modifica,w_mem[4,1],1)
   w_mem[5,1] := if(modifica,w_mem[5,1],MXCTAINV->PRECIO_A)
   w_mem[6,1] := if(modifica,w_mem[6,1],if(MXCTAINV->DES_A>0,MXCTAINV->DES_A,PV_DCTO))
Return nil

STATIC Function CopiServ()
   w_mem[2,1] := MXCTASER->IVA
   if modifica
      if w_mem[1,1] <> BUFFER->ITEM
         w_mem[3,1] := MXCTASER->NOMSER
      endif
   else
      w_mem[3,1] := MXCTASER->NOMSER
   endif
   w_mem[4,1] := if(modifica,w_mem[4,1],1)
   w_mem[5,1] := if(modifica,w_mem[5,1],MXCTASER->PRESER)
   w_mem[6,1] := if(modifica,w_mem[6,1],PV_DCTO)
RETURN .T.






