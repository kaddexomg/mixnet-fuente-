function ELIRAP
 * ELIMINACION DE FACTURA
 local WNUMFAC
 PRIVATE MODIFICA:=.T.
 SELECT MXENCRAP
 xfpago:=FP
 REVCXCPV()
 SELECT MXENCRAP

 WNUMFAC=NUMFAC
 AUDITORIA([Acceso a mantenimiento de Punto de Venta],wnumfac,,[ELI])

 SELECT MXRENRAP
 if dbSEEK(WNUMFAC)
    eliSerial('MXRENRAP',{||mxrenrap->numfac==Wnumfac},;
               {||mxserinv->s_numero==Wnumfac.and.mxserinv->s_origen='PVE'},;
               {||mxserinv->s_numero:='',mxserinv->s_origen:=''})
 endif
 SELECT MXENCRAP
 IF PV_ALM$'ST'
  RE_GENPV(WNUMFAC)
 ENDIF
 SELECT MXENCRAP
 DELCAJ(WNUMFAC)
 SELECT MXENCRAP
 DELETE

 SELECT MXRENRAP
 if DbSeek(wnumfac)
   STORE [] TO listaapa
   do while !eof() .AND. numfac=wnumfac
     if !numapa$listaapa .AND. !Empty(numapa)
       listaapa:=listaapa+numapa+[/]
     endif
     DbSkip()
   enddo
 endif

 SELECT MXRENRAP
 if dbSEEK(WNUMFAC)
  DO WHILE !FLOCK()
  ENDDO
  DELETE WHILE NUMFAC = WNUMFAC
  UNLOCK
 ENDIF
 SELECT MXENCRAP

 ActApa(1)
 IF xfpago=6
    ReversaCtk(WNUMFAC+'PVE',1)
 ENDIF

RETURN

