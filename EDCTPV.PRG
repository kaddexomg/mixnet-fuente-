* EDICION DE FACTURAS PUNTO DE VENTAS
FUNCTION VEN0311
   Local l:=4,c:=2
   Local nOpc,aOpcPv:={'Facturar por P.V.     ',;
                       'Caja de P.V.          ',;
                       'Generar Caja de P.V.  '}
   nOpc:=la_opcion(aOpcPv,l,c,3,1,[ PUNTO DE VENTA ])
   DO CASE
      CASE nOpc=1
         FACTPV()
      CASE nOpc=2
         EDIT_VENTANA('CAJA')
      CASE nOpc=3
         GENCAJAPV()
   ENDCASE
RETURN NIL

