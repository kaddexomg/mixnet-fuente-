FUNCTION ARC_COBPV
* ARCHIVA MOVIMIENTOS DE CUENTAS POR COBRAR Y PAGAR
PARAMETER CTA_ALIAS,TRA_ALIAS,SIN_APPE

PRIVATE XCOD

XCOD = XCODMOVCLI

SELECT &CTA_ALIAS
SEEK(XCOD)

*************************************
REC_LOCK(0)
*************************************

REPLACE SALDO WITH SALDO + XIMPORTE

IF XTIPO$'FC,GR'
 REPLACE TOT_VEN WITH TOT_VEN+XIMPORTE
ENDIF

IF XTIPO$'AB,CA'
 REPLACE FEC_UPAG WITH XEMISION
ENDIF

UNLOCK

SELECT &TRA_ALIAS
IF TYPE([SIN_APPE])=[U]
 REPLACE CODMOVCLI WITH XCODMOVCLI,;
         TIPO      WITH XTIPO,;
         NUMDOC    WITH XNUMDOC,;
         EMISION   WITH XEMISION   ,;
         VENCE     WITH XVENCE,;
         REFER     WITH XREFER,;
         CONCEPTO  WITH XCONCEPTO,;
         IMPORTE   WITH XIMPORTE,;
         ORIGEN    WITH DOC_ORIGEN ,;
         NUMORG    WITH XNUMORG,;
         codven    with xcodven

ENDIF

RETURN 0

FUNCTION REV_COBPV
* REVERSA MOVIMIENTO DE CXC Y CXP
PARAMETER CTA_ALIAS, TRA_ALIAS
PRIVATE XCOD,XIMPORTE,XTIPO

XCOD = CODMOVCLI
XIMPORTE = IMPORTE
XTIPO    = TIPO
SELECT &CTA_ALIAS.
SEEK(XCOD)
IF FOUND()
 *************************************
 REC_LOCK(0)
 *************************************
 REPLACE SALDO WITH SALDO - XIMPORTE

 IF XTIPO$'FC,GR'
  REPLACE TOT_VEN WITH TOT_VEN-XIMPORTE
 ENDIF

 UNLOCK
ENDIF
SELECT &TRA_ALIAS.
RETURN 0

