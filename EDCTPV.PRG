  ENDIF
  DO WHILE .T.
   SELE MXTRACOB
   SEEK(XSERIE)
   IF !FOUND()
    EXIT
   ELSE
    XSERIE=PROX_SIMB(XSERIE)
   ENDIF
  ENDDO
 ENDIF
ENDIF
CERRAR('MXTRACOB')

IF ABRIR([BUFGIR],BUFGIR,[E])

XCODMOVCLI=XCLIENTE
XTIPO='GR'
