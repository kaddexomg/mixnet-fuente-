function GETENC
 * CAPTURA REGISTRO
 LOCAL OK, UKEYF9:=SETKEY(-8), UKEYF8:=SETKEY(-7),nTReg

 SETKEY(-7,NIL)
 SETKEY(-8,NIL)
* SETKEY(-8,{|P,L,V|GETPIE(P,L,V)})

IF MODIFICA
   cCedRif:=MXENCRAP->CIF
ENDIF

 IF pv_credi='N'
    ActDatos()
 ENDIF

 WHILE .T.

  *XDESCUENTO=0
  *XDCTO=0
  *xcargo:=0
  xtot_iva:=0

  CUR_ON()
  W_GETREG()
  IF ESCAPAR()
   IF ENTRO
    BELL()
    SALIR:=decis('¨ Cancelar operaci¢n ?')='S'
   ELSE
    SALIR:=.T.
   ENDIF
   IF SALIR
      SETKEY(-8,UKEYF9)
      SETKEY(-7,UKEYF8)
      RETURN
   ENDIF
  ENDIF

  xemision:=w_mem[1,1]
  xalmacen:=w_mem[2,1]
  xcodven :=w_mem[3,1]
  xcliente:=w_mem[4,1]

  DO WHILE .T.
     SELECT BUFFER
     GO TOP

     IF CONFORME<>'N'
        listaserial({||s_origen=='PVE'.and.s_numero==xnumfac})
     ENDIF

     SETCOLOR(C_TEX2)

     FR_TOTAL()
     SETCOLOR(C_TIT2)

     Set key 287 to serializa
     APL:='REN'
     EDIT_VENTANA('RENFAC')
     APL:='_W'
     PACK

     nTReg:=LastRec()
     IF nTReg>0 .AND. pv_rengpag > 0 .AND. nTReg > pv_rengpag
        MsgLimReng()
        LOOP
     ENDIF
     EXIT
  ENDDO
  SETKEY(-8,NIL)
  set key 287 to

*  if pv_pvp$[NT] .AND.  !DifCero(xtot_fac)
*     Pare('No se permite factura en cero, mientras editar precio esta "T ¢ N"')
*     LOOP
*  endif

  OK=.F.
  SELECT BUFFER
  GO TOP
  IF LASTREC()<>0 .AND. !EOF()
   ENTRO=.T.
   OK:=FUTRAP()
  ENDIF

  SELECT MXENCRAP
  IF ok
   CONFORME=[S]
   EXIT
  ENDIF
 ENDDO

 SETKEY(-8,UKEYF9)
 SETKEY(-7,UKEYF8)

 SELECT MXENCRAP
RETURN

