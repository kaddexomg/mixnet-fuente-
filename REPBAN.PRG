  @ 12,36 SAY II_ORG
  @ 13,36 SAY II_TIPO
  @ 14,36 SAY II_NUMORG
  @ 15,36 SAY II_FORMA
  @ 16,36 SAY SUBSTR(II_NUMPAG,1,15)
  @ 17,36 SAY SUBSTR(II_NOMPAG,1,15)
  @ 18,36 SAY IF(II_IMP1=0,SPACE(16),II_IMP1)
  @ 19,36 SAY IF(II_IMP2=0,SPACE(16),II_IMP2)
  SETCOLOR(C_TIT2)
