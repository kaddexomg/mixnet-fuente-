 IF J>1
  ESCRIBE([TOTAL]+SPACE(59)+TRANS(TOT_DEB,TRAN21)+[ ]+TRANS(TOT_CRE,TRAN21)+[ ]+TRANSFORM(TOT_DEB-TOT_CRE,TRAN21))
