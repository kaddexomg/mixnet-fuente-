  @ 11,36 GET II_CAJA
  @ 12,36 GET II_ORG  PICT [!!!]
  @ 13,36 GET II_TIPO PICT [!!]
  @ 14,36 GET II_NUMORG
  @ 15,36 GET II_FORMA PICT [!!]
  @ 16,36 GET II_NUMPAG PICT "@S12"
  @ 16,36 GET II_NOMPAG PICT "@S12"
  @ 17,36 GET II_IMP1
  @ 18,36 GET II_IMP2 VALID II_IMP2>=II_IMP1.OR.II_IMP2=0
  leer()
ENDIF

I_CRITERIO=IF(EMPTY(II_CAJA),[.T.],[II_CAJA=CODCAJ])+IF(EMPTY(II_ORG),[],[.AND.ALLTRIM(II_ORG)=ORIGEN])+;
           IF(EMPTY(II_TIPO),[],[.AND.ALLTRIM(II_TIPO)$TIPORG])+IF(EMPTY(II_NUMORG),[],[.AND. ALLTRIM(II_NUMORG)$NUMORG])+;
           IF(EMPTY(II_FORMA),[],[.AND.ALLTRIM(II_FORMA)$FORMAPAG])+IF(EMPTY(II_NUMPAG),[],[.AND. ALLTRIM(II_NUMPAG)$NUMPAG])+;
           IF(EMPTY(II_NOMPAG),[],[.AND.ALLTRIM(II_NOMPAG)$NOMPAG])+IF(II_IMP1=0,[],[.AND.IMPORTE>=II_IMP1])+IF(II_IMP2=0,[],[.AND.IMPORTE<=II_IMP2])

SUBTIT2=ALLTRIM(IF(EMPTY(II_CAJA),[],[CAJA=]+II_CAJA))+ALLTRIM(IF(EMPTY(II_ORG),[],[ORIGEN= ]+II_ORG)+IF(EMPTY(II_TIPO),[],[ TIPO= ]+II_TIPO)+;
        IF(EMPTY(II_NUMORG),[],[ No. ORIGEN= ]+II_NUMORG)+IF(EMPTY(II_FORMA),[],[ FORMA DE PAGO= ]+II_FORMA)+;
        IF(EMPTY(II_NUMPAG),[],[ No. DOC. PAGO= ]+TRIM(II_NUMPAG))+IF(EMPTY(II_NOMPAG),[],[ REF. DE PAGO= ]+TRIM(II_NOMPAG))+;
        IF(II_IMP1=0,[],[ IMPORTE>= ]+ALLTRIM(STR(II_IMP1,12,G_REDONDO)))+IF(II_IMP2=0,[],[ IMPORTE)<= ]+ALLTRIM(STR(II_IMP2,12,G_REDONDO))))

*PREPOPC[5]=.F.
SIMPORTE= 0.00
RETURN


