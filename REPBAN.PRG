  II=STRZERO(I,2)
  ESCRIBE(PAD(MESPER(I),10)+[ -> ]+TRANSFORM(BS(DEB&II),TRAN21)+[ ]+TRANSFORM(BS(CRE&II),TRAN21)+[ ]+TRANSFORM(BS(DEB&II)-BS(CRE&II),TRAN21))
  TOT_DEB=TOT_DEB+bs(DEB&II)
  TOT_CRE=TOT_CRE+bs(CRE&II)
