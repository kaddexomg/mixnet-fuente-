 IF II_SALTO
  TITULA(1)
  ? [CODIGO: ]+MXCTABAN->CODBAN
  ? [NOMBRE: ]+MXCTABAN->NOMBRE
  ? [CUENTA: ]+MXCTABAN->CUENTA
  ? [FECHAS: ]+LTRIM(SUBTIT2)
  CONTLIN=CONTLIN+4
 ELSE
  TITULA()
 ENDIF
 ? REPLICATE('Í',I_ANCHO)
 ? [FECHA]+SPACE(6)+[TP NUMERO]+SPACE(3)+[CONCEPTO DEL MOVIMIENTO]+SPACE(29)+[DEBE]+SPACE(13)+[HABER]+SPACE(23)+[SALDO]
 ? REPLICATE('Í',I_ANCHO)
 CONTLIN=CONTLIN+3
 IF CONTINUA .AND. !II_SALTO
  ESCRIBE([CODIGO:]+MXCTABAN->CODBAN+[ NOMBRE:]+MXCTABAN->NOMBRE+[ (... CONTINUACION)])
 ENDIF
ELSE
 TITULA()
 SETCOLOR(C_TIT2)
 MENS=[BANCO: ]+MXCTABAN->CODBAN+[ NOMBRE: ]+ALLTRIM(MXCTABAN->NOMBRE)+[ CUENTA: ]+ALLTRIM(MXCTABAN->CUENTA)
 CENTOR=INT((80-LEN(MENS))/2)
 ? SPACE(CENTOR)+MENS
 ? REPLICATE('Í',79)
 ?[FECHA]+SPACE(6)+[TP NUMERO]+SPACE(3)+[CONCEPTO ]+SPACE(18)+[IMPORTE]+SPACE(10)+[SALDO ACTUAL]
 ? REPLICATE('Í',79)
 CONTLIN=CONTLIN+4
ENDIF
RETURN

FUNCTION NEXTSIN
PRIVATE MI_SEL
MI_SEL=ALIAS()
IF !II_ZERO
 DO WHILE .T.
  SELEC MXTRABAN
  SET SOFT ON
  SEEK(MXCTABAN->CODBAN+TRIM(SUBSTR(DTOS(II_FEC1-1),1,6)))
  SET SOFT OFF
  DO WHILE !EOF() .AND. CODMOVBAN=MXCTABAN->CODBAN .AND. FECHA_MOV<=II_FEC1-1
   SKIP
  ENDDO
  IF !EOF() .AND. CODMOVBAN=MXCTABAN->CODBAN .AND. FECHA_MOV<=II_FEC2
   EXIT
  ELSE
   SELECT MXCTABAN
   IF ABORT()
    BREAK
   ENDIF
   IF I_MANUAL
    CTL_MAN()
   ELSE
    SKIP
    IF EOF()
     BREAK
    ENDIF
   ENDIF
  ENDIF
 ENDDO
ENDIF
SELECT &MI_SEL
RETURN 0

PROCEDURE DBAN0403
PRIVATE XREG
SELECT MXCTABAN
IF EMPTY(II_FEC2)
 II_FEC2=FECMAX
ENDIF
SELECT MXCTABAN
XREG=RECNO()
SELE MXDAABAN
GOTO XREG
*TDEB_ANT  = DEB_ANT(PERIODO(II_FEC1-1))
*TCRE_ANT  = CRE_ANT(PERIODO(II_FEC1-1))
XSALDO=SALDO_ANT(PERIODO(II_FEC1-1))

SELEC MXTRABAN
SET SOFT ON
SEEK(MXCTABAN->CODBAN+TRIM(SUBSTR(DTOS(II_FEC1-1),1,6)))
SET SOFT OFF
DO WHILE !EOF() .AND. CODMOVBAN=MXCTABAN->CODBAN .AND. FECHA_MOV<=II_FEC1-1
  IF TIPBAN<>[AN]
    XSALDO=XSALDO+e_importe(IMPORTE,fecha_mov)
  ENDIF
  SKIP
ENDDO
STORE 0 TO XDEBITOS,XCREDITOS,CREMES,DEBMES

IF IMPRE
 IF !II_SALTO
  ESCRIBE([BANCO:]+MXCTABAN->CODBAN+[   NOMBRE: ]+MXCTABAN->NOMBRE)
  CONTINUA=.T.
 ENDIF
 ESCRIBE(SPACE(71)+[SALDO AL ]+DTOC(II_FEC1-1)+[ -> ]+SPACE(10)+TRANS(XSALDO,TRAN21))
ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(SPACE(34)+[ SALDO AL ]+DTOC(II_FEC1-1)+[ -> ]+TRANS(XSALDO,TRAN21))
 SETCOLOR(C_TEX2)
ENDIF
SELE MXTRABAN
DO WHILE !EOF() .AND. CODMOVBAN=MXCTABAN->CODBAN .AND. FECHA_MOV<=II_FEC2
 MIMES =MONTH(FECHA_MOV)
 XFECHA=DTOC(FECHA_MOV)
 XSALDO=IF(TIPBAN<>[AN],XSALDO+e_importe(IMPORTE,xfecha),XSALDO)
 IF !IMPRE
  ESCRIBE(XFECHA+[ ]+TIPBAN+[ ]+NUMDOC+[ ]+SUBSTR(CONCEPTO,1,12)+[ ]+TRANS(e_importe(IMPORTE,xfecha),TRAN21)+SPACE(1)+TRANS(XSALDO,TRAN21))
 ELSE
  ESCRIBE(XFECHA+[ ]+TIPBAN+[ ]+NUMDOC+[ ]+CONCEPTO+[ ]+IF(IMPORTE>0,TRANS(e_importe(IMPORTE,xfecha),TRAN21)+SPACE(23),SPACE(23)+TRANS(e_importe(-IMPORTE,xfecha),TRAN21))+[  ]+TRANS(XSALDO,TRAN21))
 ENDIF

 IF TIPBAN<>[AN]
  IF IMPORTE>0
   XDEBITOS=XDEBITOS+e_importe(IMPORTE,fecha_mov)
   DEBMES=DEBMES+e_importe(IMPORTE,fecha_mov)
  ELSE
   XCREDITOS=XCREDITOS-e_importe(IMPORTE,fecha_mov)
   CREMES=CREMES-e_importe(IMPORTE,fecha_mov)
  ENDIF
 ENDIF
 SKIP
 IF DIFCERO(XDEBITOS) .OR. DIFCERO(XCREDITOS)
  IF IMPRE
   IF MIMES<>MONTH(FECHA_MOV) .OR. EOF()
    ESCRIBE(SPACE(36)+REPL('Ä',89))
    ESCRIBE(SPACE(33)+[   TOTAL ]+UPPER(PAD(G_MESES[MIMES],12))+[ -> ]+TRANS(DEBMES,TRAN21)+[  ]+TRANS(CREMES,TRAN21)+[  ]+TRANS(XSALDO,TRAN21))
    ESCRIBE(SPACE(36)+REPL('Ä',89))
    ESCRIBE([])
    STORE 0 TO DEBMES,CREMES
   ENDIF
  ELSE
   IF MIMES<>MONTH(FECHA_MOV) .AND. !EOF() .AND. FECHA_MOV<=II_FEC2
    ESCRIBE([])
   ENDIF
  ENDIF
 ENDIF
ENDDO
IF IMPRE
 ESCRIBE(REPL(IF(II_SALTO,'Í','Ä'),I_ANCHO))
 ESCRIBE(MXCTABAN->NOMBRE+[   TOTAL AL ]+DTOC(II_FEC2)+[ ->   ]+TRANS(XDEBITOS,TRAN21)+[  ]+TRANS(XCREDITOS,TRAN21)+[  ]+TRANS(XSALDO,TRAN21))
 ESCRIBE(REPL(IF(II_SALTO,'Í','Ä'),I_ANCHO))
 IF !II_SALTO
  CONTINUA=.F.
  ESCRIBE([])
 ENDIF
ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(SPACE(34)+[ SALDO AL ]+DTOC(II_FEC2)+[ -> ]+TRANS(XSALDO,TRAN21))
 SETCOLOR(C_TEX2)
ENDIF
IF II_SALTO .OR. !IMPRE
 CONTLIN=MAXLIN+1
 PAG=0
ENDIF
SELECT MXCTABAN
IF !I_MANUAL
 SKIP
ELSE
 CTL_MAN()
ENDIF
NEXTSIN()
RETURN

