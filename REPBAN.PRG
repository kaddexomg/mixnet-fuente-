PROCEDURE CBAN0402
PARAMETER PASAPASA
I_BOTCRI=19
SETCOLOR(C_TEX2)
@ 11,16 SAY SPACE(9)+[Tipo: ]
@ 12,16 SAY [ Documentos >= ]
@ 13,16 SAY [ Documentos <= ]
@ 14,16 SAY [     Concepto: ]
@ 15,16 SAY [    Importe >= ]
@ 16,16 SAY [    Importe <= ]
@ 17,16 SAY [       Origen: ]
@ 18,16 SAY [        Banco: ]
IF PCOUNT()=1
  SETCOLOR(C_TIT2)
  @ 11,31 SAY  II_TIPO
  @ 12,31 SAY  II_NUM1
  @ 13,31 SAY  II_NUM2
  @ 14,31 SAY  SUBSTR(II_CON,1,18)
  @ 15,31 SAY  IF(II_IMP1=0,SPACE(18),TRANS(II_IMP1,PIC12))
  @ 16,31 SAY  IF(II_IMP2=0,SPACE(18),TRANS(II_IMP2,PIC12))
  @ 17,31 SAY  II_ORIGEN
  @ 18,31 SAY  II_codban
ELSE
   @ 11,31 GET II_TIPO PICT [!!]
   @ 12,31 GET II_NUM1
   @ 13,31 GET II_NUM2
   @ 14,31 GET II_CON PICT [@S18]
   @ 15,31 GET II_IMP1 PICT PIC12
   @ 16,31 GET II_IMP2 PICT PIC12
   @ 17,31 GET II_ORIGEN PICT [@!]
   @ 18,31 GET II_CODBAN PICT [@!]
   LEER()
ENDIF
I_CRITERIO=IF(EMPTY(II_TIPO),[.T.],[ALLTRIM(II_TIPO)$TIPBAN])+IF(EMPTY(II_NUM1),[],[.AND.NUMDOC>=II_NUM1])+;
           IF(EMPTY(II_NUM2),[],[.AND.NUMDOC<=II_NUM2])+IF(EMPTY(II_CON),[],[.AND.UPPER(ALLTRIM(II_CON))$UPPER(CONCEPTO)])+;
           IF(II_IMP1=0,[],[.AND.abs(IMPORTE)>=II_IMP1])+IF(II_IMP2=0,[],[.AND.ABS(IMPORTE)<=II_IMP2])+;
           IF(EMPTY(II_ORIGEN),[],[.AND. ORIGEN=II_ORIGEN])+;
           IF(EMPTY(II_CODBAN),[],[.AND. CODMOVBAN=II_CODBAN])

SUBTIT3=IF(EMPTY(II_TIPO),[],[TIPO=]+II_TIPO)+IF(EMPTY(II_NUM1),[],[ NUMERO>=]+II_NUM1)+;
        IF(EMPTY(II_NUM2),[],[ NUMERO<=]+II_NUM2)+IF(EMPTY(II_CON),[],[ CONCEPTO=]+ALLTRIM(II_CON))+;
        IF(II_IMP1=0,[],[ IMPORTE>=]+LTRIM(STR(II_IMP1,12,G_REDONDO)))+IF(II_IMP2=0,[],[ IMPORTE<=]+LTRIM(STR(II_IMP2,12,G_REDONDO)))+;
        IF(EMPTY(II_ORIGEN),[],[ORIGEN: ]+II_ORIGEN)+;
        IF(EMPTY(II_CODBAN),[],[BANCO: ]+II_CODBAN)
TIMPORTE=0.00
RETURN

