PROCEDURE BUSFOR
* BUSQUEDA EN ABREVIATURA
PRIVATE TCODFOR,TNOMFOR
VERTBUS([BFORFUN])
RETURN

PROCEDURE BFORFUN
PRIVATE UCOLOR
* BUSQUEDA
@ CONTLIN, 2+MARGEN GET BCODFOR PICT '@!'
@ CONTLIN,14+MARGEN GET BNOMFOR
LEER()
SALIR=ESCAPAR() .OR. ( EMPTY(BCODFOR) .AND. EMPTY(BNOMFOR) )
IF !SALIR
 IF !EMPTY(BCODFOR)
  TCODFOR=UPPER(TRIM(BCODFOR))
  YKEY=TCODFOR
 ELSE
  TNOMFOR=UPPER(TRIM(BNOMFOR))
  BCONDICION=[TNOMFOR$NOMFOR]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN

FUNCTION CHFOR
PARAMETER EL_VEN, fil,col
PRIVATE USEL,DEVO

DEVO=.T.

IF LASTKEY()=5
 RETURN .T.
ENDIF

IF !EMPTY(EL_VEN)
 USEL =SELECT()
 IF ABRIR([MXFORMAS],MXFORMAS,[S],MXFOMAX1)
  SELECT MXFORMAS
  SEEK(EL_VEN)
  IF !FOUND()
   FOR0000()
   DEVO=.F.
  ELSE
   IF TYPE('FIL')='N'
    @ fil,col SAY NOMCOD(EL_VEN,[MXFORMAS],[NOMFOR])
   ENDIF
  ENDIF
  CERRAR('MXFORMAS')
 ENDIF
 SELE (USEL)
ENDIF
RETURN DEVO

STATIC FUNC MK_NOMFOR
LOCAL XNAME
IF XDOC='FC'
 XNAME:='FACTURA A '+ALLTRIM(STR(XPERIODO,3))+' DIAS'
ELSE
 IF XDOC='GR'
  XNAME:=ALLTRIM(STR(XNUMGIR,3))+' GIRO'+IF(XNUMGIR>1,'S','')+' A '+ALLTRIM(STR(XPERIODO,3))+' DIAS '+IF(XPOR_INT>0,ALLTRIM(STR(XPOR_INT,5,2))+'% DE INTERES' , '')
 ENDIF
ENDIF
RETURN XNAME


