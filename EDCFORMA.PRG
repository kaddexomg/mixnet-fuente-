PROCEDURE FOR0000
PARAMETERS P1,P2,P3

PRIVATE ULT_ALIAS
DECLARE RCAMPO[ 2],RSUBTIT[ 2]
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)

PRIVATE XCODFOR,XNOMFOR,BCODFOR,BNOMFOR,UROW,UCOL,UCOLOR
PRIVATE XDOC,XPERIODO,XNUMGIR,XPOR_INT, XLIMITE
UCOLOR = SETCOLOR()
UROW   = ROW()
UCOL   = COL()
BCODFOR=SPACE(3)
BNOMFOR=SPACE(35)
DO CAMFOR
DO SUBFOR
ULT_ALIAS=ALIAS()
IF ABRIR([MXFORMAS],MXFORMAS,[S],MXFOMAX1)
 EDC([FOR],[ TIPOS DE CREDITO ],RSUBTIT,RCAMPO,.T.,.T.,.T.,.T.,.F.,.F.,.F.,.F.)
 CERRAR('MXFORMAS')
ENDIF
RESEL()
SETCOLOR(UCOLOR)
@ UROW,UCOL SAY []
RETURN


PROCEDURE SUBFOR
RSUBTIT[ 1]=[C¢digo]
RSUBTIT[ 2]=PAD([Nombre],35)
RETURN

PROCEDURE CAMFOR
RCAMPO[ 1]=[CODFOR]
RCAMPO[ 2]=[NOMFOR]
RETURN

PROCEDURE DEFFOR
* VALORES POR DEFECTO
GO BOTTOM
XCODFOR     = IF(EOF(),'01',PROX_SIMB(CODFOR))
XNOMFOR     = SPACE( 35)
XDOC        = 'FC'
XPERIODO    = 30
XNUMGIR     = 1
XPOR_INT    = 0
XLIMITE = 0
RETURN

PROCEDURE ASGFOR
* ASIGNACION DE REGISTRO A MEMORIA
XCODFOR     = CODFOR
XNOMFOR     = NOMFOR
XDOC        = DOC
XPERIODO    = PERIODO
XNUMGIR     = NUMGIR
XPOR_INT    = POR_INT
XLIMITE     = LIMITE
RETURN

PROCEDURE RPLFOR
* REEMPLAZO EN EL REGISTRO
AUDITORIA([Acceso a mantenimiento de formas de creditos],xcodfor,codfor,IF(MODIFICA,[MOD],[INC]))
REPLACE CODFOR WITH XCODFOR,NOMFOR WITH XNOMFOR, DOC WITH XDOC, PERIODO WITH XPERIODO,;
        NUMGIR WITH XNUMGIR, POR_INT WITH XPOR_INT, LIMITE WITH XLIMITE
RETURN

PROCEDURE MASFOR
LINSIM()
RETURN

PROCEDURE GETFOR
LOCAL FSCR:=SAVESCREEN(8,8,17,40),UCOL:=SETCOLOR()
SETCOLOR(C_TEX2)
BOXSOM('FORMA DE PAGO',8,8,15,38,2)
@  9, 10 SAY 'C¢digo.........:' GET XCODFOR PICT '@!' VALID CHK_CLAVE(XCODFOR,[CODIGO])
@ 10, 10 SAY 'Documento......:' GET XDOC PICT '!!' VALID CHELDOC(XDOC)
@ 11, 10 SAY 'Per¡odo (dias).:' GET XPERIODO  PICT '999'
@ 12, 10 SAY 'N£mero de giros:' GET XNUMGIR  WHEN XDOC='GR' PICT '99'
@ 13, 10 SAY 'Interes (%)....:' GET XPOR_INT WHEN XDOC='GR' PICT '99.99'
@ 14, 10 SAY 'L¡mite.........:' GET XLIMITE PICT '99999999'
READ
XNOMFOR=MK_NOMFOR()
RESTSCREEN(8,8,17,40,FSCR)
SETCOLOR(UCOL)
SALIR=ESCAPAR()
RETURN


STATIC FUNCTION CHELDOC(TU_TIPO)
IF LASTKEY()=5
 RETURN .T.
ENDIF
IF TU_TIPO$'FC,GR'
 RETURN .T.
ENDIF
PARE([INFORMACION VALIDA: FC=FACTURA, GR=GIRO])
RETURN .F.


