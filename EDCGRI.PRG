* GRUPOS DE ARTICULOS

PROCEDURE INV0302
INIT_VER()
DO GRI0000
RETURN

PROCEDURE GRI0000
PARAMETERS P1,P2,P3
PRIVATE ULT_ALIAS
DECLARE RCAMPO[ 7],RSUBTIT[ 7]
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)

PRIVATE XGRUART,XNOMGRUART
PRIVATE XMARGEN_A,XMARGEN_B,XMARGEN_C,XMARGEN_D,XCOMISION
PRIVATE BGRUART,BNOMGRUART

BGRUART=SPACE(5)
BNOMGRUART=SPACE(35)
XMARGEN_A:=0.0000
XMARGEN_B:=0.0000
XMARGEN_C:=0.0000
XMARGEN_D:=0.0000
XCOMISION:=0.00
DO CAMGRI
DO SUBGRI
ULT_ALIAS=ALIAS()

IF ABRIR([MXGRUINV],MXGRUINV,[S],MXGRINX1)
 t1:=subopcion
 t2:=gestion
 subopcion:=2
 gestion:='INV'
 DO EDC WITH [GRI],[ GRUPOS DE ARTICULOS ],RSUBTIT,RCAMPO,.T.,.T.,.T.,.T.,.F.,.F.,.F.,.F.
 subopcion:=t1
 gestion:=t2
 CERRAR('MXGRUINV')
ENDIF
DO RESEL
RETURN


PROCEDURE SUBGRI
RSUBTIT[ 1]=[Grupo]
RSUBTIT[ 2]=[Nombre]+SPACE(24)
RSUBTIT[ 3]=[Marg.A]
RSUBTIT[ 4]=[Marg.B]
RSUBTIT[ 5]=[Marg.C]
RSUBTIT[ 6]=[Marg.D]
RSUBTIT[ 7]=[%Comis]
RETURN

PROCEDURE CAMGRI
RCAMPO[ 1]=[GRUART]
RCAMPO[ 2]=[NOMGRUART]
RCAMPO[ 3]=[MARGEN_A]
RCAMPO[ 4]=[MARGEN_B]
RCAMPO[ 5]=[MARGEN_C]
RCAMPO[ 6]=[MARGEN_D]
RCAMPO[ 7]=[COMISION]

RETURN

PROCEDURE DEFGRI
* VALORES POR DEFECTO
XGRUART    = SPACE(  5)
XNOMGRUART = SPACE( 35)
XMARGEN_A  = 0.000
XMARGEN_B  = 0.000
XMARGEN_C  = 0.000
XMARGEN_D  = 0.000
XCOMISION  = 0.00
RETURN

PROCEDURE ASGGRI
* ASIGNACION DE REGISTRO A MEMORIA
XGRUART    = GRUART
XNOMGRUART = NOMGRUART
XMARGEN_A  = MARGEN_A
XMARGEN_B  = MARGEN_B
XMARGEN_C  = MARGEN_C
XMARGEN_D  = MARGEN_D
XCOMISION  = COMISION
RETURN

PROCEDURE RPLGRI
* REEMPLAZO EN EL REGISTRO
AUDITORIA([Acceso a mantenimiento de grupo de art¡culos],xgruart,gruart,IF(MODIFICA,[MOD],[INC]))
REPLACE GRUART     WITH XGRUART
REPLACE NOMGRUART  WITH XNOMGRUART
REPLACE MARGEN_A   WITH XMARGEN_A
REPLACE MARGEN_B   WITH XMARGEN_B
REPLACE MARGEN_C   WITH XMARGEN_C
REPLACE MARGEN_D   WITH XMARGEN_D
REPLACE COMISION   WITH XCOMISION
RETURN

PROCEDURE MASGRI
* MASCARA DE LA VENTANA
LINSIM()
RETURN

PROCEDURE GETGRI
* CAPTURA REGISTRO
@ CONTLIN, 2+MARGEN GET XGRUART  PICT [@!] VALID CHK_CLAVE(XGRUART,[Grupo])
@ CONTLIN, 8+MARGEN GET XNOMGRUART  PICT '@S30'
@ CONTLIN,39+MARGEN GET xmargen_a Pict '99.999'
@ CONTLIN,46+MARGEN GET xmargen_b Pict '99.999'
@ CONTLIN,53+MARGEN GET xmargen_c Pict '99.999'
@ CONTLIN,60+MARGEN GET xmargen_d Pict '99.999'
@ CONTLIN,67+MARGEN GET xcomision Pict '999.99'

READ
SALIR=ESCAPAR()
RETURN

PROCEDURE DETGRI
* DETALLE
@ CONTLIN, 2+MARGEN SAY GRUART
@ CONTLIN, 8+MARGEN SAY PAD(NOMGRUART,30)
@ CONTLIN,39+MARGEN SAY margen_a Pict '99.999'
@ CONTLIN,46+MARGEN SAY margen_b Pict '99.999'
@ CONTLIN,53+MARGEN SAY margen_c Pict '99.999'
@ CONTLIN,60+MARGEN SAY margen_d Pict '99.999'
@ CONTLIN,67+MARGEN SAY comision Pict '999.99'

RETURN


PROCEDURE GETBGRI
* CAPTURA DE CAMPOS EN MODO BROWSE
DO CASE
 CASE ICAMPO=1
  @ ROW(),COL() GET XGRUART  PICT [@!] VALID CHK_CLAVE(XGRUART,[Grupo])
 CASE ICAMPO=2
  @ ROW(),COL() GET XNOMGRUART
 CASE ICAMPO=3
  @ ROW(),COL() GET XMARGEN_A
 CASE ICAMPO=4
  @ ROW(),COL() GET XMARGEN_B
 CASE ICAMPO=5
  @ ROW(),COL() GET XMARGEN_C
 CASE ICAMPO=6
  @ ROW(),COL() GET XMARGEN_D
 CASE ICAMPO=7
  @ ROW(),COL() GET XCOMISION
ENDCASE
READ
SALIR:=ESCAPAR()
RETURN

PROCEDURE ELIGRI
* ELIMINACION DE REGISTRO
AUDITORIA([Acceso a mantenimiento de grupo de art¡culos],gruart,,[ELI])
DELETE
RETURN

PROCEDURE CRDGRI
* COORDENADAS DE LA VENTANA
TOPE= 7
FONDO=17
COLIZQ= 3
COLDER=75
RETURN

PROCEDURE BUSGRI
PRIVATE TGRUART,TNOMGRUART
VERTBUS([BGRIFUN])
RETURN

PROCEDURE BGRIFUN
* BUSQUEDA
@  CONTLIN,2+MARGEN GET BGRUART
@  CONTLIN,8+MARGEN GET BNOMGRUART PICT '@S30'
LEER()
SALIR=ESCAPAR() .OR. ( EMPTY(BGRUART) .AND. EMPTY(BNOMGRUART) )

IF !SALIR
 IF !EMPTY(BGRUART)
  TGRUART=TRIM(BGRUART)
  YKEY=TGRUART
 ELSE
  TNOMGRUART=TRIM(BNOMGRUART)
  BCONDICION=[TNOMGRUART$NOMGRUART]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN

PROCEDURE SELGRI
DO COPIP
RETURN



