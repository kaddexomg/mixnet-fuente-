** ocai retencion municipal 6/2/19
proc crermun    && calcula y crea renglon de retencion municipal
local xtot,_seq:='00000000'
local esdevo:=(buffer->costo_tot<0.or.xtot_com<0)

if !file(ce('mxnumrmu.dbf'))
 _fil:=alias()
 _ori:=ce('mxnumfac.dbf')
 _des:=ce('mxnumrmu.dbf')
 copy file &_ori to &_des
 if abrir('numrmu',ce('mxnumrmu.dbf'),'E')
  zap
  append blank
  repl numero with '00000001'
  cerrar('numrmu')
 endif
endif

if empty(buffer->numord)
 if file(ce('mxnumrmu.dbf'))
  _sec:=proxinum(ce('mxnumrmu.dbf'))
 endif
else
 _sec:=buffer->numord
endif

xtot:=abs(round(buffer->costo_tot,2))

if abs(round(buffer->costo_tot,2))#abs(round(xtot_com,2))
 if decis('Retencion sobre Total Compra ? ',0)="S"
* xtot:=abs(round(xtot_com,2))
  select buffer
  elreg:=recno()
  sum costo_tot to xtot for left(item,6)#'(RIM)-'
  sum costo     to xcos for left(item,6)='(RIM)-'
  xtot:=xtot-xcos
  xtot:=abs(round(xtot,2))
  goto elreg
 endif
endif

if abs(round(xtot*mxretmun->tarifa/100,2))>0
 select buffer
 inserta()
 buffer->item     :='(RIM)-'+mxretmun->codret
 buffer->descrip  :=PAD(mxretmun->concepto,50)
 buffer->costo_tot:=-(round(xtot*mxretmun->tarifa/100,2))
 buffer->costo    :=round(xtot,2)
 buffer->codcon   :=mxretmun->codcon
 buffer->desc     :=mxretmun->tarifa
 buffer->numord   :=_sec
 if esdevo
   buffer->costo_tot:=-buffer->costo_tot
 endif
else
 pare('Monto Insuficiente para Retencion')
endif
