STATIC PROCEDURE INSERTA
local TEMPFILE:=G_CAMINO+[ITEMP]+estacion+[.DBF]
local ureg:=recno()
IF ureg<lastrec()
  dbskip()
  ureg:=recno()
  COPY TO (TEMPFILE) REST
  GOTO UREG
  DELETE REST
  PACK
  add_rec(0)
  ureg:=recno()
  APPEND FROM (TEMPFILE)
  DELETE FILE (TEMPFILE)
  goto ureg
else
 add_rec(0)
endif
RETURN

Function ActualPvp()
 local cSel:=Select(),cFile:=g_camino+'PRECIO'+ESTACION+'.DBF'
 DbSelectar('mxrencpa')
 IF dbseek(xprovee+xnumcom)
    COPY TO (cFILE) WHILE NUMCOM=xnumcom .AND. provee=xprovee
 ENDIF
 IF !FILE(cFile)
    PARE('NO SE PUDO GENERAR EL ARCHIVO TEMPORAL PARA CAMBIO DE PRECIOS')
 ELSE
    IF abrir('PRECIOS',cFile,'E')
       edit_ventana('CPRECIOS')
       CERRAR('PRECIOS')
    ENDIF
 ENDIF
 DbSelectar(cSel)
Return nil

Function AnalizarPvp()
 Local cSel:=Select(),cCod:=item,aPorc:={},aPvpN:={},nUltC,nCosP,nCosto,cScr,;
       nLin:=5,nCol:=5,cTR:='P',cColAnt:=SetColor(),xLin,nCursor:=SetCursor(),;
       cTC:='P',xxlin
 Private aPvp:={}
 DbSelectar('MXCTAINV')
 if !Dbseek(cCod)
    pare('C¢digo no fue encontrado en el maestro de Art¡culos')
    DbSelectar(cSel)
    Return nil
 endif
 aadd(aPvp,precio_a)
 aadd(aPvp,precio_b)
 aadd(aPvp,precio_c)
 aadd(aPvp,precio_d)
 aadd(aPvpN,precio_a)
 aadd(aPvpN,precio_b)
 aadd(aPvpN,precio_c)
 aadd(aPvpN,precio_d)
 aadd(aPorc,0.00)
 aadd(aPorc,0.00)
 aadd(aPorc,0.00)
 aadd(aPorc,0.00)

 nUltC:=ult_costo
 nCosP:=costo_act
 nCosto:=0
 cScr:=savescreen(0,0,24,80)
 BOXSOM([ ANALISIS DE CAMBIO DE PRECIO ],nLin,nCol-1,nLin+13,nCol+65,2)
 setcolor(c_tex2)
 xLin:=nLin
 @ ++nLin,nCol SAY 'C¢digo........:'
 @ ++nLin,nCol SAY 'Nombre........:'
 @ ++nLin,nCol SAY 'Costo Promedio:'
 @ ++nLin,nCol SAY 'Ultimo costo..:'
 @ ++nLin,nCol SAY 'USAR TIPO DE COSTO (P=Promedio,U=Ultimo):'
 xxLin:=nLin
 nLin:=nLin+1
 @ ++nLin,nCol SAY 'TIPO DE PRECIO      PRECIO ACTUAL    %     PRECIO NUEVO' COLOR c_tit2
 @ ++nLin,nCol SAY '-------------------------------------------------------'
 @ ++nLin,nCol SAY 'Precio A......:'
 @ ++nLin,nCol SAY 'Precio B......:'
 @ ++nLin,nCol SAY 'Precio C......:'
 @ ++nLin,nCol SAY 'Precio D......:'
 nLin:=xLin
 SETCOLOR(c_tit2)
 @ ++nLin,nCol+16 SAY CODART
 @ ++nLin,nCol+16 SAY pad(NOMART,40)
 @ ++nLin,nCol+16 SAY costo_act
 @ ++nLin,nCol+16 SAY ult_costo
 nLin:=nLin+4
 xLin:=nLin
 @ ++nLin,nCol+16 SAY TRANS(aPvp[1],lati17)
 @ ++nLin,nCol+16 SAY TRANS(aPvp[2],lati17)
 @ ++nLin,nCol+16 SAY TRANS(aPvp[3],lati17)
 @ ++nLin,nCol+16 SAY TRANS(aPvp[4],lati17)
 nlin:=xLin
 DO WHILE .T.
    nlin:=xLin
    SetCursor(1)
    @ xxLin,nCol+42 GET cTC PICT '!' valid 123->(nCosto:=if(cTC$'P',nCosP,nUltC),cTC$'PU')
    @ ++nLin,nCol+34 GET aPorc[1] PICT '9.999' VALID recalpvp(aPorc[1],nCosto,1,xLin+1,nCol+42)
    @ ++nLin,nCol+34 GET aPorc[2] PICT '9.999' VALID recalpvp(aPorc[2],nCosto,2,xLin+2,nCol+42)
    @ ++nLin,nCol+34 GET aPorc[3] PICT '9.999' VALID recalpvp(aPorc[3],nCosto,3,xLin+3,nCol+42)
    @ ++nLin,nCol+34 GET aPorc[4] PICT '9.999' VALID recalpvp(aPorc[4],nCosto,4,xLin+4,nCol+42)
    nLin:=xLin
    @ ++nLin,nCol+42 GET aPvp[1] PICT '999999999.999'
    @ ++nLin,nCol+42 GET aPvp[2] PICT '999999999.999'
    @ ++nLin,nCol+42 GET aPvp[3] PICT '999999999.999'
    @ ++nLin,nCol+42 GET aPvp[4] PICT '999999999.999'
    READ
    if lastkey()=27
      if decis('¨ Desea cancelar el proceso ?',1)='S'
         EXIT
      else
         LOOP
      endif
    endif
    IF decis('¨ Desea hacer definitivos los ajustes realizados ?',1)='S'
       IF rlock()
          REPLACE PRECIO_A WITH APVP[1]
          REPLACE PRECIO_B WITH APVP[2]
          REPLACE PRECIO_C WITH APVP[3]
          REPLACE PRECIO_D WITH APVP[4]
          UNLOCK
       ENDIF
    ENDIF
    EXIT
 ENDDO
 RestScreen(0,0,24,80,cScr)
 Setcursor(nCursor)
 dbselectar(cSel)
 SetColor(cColAnt)
Return nil

Static Function RecalPvp(nPorc,nCosto,nElem,nLin,nCol)
 IF nPorc>0
    aPvp[nElem] := nCosto*nPorc
 ENDIF
 @ nLin,nCol SAY aPvp[nElem] PICT '999999999.999'  color c_inv2
Return(.T.)

