FUNCTION AFECCOM
PRIVATE XCODMOVART,XITEM,XCOSTO_TOT,XORIGEN,XTIPINV,UENC,UREN
IF DIFCERO(XCARGO).AND.!DIFCERO(XTOT_NET)
 IF DECIS('¨ Desea afectar los costos de los art¡culos de otra compra ?')='S'
   SELECT MXRENCPA
   UREN=RECNO()
   SELECT MXENCCPA
   UENC=RECNO()

  DO WHILE .T.
   CSCR=SAVESCREEN(9,9,13,55)
   BOXSOM([], 9,9,12,54,2)
   @ 10,12 SAY [ C¢digo del proveedor:] GET xotro_pro PICT [@!] VALID !EMPTY(xotro_pro)
   @ 11,12 SAY [ N£mero de compra    :] GET xotra_cpa PICT [@!] VALID !EMPTY(xotra_cpa)
   LEER()
   RESTSCREEN(9,9,12,55,CSCR)

   IF !EMPTY(xotro_pro).AND.!EMPTY(xotra_cpa).AND.!ESCAPAR()
    SELECT MXENCCPA
    SEEK(xotro_pro+xotra_cpa)
    IF !FOUND()
     PARE('COMPRA NO REGISTRADA')
     LOOP
    ELSE
     XTOTI=TOT_NET
     SELECT MXRENCPA
     SEEK(xotro_pro+xotra_cpa)
     IF FOUND()
      DO MENSAJ WITH 'Generando AJUSTES en inventario ...'
      IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
       IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX1,MXTRINX2,MXTRINX3)
        SELECT MXRENCPA
        DO WHILE PROVEE+NUMCOM=xotro_pro+xotra_cpa .AND. !EOF()
         XCODMOVART = ITEM
         select MXCTAINV
         seek(xcodmovart)
         if found()
          SELECT MXRENCPA
         ****************
          XNUMDOC    = XNUMCOM
          XFECHA_MOV = EMISION
          XTIPINV    = 'AC'
          XORIGEN    = 'CPA'
          XUNIDAD=[]
          XCANTIDAD=0
          XCOSTO_TOT= (XCARGO-XDESCUENTO)*COSTO_TOT/XTOTI
         ****************
          SELECT MXTRAINV
          ADD_REC(0)
          ARC_INV()
         endif
         SELECT MXRENCPA
         SKIP
        ENDDO
        CERRAR('MXTRAINV')
       ENDIF
       CERRAR('MXEXTINV')
      ENDIF
     ENDIF
    ENDIF
   ENDIF
   EXIT
  ENDDO
  SELECT MXRENCPA
  GOTO UREN
  SELECT MXENCCPA
  GOTO UENC
 ENDIF
ENDIF
RETURN 0

