PROCEDURE GETBRCM
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC,CHKU,ES_D,YFACTOR
YFACTOR=1
FFF=ROW()
CCC=COL()
ES_D:=XITEM="*D"
CHKU:=.F.
DO CASE
CASE ICAMPO=1
@ FFF,CCC GET XITEM WHEN (!VIENE_REQ.AND.!VIENE_ORD.AND.!ES_D) PICT ITEM_MASK VALID CHKCTEM()
CASE ICAMPO=2
 @ FFF,CCC GET XUNIDAD  WHEN W1() PICT [!!!] VALID SEL_UNI(UNIREF,@XUNIDAD,CHKU)
CASE ICAMPO=3
 @ FFF,CCC GET XIVA WHEN W1()      PICT '!' VALID XIVA$[ABCDDEFGHIJKLMNOPQRSTUVWXYZ ]
CASE ICAMPO=4
 @ FFF,CCC GET XBULTO   WHEN W1()    PICT "99999" VALID XBULTO>0
CASE ICAMPO=5
 @ FFF,CCC GET XCANTIDAD WHEN W1()  PICT "999999.999" VALID  VALCANCOM(XCANTIDAD)
CASE ICAMPO=6
 @ FFF,CCC GET XCOSTO    WHEN W1() PICT cMascaraCosto VALID ABS(XCOSTO*XCANTIDAD*YFACTOR)<VAL(cMascaraCosto)
CASE ICAMPO=7
 @ FFF,CCC GET XDESC      PICT "999.99"  VALID XDESC>=0 .AND. XDESC<=100.00
CASE ICAMPO=9
 @ FFF,CCC GET XDESCRIP PICT '@S35' WHEN !VIENE_REQ
OTHERWISE
 SALIR=.T.
 RETURN
ENDCASE
READ
SALIR:=ESCAPAR()
FUTREN()
RETURN

