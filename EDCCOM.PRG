Function AbrirCompras()
   Local lAbrir:=.f.
   IF ABRIR([MXENCCPA],MXENCCPA,[S],MXENCPX1,MXENCPX2,MXENCPX3)
      DBSETORDER(3)
      IF ABRIR([MXRENCPA],MXRENCPA,[S],MXRECPX1,MXRECPX2,MXRECPX3)
         DBSETORDER(3)
         IF ABRIR([MXCTAPRO],MXCTACLI,[S],MXCTCLX1,MXCTCLX2)
            if(!es_cob,filtrarpro(),'')
            IF ABRIR([MXCTAINV],MXCTAINV,[S],MXCTINX1)
               IF(inv_filpr='S'.OR.inv_prdes='S',FiltrarInv(),'')
               SELECT MXENCCPA
               DBSETORDER(3)
               DBGOBOTTOM()
               lAbrir:=.t.
            ENDIF
         ENDIF
      ENDIF
   ENDIF
RETURN(lAbrir)




























