    XDESCUENTO=ROUND( -XTOT_NET*(XDESC/100.00),G_REDONDO )
   ENDIF
   XDCTO      := XDESC
   XCOSTO_TOT := XDESCUENTO
   STORE 0 TO XBULTO,XCANTIDAD,XCOSTO
   XIVA=' '
   XUNIDAD='   '
  ELSE
   IF CHKU
    XUNIDAD   = UNIREF
    XCANTIDAD = XCANTIDAD*YFACTOR
   ENDIF

   IF !DIFCERO(XCOSTO)
    XCOSTO=DIV(XCOSTO_TOT,CAMBUL(XCANTIDAD,XBULTO)*(1-(XDESC/100)))
*    XCOSTO=DIV(XCOSTO_TOT,CAMBUL(XCANTIDAD,XBULTO)*(1-(XDESC/100)),G_REDONDO)
   ELSE
    XCOSTO_TOT:=0
   endif
   XCOSTO:=CAMBIO_IMPORTE(XCOSTO,Xemision)

   if !difcero(xcosto_tot)
    XCOSTO_TOT=CAMBUL(XCANTIDAD,XBULTO)*XCOSTO*(1-(XDESC/100))
*    XCOSTO_TOT=ROUND( CAMBUL(XCANTIDAD,XBULTO)*XCOSTO*(1-(XDESC/100)),G_REDONDO)
   ENDIF

  ENDIF
 ENDIF
ENDIF
RETURN


