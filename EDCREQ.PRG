PROCEDURE GETREQ
* CAPTURA REGISTRO
private ed_renglon:=.F. ,XDESPACHO:=0
SET KEY 279 TO
if modifica
 if ustr_edoalm='N' .and. almacen<>ustr_almuser
    SET CURSOR OFF
    Pare(men10)
    salir:=.t.
    SET KEY 279 TO REIMPRIM
    RETURN .f.
 endif
endif

SET KEY -7 TO

WHILE .T.
 KEYBOARD SALIDA+SALIDA
 @  3,15 GET XNUMREQ  PICT [@!] VALID CHK_CLAVE(XNUMREQ,[RECEPCION])
 @  3,32 GET XEMISION VALID CHKEJER(XEMISION)  .AND. !CHK_BLOCK(XEMISION)
 @  3,74 SAY Xestatus
 @  4,15 GET XPROVEE VALID CHPROORD(XPROVEE,@XNUMREQ,'MXENCREQ')
 @  4,74 GET XALMACEN when g_multi .and. ustr_edalm='S' pict '!!' VALID CHALM(XALMACEN) .and. Chk_baf(xalmacen,xemision)
 @  5,15 GET XCOMEN1
 @  6,15 GET XCOMEN2
 LEER()
 IF ESCAPAR()
  IF ENTRO
   BELL()
   IF DECIS([¨ Desea cancelar la operaci¢n ?],1)=[S]
    SALIR=.T.
   ELSE
    LOOP
   ENDIF
  ELSE
   SALIR=.T.
  ENDIF
 ENDIF

 IF SALIR
  //CANCNUM(MXNUMREQ,XNUMREQ)
  CANCNUM(CFILNUM,XNUMREQ)
  DELETE FILE (BUFFER)
  DUPLI_DOC:=.F.
  SET KEY -7 TO DUP_REQ
  SET KEY 279 TO REIMPRIM
  RETURN
 ENDIF

 IF EMPTY(XPROVEE)
  KEYBOARD REPLICATE(SALIDA,2)
  LOOP
 ENDIF

 WHILE G_MULTI .AND. EMPTY(XALMACEN)
  @  4,74 GET XALMACEN pict '!!' when ustr_edalm='S' VALID CHALM(XALMACEN) .and. Chk_baf(xalmacen,xemision)
  LEER()
 END

 ENTRO=.T.

 IF ABRIR([MXCTASER],MXCTASER,[S],MXCTSEX1)
 IF ABRIR([BUFFER],BUFFER,[E])

  IF DUPLI_DOC
   REPLACE ALL NUMORD WITH ''
   DUPLI_DOC:=.F.
  ENDIF
  GO TOP
  RECAREQ()

  IF CONFORME<>'N'
   listaserial({||e_origen=='REC'.and.e_numero==xnumreq})
  ENDIF

  SETCOLOR(C_TEX2)
  RQ_TOTAL()
  SETCOLOR(C_TIT2)
  ed_renglon=.T.
  VACIO=.F.
  DO WHILE .T.
   set key 287 to serializa
   SET KEY -7 TO SER0000
   SET KEY -8 TO REQopcion
   ustre:='USTREPAG'+Alltrim(Str(subopcion))
   ClvT:=&ustre
   &ustre.:='SSS'
   if cpa_propro='S'
    SELANT:=SELECT()
    DBSELECTAR('MXCTAINV')
    SET FILTER TO
    SET FILTER TO PROV_ASIG==XPROVEE
    DBGOTOP()
    DBSELECTAR(SELANT)
   endif
   DO EDC WITH [RRE],[],RSUBTIT,RCAMPO,.T.,.T.,.T.,.F.,.F.,.T.,.T.,.F.,[Alt-S=SERIALES  F8=SERVICIOS  F9=ORDEN DE COMPRA],.T.
   &ustre.:=ClvT
   set key 287 to
   SET KEY -8 TO
   SET KEY -7 TO

   SELECT BUFFER
   GO TOP
   REPLACE ALL  NUMREQ WITH XNUMREQ , EMISION WITH XEMISION
   GO TOP
   vacio=LASTREC()=0 .OR. EOF()
   EXIT
  ENDDO

  CERRAR([BUFFER])
  IF VACIO
   SELECT MXENCREQ
   LOOP
  ENDIF


  CONFORME=CONFIRMA()

  IF CONFORME<>[S]
   IF CONFORME=[C]
    //CANCNUM(MXNUMREQ,XNUMREQ)
    CANCNUM(CFILNUM,XNUMREQ)
    DELETE FILE (BUFFER)
   ENDIF
  ENDIF

 ENDIF
 CERRAR('MXCTASER')

 ENDIF
 EXIT
ENDDO
SET KEY -7 TO DUP_REQ
SET KEY 279 TO REIMPRIM
SELECT MXENCREQ
RETURN

