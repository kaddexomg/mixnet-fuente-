STATIC FUNCTION GEN_REQINV
PRIVATE XORIGEN,XCANTIDAD,XUNIDAD,XITEM ,ACT_ORD, YDESPACHO
* GENERA MOVIMIENTOS DE INVENTARIO
ACT_ORD=.F.
IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
  IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX1,MXTRINX2,MXTRINX3)
  * ORDENES DE COMPRA
   ACT_ORD=!EMPTY(LISTAORD)
   IF ACT_ORD
    ABRIR("MXRENORD",MXRENORD,[S],MXREORX2,MXREORX1)
   ENDIF
   SELECT MXRENREQ
   SEEK(XNUMREQ)
   DO WHILE !EOF() .AND. NUMREQ=XNUMREQ
     XITEM=ITEM
     XCODMOVART = ITEM
     XFECHA_MOV = XEMISION
     XTIPINV    = [EN]
     XNUMDOC    = XNUMREQ
     XUNIDAD    = UNIDAD
     XCANTIDAD  = CAMBUL(CANTIDAD,BULTO)
     XBULTO     = BULTO
     XCOSTO_TOT = COSTO_TOT
     XVENTA_TOT = 0
     XORIGEN    = [REC]
     XPROV_CLI  = XPROVEE
     YNUMORD    = NUMORD
     xCODCON    = CODCON
     xCODDPTO   = CODDPTO
     SELECT MXCTAINV
     if DbSeek(XITEM)
      DO MENSAJ WITH [Generando movimiento en INVENTARIO ...]
      SELECT MXTRAINV
      ADD_REC(0)
      ARC_INV()
      RecalCos(xitem)
     endif
     ARC_ORD(YNUMORD)
     SELECT MXRENREQ
     SKIP
   ENDDO
   CERRAR([MXTRAINV])
 ENDIF
 CERRAR([MXEXTINV])
ENDIF
IF ACT_ORD
 ACTUALORD()
 CERRAR("MXRENORD")
ENDIF

RETURN 0

* REVERSA MOVIMIENTOS DE INVENTARIO
STATIC FUNCTION RE_GENREQ
PARAMETER EL_NUM
PRIVATE YCANTIDAD, ACT_ORD, YNUMORD, YBULTO
ACT_ORD=.F.
IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
  IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX3)

   ACT_ORD=!EMPTY(LISTAORD)

   IF ACT_ORD
    ABRIR("MXRENORD",MXRENORD,[S],MXREORX2,MXREORX1)
   ENDIF

   SELECT MXRENREQ
   SEEK(EL_NUM)
   WHILE !EOF() .AND. NUMREQ=EL_NUM
    XITEM=ITEM
    YCANTIDAD=CAMBUL(CANTIDAD,BULTO)
    ytipinv:='EN'
    YBULTO=BULTO
    YNUMORD=NUMORD
    SELECT MXTRAINV
    IF DBSEEK(EL_NUM+"EN"+XITEM+"REC")
       Do while numdoc+tipinv+codmovart+origen=el_num+ytipinv+xitem+"REC" .AND. !eof()
          MENSAJ([Reversando movimiento en INVENTARIO ARTICULO: ]+Alltrim(xitem))
          REV_INV()
          SELECT MXTRAINV
          REC_LOCK(0)
          DELETE
          DbCommit()
          UNLOCK
          DbSkip()
       Enddo
    ENDIF
    *ReCalCos(xitem)
    REV_ORD(YNUMORD)
    SELECT MXRENREQ
    SKIP
   ENDDO
   CERRAR([MXTRAINV])
 ENDIF
 CERRAR([MXEXTINV])
ENDIF
IF ACT_ORD
 ACTUALORD()
 CERRAR("MXRENORD")
ENDIF
RETURN 0

