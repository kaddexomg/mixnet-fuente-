PROCEDURE RPLREQ
* REEMPLAZO EN EL REGISTRO
IF MODIFICA
 RE_GENREQ(LNUMREQ)
 RPL_LISTA(SERIAL_OLISTA,SERIAL_ORP)
ENDIF
SELECT MXENCREQ
MENSAJ([Grabando RECEPCION ...])
AUDITORIA([Acceso a mantenimiento de recepci¢n],xnumreq,numreq,IF(MODIFICA,[MOD],[INC]))
REPLACE NUMREQ WITH XNUMREQ,;
        EMISION  WITH XEMISION,;
        PROVEE WITH XPROVEE,;
        COMEN1 WITH XCOMEN1,;
        COMEN2 WITH XCOMEN2,;
        TOT_REQ WITH XTOT_REQ,;
        ESTATUS WITH XESTATUS,;
        ALMACEN WITH XALMACEN,;
        HORA WITH XHORA
RPL_LISTA(SERIAL_LISTA,SERIAL_RPL)
SELECT MXRENREQ
WHILE !FLOCK()
ENDDO
IF MODIFICA
 SEEK(LNUMREQ)
 DELETE WHILE NUMREQ = LNUMREQ
ENDIF
APPEND FROM (BUFFER)
UNLOCK
XRG:=RECNO()
* ACTUALIZA EL ARCHIVO HISTORICO DE PROVEEDORES
IF ABRIR([MXHISCPA],MXHISCPA,[S],MXHICPX1)
  SELECT MXRENREQ
  SEEK(XNUMREQ)
  IF FOUND()
    DO WHILE NUMREQ=XNUMREQ
      IT:=ITEM+XPROVEE
      SELECT MXHISCPA
      IF !DBSEEK(IT)
         DBAPPEND()
      ENDIF
      REC_LOCK(0)
      REPLACE CODART WITH MXRENREQ->ITEM,CODPRO WITH XPROVEE,;
      CANTIDAD WITH MXRENREQ->CANTIDAD,COSTOU WITH Div(mxrenreq->costo_tot,mxrenreq->cantidad),FECHA_CPA WITH XEMISION
      UNLOCK
      SELECT MXRENREQ
      DBSKIP()
    ENDDO
  ENDIF
ENDIF
CERRAR([MXHISCPA])
SELECT MXRENREQ
DBGOTO(XRG)
GEN_REQINV()
LIMPIA()
DELETE FILE (BUFFER)
DbCommitAll()
if inv_repr='S' .and. Decis([¨ Desea repreciar los precios seg£n margen por grupos ?],2)=[S]
   Reprec_xgri('MXRENREQ')
endif
if cpa_etiq='S' .and. Decis([¨ Desea emitir Etiquetas ?],1)=[S]
   Emitir_etiq()
endif

SELECT MXENCREQ
DbCloseAll()
DOC_EMI(' RECEPCION ',G_LIBREC,'MXENCREQ',XNUMREQ)
DbCloseAll()
AbrirReq()
PANREQ()
RETURN

