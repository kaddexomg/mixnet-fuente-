PROCEDURE GETRRE
* CAPTURA REGISTRO
MENSAJ([<ENTER>=ALMACEN  F8=SERVICIOS  F9=ORDEN DE COMPRA],MAXROW())
ES_D=.F.
YFACTOR=1
CHKU=.F.
IF !MODIFICA .AND. CPA_SERV='S'
   XITEM:=PAD('\',15)
ENDIF
@ CONTLIN, 2 GET XITEM WHEN !VIENE_ORD VALID CHKOTEM(1)
@ maxrow()-5,8 GET XDESCRIP PICT '@S35'
@ CONTLIN,18 GET XUNIDAD   WHEN W1()  PICT [!!!] VALID SEL_UNI(UNIREF,@XUNIDAD,CHKU)
@ CONTLIN,22 GET XBULTO    WHEN W1()  PICT "99999" VALID XBULTO>0
@ CONTLIN,28 GET XCANTIDAD WHEN W1()  PICT "9999999999.999" VALID xCANTIDAD>0
@ CONTLIN,43 GET XCOSTO    WHEN W1()  PICT '999999999.999' valid ABS(cambul(xcantidad,xbulto)*XCOSTO)<VAL('999999999.999')
@ CONTLIN,57 GET XDESC     WHEN W1()  PICT "999.99"  VALID XDESC>=0 .AND. XDESC<=100.00
@ CONTLIN,64 GET XCOSTO_TOT when !EMPTY(XITEM).and.XCOSTO=0 PICT '9999999999.999'
READ
SALIR:=ESCAPAR().or.ABS(cambul(xcantidad,xbulto)*XCOSTO)>=VAL('9999999999.999')
IF !SALIR .AND. !EMPTY(XITEM)
 /*
 if xcosto_tot=0
    pare('PRECAUCION: Costo cero')
 endif
 */
 CUENTACON()
ENDIF
FUTREN()
RETURN

STATIC FUNC W1
RETURN (!EMPTY(XITEM))
STATIC PROC FUTREN
IF !SALIR
  IF !W1()
   STORE 0 TO XBULTO,XCANTIDAD,XCOSTO_TOT,XDESC
   XIVA=' '
  ELSE
   IF XCOSTO=0
    XCOSTO=DIV(XCOSTO_TOT,XCANTIDAD)
   ENDIF

   IF CHKU
    XUNIDAD=UNIREF
    XCANTIDAD=XCANTIDAD*YFACTOR
   ENDIF
   XCOSTO:=CAMBIO_IMPORTE(XCOSTO,Xemision)
   XCOSTO_TOT=CAMBUL(XCANTIDAD,XBULTO)*XCOSTO*(1-(XDESC/100.00))
  ENDIF
ENDIF
RETURN

