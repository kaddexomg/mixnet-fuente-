STATIC FUNCTION INC_ORDREQ
private tiene,ulias,Z_NUMERO

tiene = .f.
ulias = select()

IF ABRIR("MXENCORD",MXENCORD,[S],MXENORX3)
 SEEK(XPROVEE)
 IF FOUND()
  COPY TO (BUFCON) WHILE PROVEE = XPROVEE FOR ESTATUS<>'OK'
  IF ABRIR("BUFcon",bufcon,[S])
   if !eof()
    tiene=.t.
    Z_NUMERO=SPACE(8)
    satelcpa([ ORD. COMPRA ],'NUMORD','EMISION', 'CPASELPROG',LISTAORD)
    CERRAR("BUFCON")
    delete file (BUFCON)
    IF !EMPTY(Z_NUMERO)
     IF ABRIR("MXRENORD",MXRENORD,[S],MXREORX1)
      IF !DBSEEK(Z_NUMERO)
       CERRAR("MXRENORD")
      ELSE
       COPY TO (BUFORD) WHILE NUMORD=Z_NUMERO
       CERRAR("MXRENORD")
       ABRIR([BUFORD],BUFORD,[E])
       replace all cantidad with cantidad-despacho,;
                   bulto    with bulto   -desbulto,;
                   COSTO_TOT  with CAMBUL(cantidad,bulto)*COSTO*(1-desc/100)
       //delete for !difcero(COSTO_TOT).AND.!EMPTY(ITEM)
       DELETE FOR CANTIDAD=0 .AND. !DIFCERO(COSTO_TOT) .AND. !EMPTY(ITEM)
        pack
       cerrar("BUFORD")
      *******************************************************
       SELECT BUFFER
       APPEND FROM (BUFORD)
       REPLACE ALL  NUMREQ    WITH XNUMREQ  , EMISION   WITH XEMISION
       DELETE FILE (BUFORD)
       GO TOP
       IF EN_MENUH
        GO TOP
        NOFLECHA()
        PRIPAG()
        RECAREQ()
       ELSE
        RECALCULA:=.T.
       ENDIF
      ENDIF
     ELSE
      PARE('NO ABRIO')
     ENDIF
    ENDIF
   ELSE
    CERRAR("BUFCON")
   endif
  endif

 ENDIF
 if !tiene
  PARE("Proveedor no tiene Orden de Compra")
 endif
ENDIF
CERRAR("MXENCORD")
SELECT (ULIAS)

RETURN 0

