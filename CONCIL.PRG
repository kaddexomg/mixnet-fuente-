FUNCTION CHCCBAN
PARAMETER EL_COD
PRIVATE USEL
IF LASTKEY()=5
 RETURN .T.
ENDIF
USEL=SELECT()
SELECT MXCTABAN
SEEK(EL_COD)
IF !FOUND()
 SELINFBAN()
 SELE (USEL)
 RETURN .F.
ELSE
 XNOMBAN=TRIM(NOMCOD(EL_COD,[MXCTABAN]))
ENDIF
SELECT (USEL)
RETURN .T.


