PROCEDURE BAN0405
* CONCILIACION
PRIVATE UNA_VEZ,XSALDO,YPER,EN_CURSO,II_ORDEN,CO_CAMINO
CO_CAMINO=if(!EMPTY(G_TIT_EJ),G_CAMINO,if(!empty(G_OLD_CAMINO),g_old_camino,g_camino))
II_ORDEN=1
DECLARE ORDEN[1]
ORDEN[1]=[]
* DEFAULT ************************
STORE SPACE(7) TO II_DESDE,II_HASTA
II_FEC=ULT_DAY(CTOD(G_FECHA))
UNA_VEZ=.T.
EN_CURSO=.F.
*************************************
I_PLAN=[SELINFBAN]
IF ABRIR([MXTRABAN],MXTRABAN,[S],MXTRBAX3)
 IF ABRIR([MXDAABAN],MXDAABAN,[S])
  IF ABRIR([MXCTABAN],MXCTABAN,[S],MXCTBAX1)
   CUERPO(PROCNAME(),[ CONCILIACION BANCARIA ],55,.F.,.F.,.T.,.T.,.T.)
  ENDIF
 ENDIF
ENDIF
RETURN

PROCEDURE HBAN0405
I_ANCHO:=79
IF UNA_VEZ
 DO WHILE .T.
  SELECT MXCTABAN
  CTL_MAN()
  EL_REC=RECNO()
  BUFFER=CO_CAMINO+[MX]+ALLTRIM(STRTRAN(MXCTABAN->CODBAN,'.'))+[.]+STRZERO(MONTH(II_FEC),2)
  IF !FILE(BUFFER)
   SELECT MXCTABAN
   IF !I_MANUAL
    SKIP
    IF EOF()
     SALIR=.T.
     BREAK
    ENDIF
   ENDIF
  ELSE
   ABRIR([BUFFER],BUFFER,[S])
   SELECT MXDAABAN
   GOTO EL_REC
   XSALDO=BS(SALDO_ACT(YPER))
   EXIT
  ENDIF
 ENDDO
 UNA_VEZ=.F.
 EN_CURSO=.F.
 SELECT MXCTABAN
ENDIF
IF IMPRE
 DO PONFEC
ENDIF
? 'CONCILIACION BANCARIA'
? [CODIGO:]+MXCTABAN->CODBAN
? [NOMBRE:]+MXCTABAN->NOMBRE
? [CUENTA:]+MXCTABAN->CUENTA
? [SALDO :]+LTRIM(TRANS(XSALDO,TRAN21))
? [CONCILIACION MES DE ]+UPPER(G_MESES[MONTH(II_FEC)])
? REPLICATE('Í',I_ANCHO)
? [FECHA      TP NUMERO   BENEFICIARIO                                     IMPORTE]
? REPLICATE('Í',I_ANCHO)
IF EN_CURSO
 ? 'MOVIMIENTO NO CONCILIADOS MES DE '+UPPER(G_MESES[MONTH(II_FEC)])
ELSE
 ? 'MOVIMIENTO NO CONCILIADOS DE MESES ANTERIORES :'
ENDIF
CONTLIN=CONTLIN+11
RETURN

PROCEDURE DBAN0405
ESCRIBE([])
J=1
SELECT BUFFER
DO WHILE J<=2
 JJ=STR(J,1)
 IF J=1
  XTOTAL1=0
  LOCATE FOR TIPORG=[TR] .AND. !CONCILIA
 ELSE
  XTOTAL2=0
  EN_CURSO=.T.
  LOCATE FOR TIPORG<>[TR] .AND. !CONCILIA
  *LOCATE FOR TIPORG=[  ] .AND. !CONCILIA // ESTA LINEA FUE MODIFICADA POR LA DE ARRIBA EL DIA 16.8.2002
  SETCOLOR(C_TIT2)
  ? [MOVIMIENTO NO CONCILIADOS MES DE ]+UPPER(G_MESES[MONTH(II_FEC)])
  SETCOLOR(C_TEX2)
  CONTLIN=CONTLIN+2
 ENDIF
 ?
 DO WHILE !EOF()
  ESCRIBE(DTOC(FECHA_MOV)+' '+TIPBAN+' '+NUMDOC+' '+PAD(BUSCAR_UBICAR('MXTRABAN',MXCTABAN->CODBAN+TIPBAN+NUMDOC,'BENEFICIA'),34)+' '+TRANS(E_IMPORTE(IMPORTE,FECHA_MOV),TRAN21))
  IF TIPBAN<>[AN]
   XTOTAL&JJ=XTOTAL&JJ+E_IMPORTE(IMPORTE,FECHA_MOV)
  ENDIF
  CONTINUE
 ENDDO
 * TOTAL TRANSITO **************************************
 ESCRIBE(REPLICATE('Ä',I_ANCHO))
 ESCRIBE('TOTAL:'+SPACE(52)+TRANS(XTOTAL&JJ,TRAN21))
 ESCRIBE(REPLICATE('Ä',I_ANCHO))
 J=J+1
ENDDO

**** TOTAL FINAL ****************************************
TOT_TRAN=XTOTAL1+XTOTAL2
ESCRIBE(REPLICATE('Ä',I_ANCHO))
ESCRIBE('TOTAL MOVIMIENTOS NO CONCILIADOS:'+SPACE(25)+TRANS(TOT_TRAN,TRAN21))
ESCRIBE(REPLICATE('Í',I_ANCHO))
TOT_CONC=XSALDO-TOT_TRAN
ESCRIBE('SALDO EN ESTADO DE CUENTA DEBE SER:                       '+TRANS(TOT_CONC,TRAN21))
ESCRIBE(REPLICATE('Í',I_ANCHO))

CERRAR([BUFFER])

EN_CURSO=.F.
UNA_VEZ=.T.
CONTLIN=MAXLIN+1
SELECT MXCTABAN
IF !I_MANUAL
 SKIP
ENDIF
RETURN

