STATIC PROC MODIF_BALA
LOCAL USEL:=SELECT()
IF CAMBIAR_BALA
 IF ABRIR("RENDEF",MXRDBCON,[E])
   REPLACE ALL CODBAL WITH XCODIGO FOR CODBAL=LCODIGO
   CERRAR('RENDEF')
   INDEXA(MXRDBCON,MXRBCOX2,[CODBAL])
 ENDIF
 SELECT (USEL)
ENDIF
RETURN

