FUNC AGREGABAL(X1,X2,X3)
 EDIT_VENTANA('EDCBAL')
 SELECT MXCTACON
RETURN NIL

FUNC PROCRDB
PARAMETER EL_BAL
PRIVATE BUFFER:=G_CAMINO+[BUFDEF]+ESTACION+[.DBF], TOCADO:=.F.
IF ABRIR([RENDEF],MXRDBCON,[S],MXRBCOX1,MXRBCOX2)
 IF DBSEEK(EL_BAL)
  COPY TO (BUFFER) WHILE CODREP=EL_BAL
  EDIT_VENTANA('EDCRDB')
  SELECT RENDEF
  DO WHILE !FLOCK()
  ENDDO
  IF TOCADO
   IF DBSEEK(EL_BAL)
    DELETE WHILE CODREP=EL_BAL
   ENDIF
   APPEND FROM (BUFFER)
  ENDIF
 ENDIF
 UNLOCK
 CERRAR('RENDEF')
ENDIF
RETURN NIL

