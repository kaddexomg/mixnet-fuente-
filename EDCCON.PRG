PROCEDURE CON0000
PARAMETERS P1,P2,P3
PRIVATE cambiar_bala:=.f.
PRIVATE UKEY
IF EN_CTA
 RETURN
ENDIF

PRIVATE ULT_ALIAS,VARIOS1
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)

Private t1:=subopcion,t2:=gestion

DECLARE RCAMPO[2],RSUBTIT[2]
PRIVATE XCODIGO,LCODIGO,XNOMBRE,SALE_M,BCODIGO,BNOMBRE

STORE SPACE(20) TO XCODIGO, BCODIGO
BNOMBRE=SPACE(25)

EN_CTA=.T.
DO CAMCON
DO SUBCON
ULT_ALIAS=ALIAS()
IF ABRIR([MXPSPCON],MXPSPCON,[S])
 IF ABRIR([MXDAACON],MXDAACON,[S])
  IF ABRIR([MXCTACON],MXCTACON,[S],MXCTCOX1)
   SET RELA TO RECNO() INTO MXDAACON
   INIT_CODE()
   UKEY:=SETKEY(-7)
   SET KEY -9 TO ANALICON
   SET KEY -7 TO AGREGABAL
   SET KEY -40 TO VDETALLE
   subopcion:=2
   gestion:='CON'
   EDC([CON],[ CUENTAS DE CONTABILIDAD ],RSUBTIT,RCAMPO,.T.,.T.,POPC3[2],.T.,.F.,.F.,.T.,.F.,'F8=AGREGAR A CUENTA BALANCE    F10=GRAFICAR   F11=VER DETALLES MENSUAL')
   subopcion:=t1
   gestion:=t2
   SETKEY(-7,UKEY)
   SET KEY -9 TO
   CERRAR([MXDAACON])
   CERRAR([MXCTACON])
   CERRAR([MXPSPCON])
  ENDIF
 ENDIF
ENDIF

RESEL()
EN_CTA=.F.
RETURN

STATIC PROC INIT_CODE
IF EOF() .AND. TYPE([M24])=[C]
 IF G_PUNTO
  IF DECIS([Fichero vacio. ¨ Desea ejecutar el proceso de auto-codificaci¢n ?])=[S]
   AUTOCODE()
   KEYBOARD []
  ENDIF
 ELSE
  IF DECIS([Fichero vacio. ¨ Desea copiar el plan de cuentas del sistema ?])=[S]
   COPICODE()
   KEYBOARD []
  ENDIF
  GO TOP
  IF EOF()
   DETER_NIV()
  ENDIF
 ENDIF
ENDIF
RETURN

PROCEDURE CAMCON
RCAMPO[ 1]=[CODIGO]
RCAMPO[ 2]=[NOMBRE]
RETURN

PROCEDURE DEFCON
* VALORES POR DEFECTO
LCODIGO    = SPACE( 20)
XNOMBRE    = SPACE( 30)
RETURN

PROCEDURE ASGCON
* ASIGNACION DE REGISTRO A MEMORIA
STORE CODIGO TO XCODIGO,LCODIGO
XNOMBRE    = NOMBRE
RETURN

PROCEDURE RPLCON
* REEMPLAZO EN EL REGISTRO
SELECT MXCTACON
AUDITORIA([Acceso a mantenimiento de cuentas contables],xcodigo,codigo,IF(MODIFICA,[MOD],[INC]))
REPLACE CODIGO WITH XCODIGO,NOMBRE WITH XNOMBRE,MARCA WITH ES_DET(XCODIGO),NIVCOD WITH NIVEL(XCODIGO)

IF !MODIFICA

 SELECT MXDAACON
 ADD_REC(0)
 SELECT MXPSPCON
 ADD_REC(0)
 SELECT MXCTACON

ELSE

 MODIF_BALA()

ENDIF

RETURN

