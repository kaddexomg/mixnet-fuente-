PROCEDURE NUEVOCLI
PRIVATE XCODCLI,XNOMCLI,XEMAIL,XCODACTI:=SPACE(5),XGRUPO:=SPACE(5),XCIF,XDIREC1,XDIREC2,XDIREC3,XDIREC4,XTLF1,XTLF2,XFAX,XESTATUS
