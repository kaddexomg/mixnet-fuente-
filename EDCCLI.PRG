PRIVATE XREGIMEN,xtarifa,XCTABANCO,XBANCO:='',XFORMA,XTRANSPOR, XCODCON, XNIT
PRIVATE BCODCLI:=SPACE(8),BNOMCLI:=SPACE(60),II_LISTASI:='',xCODACTI
