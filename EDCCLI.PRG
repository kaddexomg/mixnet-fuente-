Function CHACT(el_codact)
Private enc
enc=.T.
if empty(el_codact)
   RETURN(.t.)
endif
DbSelectar('MXACTCLI')
if !DbSeek(el_codact)
   EDIT_VENTANA('EDACTCLI')
   if lastkey()=27
      enc=.f.
   else
      xcodacti:=codacti
      enc:=.f.
   endif
else
   @ 5,26 SAY NOMCOD(el_codact,[MXACTCLI],[NOMACTI])
endif
DbSelectar('MXCTACLI')
RETURN enc

