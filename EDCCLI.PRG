 local mens
 IF USTR_DESCLI='N'
   PARE('USUARIO NO AUTORIZADO PARA REALIZAR ESTA ACCION')
   RETURN NIL
 ENDIF
 SET KEY -7 TO
 mens:=if(!activo,' ¨ Desea desactivar al cliente actual ? ',' ¨ Desea activar al cliente actual ? ')
 if decis(mens,2)='S'
    if rlock()
       mxctacli->activo := if(activo,.f.,.t.)
