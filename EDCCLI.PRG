PRIVATE XLIMFACP
PRIVATE VTAS_CODCON:="S"
PRIVATE PVFILE:=CE([MXVTASPG.MTD])
PRIVATE XREGMERC := ' '
PRIVATE XPORRIVA := 0

IF FILE(PVFILE)
   RESTORE FROM (PVFILE) ADDITIVE
ENDIF

PRIVATE MODIFICA,UREG,LREG

SELECT MXCTACLI
SET ORDER TO 1
LREG=-1
UREG=RECNO()
SAVE SCREEN
IF ABRIR([MXGRUCLI],MXGRUCLI,[S],MXGRCLX1)
IF ABRIR([MXCTAZON],MXCTAZON,[S],MXCTZOX1)
IF ABRIR([MXACTCLI],MXACTCLI,[S],MXACCLX1)
IF ABRIR([MXCTAVDD],MXCTAVDD,[S],MXCTVDX1)
   SELECT MXCTACLI
   XGRUPO=GRUPO
   MODIFICA=.F.
   INIT_VER()
   DO MENSAJ WITH MEN2
   MASCLI()
   DEFCLI()
   CUR_ON()
   GETCLI()
   CUR_OFF()
   IF !SALIR
    SELECT MXCTACLI
    ADD_REC(0)
    DO RPLCLI
    UREG=RECNO()
    INC_REG:=UREG
    INC_CLI=.T.
    KEYBOARD ESCAPE
   ENDIF
   SELEC MXCTACLI
   GOTO UREG
   RESTORE SCREEN
   CERRAR([MXCTAVDD])
ENDIF
   CERRAR([MXCTAZON])
ENDIF
   CERRAR([MXGRUCLI])
ENDIF
   CERRAR([MXACTCLI])
ENDIF
SELECT MXCTACLI
RETURN


