PROCEDURE RPLECO
local XNUM, CHANGE_NUM
SELECT MXRENCON
DO WHILE !FLOCK()
ENDDO
XNUM:=new_num(dtos(XFECHA_ASI)+XASIENTO)
IF (CHANGE_NUM:=(XNUM<>dtos(XFECHA_ASI)+XASIENTO))
 XASIENTO:=SUBSTR(XNUM,9,8)
ENDIF
IF EN_LINEA .OR. CHANGE_NUM
 IF !ABRIR([BUFFER],BUFFER,[E])
  RETURN
 ENDIF
ENDIF
IF CHANGE_NUM
 SELECT BUFFER
 REPLACE ALL ASIENTO WITH XASIENTO
 IF EN_LINEA
  GO TOP
 ELSE
  CERRAR('BUFFER')
 ENDIF
ENDIF
IF MODIFICA
 IF CAMBIO
  IF EN_LINEA
   * REVERSA MOVIMIENTO
   REV_MOV(LFECHA_ASI,LASIENTO)
   * ARCHIVA MOVIMIENTO
   ARC_MOV(XFECHA_ASI,XASIENTO,[BUFFER])
  ELSE
   SELECT MXRENCON
   SEEK(DTOS(LFECHA_ASI)+LASIENTO)
   DELETE WHILE FECHA_ASI=LFECHA_ASI .AND. ASIENTO=LASIENTO
   APPEND FROM (BUFFER)
  ENDIF
 ENDIF
ELSE
 IF EN_LINEA
  * ARCHIVA MOVIMIENTO
  ARC_MOV(XFECHA_ASI,XASIENTO,[BUFFER])
 ELSE
  SELECT MXRENCON
  APPEND FROM (BUFFER)
 ENDIF
ENDIF
SELECT MXRENCON
UNLOCK
IF EN_LINEA
 CERRAR([BUFFER])
ENDIF
SELECT MXENCCON
AUDITORIA([Acceso a mantenimiento de asientos ]+if(en_linea,[actuales],[diferidos]),xasiento+' '+dtoc(xfecha_asi),asiento+' '+dtoc(fecha_asi),IF(modifica,[MOD],[INC]))
REPLACE FECHA_ASI  WITH XFECHA_ASI,ASIENTO WITH XASIENTO,DESC_ASI WITH XDESC_ASI
REPLACE DEBITOS    WITH XDEBITO, CREDITOS  WITH XCREDITO
DBCOMMIT()
DBUNLOCK()
DELETE FILE (BUFFER)
RETURN

PROCEDURE GETECO
PRIVATE VACIO
* CAPTURA REGISTRO
/*
IF MODIFICA
   IF !rlock()
      Alerta("Registro esta siendo utilizado por otro Usuario...")
      RETURN NIL
   ENDIF
ELSE
   RLOCK()
ENDIF
*/
DO WHILE .T.
DO OFF_KEY
SET KEY -9 TO
SELECT MXENCCON
@  4,14 GET XFECHA_ASI VALID CHKEJER(XFECHA_ASI) .AND. !CHK_BLOCK(XFECHA_ASI) .and. Chk_bgf(xfecha_asi)
@  5,14 GET XASIENTO VALID CHKASE()
@  4,48 GET XDESC_ASI
leer()
DO MASECO
DO T_TOTAL
SALIR=ESCAPAR()
IF SALIR
 IF ENTRO
  DO BELL
  IF DECIS([¨ Desea cancelar la operaci¢n ?],1)=[S]
   SELECT MXENCCON
   CANCNUM(MXNUMASI,XASIENTO)
   DELETE FILE (BUFFER)
   SET KEY -9 TO DUP_TRA
   DBUNLOCKALL()
   RETURN
  ELSE
   SALIR=.F.
   LOOP
  ENDIF
 ELSE
  CANCNUM(MXNUMASI,XASIENTO)
  SET KEY -9 TO DUP_TRA
  DBUNLOCKALL()
  RETURN
 ENDIF
ELSE
*IF !SALIR
 IF EMPTY(XASIENTO)
  LOOP
 ENDIF
 SETCOLOR(C_TIT2)
 @  4,14 SAY XFECHA_ASI
 @  4,48 SAY XDESC_ASI
 @  5,14 SAY XASIENTO
 IF ABRIR([BUFFER],BUFFER,[E])
  REPLACE ALL ASIENTO WITH XASIENTO , FECHA_ASI WITH XFECHA_ASI
  GO TOP
  RECAASI()
  T_TOTAL()
  IF MODIFICA
   IF XFECHA_ASI<>LFECHA_ASI .OR. XASIENTO<>LASIENTO
    CAMBIO=.T.
   ENDIF
  ENDIF
  STORE SPACE(20) TO XCODMOV,BCODMOV
  STORE SPACE(10) TO XREFER,BREFER,xCodDpto
  STORE SPACE(35) TO XCONCEPTO, BCONCEPTO
  BIMPORTE=0
  URELA=[<=]
  MMENUSCR=SAVESCREEN(maxrow()-4,0,maxrow(),79)
  DO WHILE .T.
   VACIO=.F.
   OPCH=3
   IF !EN_LINEA
    SET KEY -8 TO TRASELBAN
   ENDIF
   ENTRO=.T.
   EDC([RCO],[],RSUBTIT,RCAMPO,RMASC,.T.,.T.,.F.,.F.,.F.,.F.,.F.,[F8=CATALOGO]+IF(EN_LINEA,[],[  F9=BANCOS]))
   SET KEY -8 TO
   SET KEY -9 TO DUP_TRA
   GO TOP
   *DO MASECO
   DO T_TOTAL
   IF LASTREC()=0 .OR. EOF()
    VACIO=.T.
    EXIT
   ENDIF
   IF EN_LINEA
    IF STR(XDEBITO,16,2)<>STR(XCREDITO,16,2)
     DO BELL
     IF DECIS([Asiento no cuadra. ¨ Desea continuar ?])=[S]
      LOOP
     ELSE
      KEYBOARD [N]
     ENDIF
    ENDIF
   ENDIF
   EXIT
  ENDDO
  CERRAR([BUFFER])
  RESTSCREEN(maxrow()-4,0,maxrow(),79,MMENUSCR)
  IF VACIO
   LOOP
  ENDIF
  CONFORME=CONFIRMA()
  IF CONFORME<>[S]
   IF CONFORME=[C]
    DBUNLOCKALL()
    CANCNUM(MXNUMASI,XASIENTO)
    DELETE FILE (BUFFER)
   ENDIF
  ENDIF
 ENDIF
ENDIF
SELECT MXENCCON
EXIT
ENDDO
DBUNLOCKALL()
@ 5,48 SAY SPACE(30)
RETURN

FUNCTION CHKASE
LOCAL SELANT:=SELECT(),retorno:=.t.
IF LASTKEY()=5
 RETURN .T.
ENDIF
if en_linea
 IF EMPTY(XASIENTO)
  PARE([N£mero de asiento debe contener informaci¢n])
  RETURN .F.
 ENDIF
 IF !CHKDUP(DTOS(XFECHA_ASI)+XASIENTO,[Asiento])
  RETURN .F.
 ENDIF
ELSE
 IF EMPTY(XASIENTO)
  PARE([N£mero de asiento debe contener informaci¢n])
  RETURN .F.
 ENDIF
 IF !CHKDUP(DTOS(XFECHA_ASI)+XASIENTO,[Asiento])
  RETURN .F.
 ELSE
    IF Abrir('ENCTEMPO',ENCLINE,'S',INDLINE)
       IF DbSeek(DTOS(XFECHA_ASI)+XASIENTO)
          IF decis('Asiento ya existe en actuales, ¨ desea continuar ? ',2)='S'
             retorno:=.t.
          ELSE
             retorno:=.f.
          ENDIF
       ELSE
          retorno:=.t.
       ENDIF
       CERRAR('ENCTEMPO')
    ENDIF
    DBSELECTAR(SELANT)
    RETURN retorno
 ENDIF
ENDIF
RETURN .T.

