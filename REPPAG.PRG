  I_PLAN=[SELINFGRU]
ELSEIF II_ORDEN=1.OR.II_ORDEN=2
  QUE_CAMPO=II_ORDEN
  PREPOPC[5]=.T.
  I_PLAN=[SELINFESP]
ELSE
  PREPOPC[5]=.F.
  I_PLAN=4
ENDIF
RETURN
