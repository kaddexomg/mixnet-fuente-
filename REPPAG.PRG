PROCEDURE CPAG0402
PARAMETER PPP
PRIVATE RES_DET
RES_DET=[ ]
I_BOTCRI=12
IF PCOUNT()=1
  SETCOLOR(C_TIT2)
  @ 11,16 SAY IF(II_RESUMIR,SPACE(11)+[Resumen]+SPACE(13),SPACE(10)+[Detallado]+SPACE(12))
