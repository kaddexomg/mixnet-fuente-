PROCEDURE CPAG0408
PARAMETER PPP
PRIVATE RES_DET,SI_SALTO,FDEP
RES_DET=IF(II_RESUMIR,[R],[D])
STORE [ ] TO SI_SALTO,FDEP
I_BOTCRI=16
SETCOLOR(C_TEX2)
@ 11,16 SAY SPACE(7)+[Proveedor: ]
@ 12,16 SAY [ Contado/Cr‚dito (CO/CR): ]
@ 13,16 SAY IF(II_CONT=[CR],[Tipo Cr‚dito (V/G): ],SPACE(33))
@ 14,16 SAY SPACE(12)+[Modo: ]+SPACE(15)
@ 15,16 SAY IF(!II_RESUMIR,[ Salto de p gina por Compra: ],SPACE(33))

IF PCOUNT()=1
  SETCOLOR(C_TIT2)
  @ 11,34 SAY II_PROVEE
  @ 12,42 SAY IF(EMPTY(II_CONT),[Ambos  ],IF(II_CONT=[CO],[Contado],[Cr‚dito]))
  IF II_CONT=[CR]
    @ 13,36 SAY IF(II_TCR=0,[Todos         ],IF(II_TCR=1,[Vencimiento],[Con Giros     ]))
  ENDIF
  @ 14,34 SAY IF(II_RESUMIR,[Resumen      ],[Detallado    ])
  IF !II_RESUMIR
    @ 15,46 SAY IF(II_SALTO,[Si],[No])
  ENDIF
  SETCOLOR(C_TEX2)
ELSE
  CUR_ON()
  @ 12,42 SAY SPACE(7)
  @ 13,36 SAY SPACE(12)
  @ 11,34 GET II_PROVEE
  @ 12,42 GET II_CONT PICTURE [!!] VALID II_CONT$[COoCRo  ]
  READ
  SALIR=ESCAPAR()
  IF SALIR
   RETURN
  ENDIF
  IF II_CONT=[CR]
    @ 13,16 SAY [Tipo Cr‚dito (V/G): ] GET FDEP VALID FDEP$[VG ]
  ELSE
    @ 12,16 CLEAR TO 13,48
  ENDIF
  @ 14,16 SAY [¨ Resumen ¢ Detallado ? (R/D) ] GET RES_DET PICTURE "!" VALID RES_DET$[RD]
  READ
  CLEAR GETS
  II_RESUMIR=(RES_DET=[R])
  IF !II_RESUMIR
    @ 15,16 SAY [ Salto de p gina por Compra: ] GET SI_SALTO PICT "!" VALID SI_SALTO$[SN]
    READ
    CLEAR GETS
    II_SALTO=SI_SALTO=[S]
  ELSE
    @ 15,16 CLEAR TO 15,48
  ENDIF
  II_TCR=IF(EMPTY(FDEP),0,IF(FDEP=[V],1,2))
ENDIF
I_CRITERIO=[.T.]+IF(EMPTY(II_PROVEE),[],[.AND.PROVEE=TRIM(II_PROVEE)])
IF II_CONT=[CO]
  I_CRITERIO=I_CRITERIO+[.AND. CONDPAG=1]
ELSEIF II_CONT=[CR]
  I_CRITERIO=I_CRITERIO+[.AND. CONDPAG=2]+IF(II_TCR=0,[],[.AND. TIPCRE=]+ALLTRIM(STR(II_TCR)))
ELSE
  I_CRITERIO=I_CRITERIO
ENDIF
PREPOPC[5]=IF(II_ORDEN=1,.T.,.F.)
STORE 0.00 TO XTOT_CPA,UTOT_CPA,UTOT_NET,UCARGOS
SI_TOTALF=II_RESUMIR
SUBTIT2=IF(EMPTY(II_PROVEE),[],[ PROVEEDOR= ]+II_PROVEE)
IF !EMPTY(II_CONT)
  SUBTIT2=SUBTIT2+[ COND. PAGO= ]+IF(II_CONT=[CO],[CONTADO],[CREDITO])
  IF II_CONT=[CR]
    IF II_TCR<>0
      SUBTIT2=SUBTIT2+[ TIPO DE CREDITO= ]+IF(II_TCR=1,[AL VENCIMIENTO],[CON GIROS])
    ENDIF
  ENDIF
ENDIF
*SUBTIT2=SUBTIT2+[ MODO= ]+IF(II_RESUMIR,[RESUMEN],[DETALLADO])
DO REINI
RETURN
