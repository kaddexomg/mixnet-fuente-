PROCEDURE HPAG0402
IF IMPRE
 PONFEC()
ENDIF
DO REINI
TITULA()
IF II_RESUMIR.OR.(!II_RESUMIR.AND.!IMPRE)
  ? REPLICATE([Í],79)
  ? [CODIGO]+SPACE(4)+[NOMBRE]+SPACE(31)+[GRUPO  ZONA]+SPACE(6)+[TELEFONO]
  ? REPLICATE([Í],79)
ELSE
  ?REPLICATE([Í],I_ANCHO)
  ?[CODIGO]+SPACE(3)+[NOMBRE]+SPACE(30)+[DIRECCION]+SPACE(17)+[TELEFONO(S)]+SPACE(5)+[ZONA]+SPACE(5)+[OBSERVACIONES]+SPACE(3)+[STA]+SPACE(5)+[L/CR. GRUPO]
  ?REPLICATE([Í],I_ANCHO)
ENDIF
CONTLIN=CONTLIN+3
RETURN

PROCEDURE DPAG0402
CTL_MAN()
IF II_ORDEN>=3.AND.II_ORDEN<=6
  IF II_ORDEN<=4
    IF GRUPO<>GRUZOX
      ESCRIBE([])
      ESCRIBE([GRUPO = ]+GRUPO+[ ( ]+NOMCOD(GRUPO,[MXGRUCLI],[NOMGRUCLI])+[ ) ])
      ESCRIBE([])
    ENDIF
  ELSE
    IF ZONA<>GRUZOX
      ESCRIBE([])
      ESCRIBE([ZONA = ]+ZONA)
      ESCRIBE([])
    ENDIF
  ENDIF
ENDIF
IF II_RESUMIR.OR.(!II_RESUMIR.AND.!IMPRE)
  ESCRIBE(CODCLI+[  ]+PAD(NOMCLI,35)+[  ]+GRUPO+[  ]+ZONA+[  ]+TLF1)
ELSE
  ESCRIBE(CODCLI+[ ]+PAD(NOMCLI,35)+[ ]+DIREC1+[ ]+TLF1+[ ]+ZONA+[ ]+SUBSTR(OBSERVA,1,15)+;
  [ ]+ESTATUS+[  ]+TRANS(LIM_CRE,[9,999,999])+[ ]+GRUPO)
  ESCRIBE(SPACE(45)+DIREC2+[ ]+TLF2+SPACE(10)+SUBSTR(OBSERVA,16,15))
  ESCRIBE(SPACE(45)+DIREC3+SPACE(26)+SUBSTR(OBSERVA,31,15))
  ESCRIBE(SPACE(45)+DIREC4+SPACE(26)+SUBSTR(OBSERVA,46,15))
ENDIF
IF II_ORDEN>=3.AND.II_ORDEN<=6
  GRUZOX=IF(II_ORDEN<=4,GRUPO,ZONA)
ENDIF
IF EOF().OR.!&I_CONDICION
  GRUZOX=[****]
ENDIF
IF !I_MANUAL
  SKIP
ENDIF
RETURN

