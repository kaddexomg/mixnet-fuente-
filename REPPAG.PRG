PROCEDURE DPAG0408
CTL_MAN()
IF &I_CRITERIO
 IF UNA_VEZ
  IF !II_RESUMIR
   * DETALLADO
   XNUMERO=PROVEE+NUMCOM
   XTOT_COM=E_IMPORTE(TOT_COM,EMISION)
   ESCRIBE(REPLICATE([Í],IF(IMPRE,84,79)),C_TIT2)
   SETCOLOR(C_TEX2)
   ESCRIBE([ No. COMPRA: ]+NUMCOM+SPACE(7)+[EMISION: ]+DTOC(EMISION))
   ESCRIBE([  PROVEEDOR: ]+PROVEE+SPACE(8)+[NOMBRE: ]+PAD(NOMCOD(PROVEE,[MXCTACLI],[NOMCLI]),35))
   ESCRIBE([ COND. PAGO: ]+IF(CONDPAG=1,[CONTADO],[CREDITO])+IF(CONDPAG=1,[],IF(TIPCRE=1,[ AL VENCIMIENTO: ]+DTOC(VENCE),[ CON GIROS])))
   IF CONDPAG=1
    ESCRIBE([ FORMA PAGO: ]+FORMAPAG+TABLAPAG(FORMAPAG))
   ENDIF
   ESCRIBE([COMENTARIOS: ]+COMEN1)
   ESCRIBE(SPACE(13)+COMEN2)
   IF IMPRE
    ESCRIBE(REPLICATE([Ä],84))
    ESCRIBE([ITEM            DESCRIPCION                         UNIDAD   CANTIDAD    COSTO TOTAL])
            *--------------- ----------------------------------- ------ ---------- --------------
    ESCRIBE(REPLICATE([Ä],84))
   ELSE
    SETCOLOR(C_TIT2)
    ESCRIBE(REPLICATE([Ä],79))
    ESCRIBE([ITEM            DESCRIPCION                     UND    CANTIDAD     COSTO TOTAL])
            *--------------- ------------------------------- --- -----------  --------------
    ESCRIBE(REPLICATE([Ä],79))
    SETCOLOR(C_TEX2)
   ENDIF
  ENDIF
 ENDIF
 IF !II_RESUMIR
  SELECT MXRENCPA
  SEEK(XNUMERO)
  DO WHILE !EOF().AND.PROVEE+NUMCOM=XNUMERO
   IF ITEM<>[*C]
    MNOMART=NOMCOD(ITEM,[MXCTAINV],[NOMART])
    IF MNOMART=[***]
     MNOMART=SPACE(35)
    ENDIF
    IF IMPRE
     REST_LIN=PAD(MNOMART,35)+[ ]+UNIDAD+[   ]+TRANS(CANTIDAD,[999,999.999])+[ ]+TRANS(E_IMPORTE(COSTO_TOT,EMISION),TRAN14)
    ELSE
     REST_LIN=SUBSTR(MNOMART,1,31)+[ ]+UNIDAD+[  ]+STR(CANTIDAD,10,3)+[  ]+TRANS(E_IMPORTE(COSTO_TOT,EMISION),TRAN14)
    ENDIF

    ESCRIBE(ITEM+[ ]+REST_LIN,C_TEX2)
   ELSE
    ESCRIBE([CARGOS],C_TEX2)
   ENDIF

   IF CONTLIN=MAXLIN
    UNA_VEZ=.F.
   ENDIF
   SKIP
  ENDDO
  DO &TOTALF
  IF II_SALTO
   CONTLIN=MAXLIN+1

  ENDIF
 ELSE
  * RESUMEN ******
  IF IMPRE
   ESCRIBE(NUMCOM+[ ]+DTOC(EMISION)+[ ]+PROVEE+[ ]+PAD(NOMCOD(PROVEE,[MXCTACLI],[NOMCLI]),35)+[ ]+;
          TRANS(E_IMPORTE(TOT_NET,EMISION),TRAN14)+[ ]+TRANS(E_IMPORTE(CARGO,EMISION),TRAN14)+[ ]+TRANS(E_IMPORTE(TOT_COM,EMISION),TRAN14))
  ELSE
   ESCRIBE(NUMCOM+[ ]+DTOC(EMISION)+[ ]+PROVEE+[ ]+TRANS(E_IMPORTE(TOT_NET,EMISION),TRAN17)+[ ]+;
   TRANS(E_IMPORTE(CARGO,EMISION),TRAN14)+[ ]+TRANS(E_IMPORTE(TOT_COM,EMISION),TRAN17))
  ENDIF
  UTOT_CPA=UTOT_CPA+E_IMPORTE(TOT_COM,EMISION)
  UTOT_NET=UTOT_NET+E_IMPORTE(TOT_NET,EMISION)
  UCARGOS=UCARGOS+E_IMPORTE(CARGO,EMISION)
 ENDIF
ENDIF
SELECT MXENCCPA
IF !I_MANUAL
 SKIP
ENDIF
UNA_VEZ=.T.
RETURN

PROCEDURE FPAG0408
IF II_RESUMIR
 IF IMPRE
  ESCRIBE(REPLICATE([Ä],84))
  ESCRIBE(SPACE(54)+[TOTALES: ]+TRANS(UTOT_NET,TRAN14)+[ ]+TRANS(UCARGOS,TRAN14)+[ ]+;
          TRANS(UTOT_CPA,TRAN14),C_TIT2)
  ESCRIBE(REPLICATE([Í],84))
 ELSE
  SETCOLOR(C_TIT2)
  ESCRIBE(REPL("Í",79))
  ESCRIBE([TOTALES:]+SPACE(21)+TRANS(UTOT_NET,TRAN17)+[ ]+;
          TRANS(UCARGOS,TRAN14)+[ ]+TRANS(UTOT_CPA,TRAN17))
  ESCRIBE(REPL("Í",79))
  SETCOLOR(C_TEX2)
 ENDIF

ELSE
 SELECT MXENCCPA
 IF IMPRE
  ESCRIBE(REPLICATE([Ä],84))
  ESCRIBE([TOTAL NETO: ]+TRANS(E_IMPORTE(TOT_NET,EMISION),TRAN14)+SPACE(7)+[CARGOS: ]+;
          TRANS(E_IMPORTE(CARGO,EMISION),TRAN14)+[ TOTAL COMPRA: ]+TRANS(E_IMPORTE(TOT_COM,EMISION),TRAN14))
  ESCRIBE(REPLICATE([Í],84))
 ELSE
  ESCRIBE(REPLICATE([Ä],79),C_TIT2)
  ESCRIBE([NETO:]+STR(E_IMPORTE(TOT_NET,EMISION),15,2)+[   CARGOS:]+STR(E_IMPORTE(CARGO,EMISION),15,2)+SPACE(10)+[  TOTAL: ]+;
          STR(E_IMPORTE(TOT_COM,EMISION),15,2))
  ESCRIBE(REPLICATE([Í],79))
 ENDIF
 ESCRIBE([])
 ESCRIBE([])

ENDIF
STORE 0.00 TO XTOT_CPA,UTOT_CPA,UCARGOS,UTOT_NET
UNA_VEZ=.T.
RETURN


PROCEDURE OPAG0408
