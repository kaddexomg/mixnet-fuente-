PROCEDURE BUSSFO
PRIVATE TCODFOR,TNOMFOR
VERTBUS([UBUSSFO])
KEYBOARD DERECHA
RETURN

PROCEDURE UBUSSFO
CUR_ON()
@ CONTLIN, 2+MARGEN GET BCODFOR    
@ CONTLIN, 9+MARGEN GET BNOMFOR    

READ
CLEAR GETS
CUR_OFF()
SALIR=ESCAPAR() .OR. ( EMPTY(BCODFOR) .AND. EMPTY(BNOMFOR) )
IF !SALIR
 IF !EMPTY(BCODFOR)
  TCODFOR=UPPER(TRIM(BCODFOR))
  YKEY=TCODFOR
 ELSE
  TNOMFOR=UPPER(TRIM(BNOMFOR))
  BCONDICION=[TNOMFOR$NOMFOR]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN


