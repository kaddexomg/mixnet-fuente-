// CREA EL CONTADOR PARA LOS MOVIMIENTOS DE CAJAS...
Function Contador_Caja()
   LOCAL cContador
   PRIVATE cFile:=CE('MXCONBAN.MTD')
   PRIVATE cban_dep:='DP00000001'
   PRIVATE cban_che:='CH00000001'
   PRIVATE cban_tra:='TR00000001'
   PRIVATE cban_cre:='NC00000001'
   PRIVATE cban_deb:='ND00000001'
   PRIVATE cban_anu:='AN00000001'
   PRIVATE cban_caj:='CJ00000001'
   IF file(cFile)
      RESTORE FROM (cFile) ADDITIVE
   ENDIF
   cBan_caj:=prox_simb(cBan_caj)
   SAVE ALL LIKE CBAN_* TO (cFile)
   cContador:=cban_caj
   RELEASE cban_dep,cban_che,cban_tra,cban_cre,cban_deb,cban_anu,cFile,cba_caj
return(cContador)


Function Mas_datos()
PRIVATE GSCR,UCOLOR
UCOLOR=SETCOLOR()
GSCR=SAVESCREEN(CONTLIN+1,0,CONTLIN+4,78)
SETCOLOR(C_TEX1)
BOXSOM([],CONTLIN+1,0,CONTLIN+3,76)
SetCursor(1)
@ CONTLIN+2,1  SAY 'Concepto:' GET xConcepto PICT '@S28'
@ CONTLIN+2,44 SAY 'CContable:' GET xCodCon VALID if(ban_vcco='S', valrefcon (xCodCon),.t.)
Read
SetCursor(0)
RESTSCREEN(CONTLIN+1,0,CONTLIN+4,78,GSCR)
RETURN 0

*MARCA DE MODIFICACION FUNCION INCLUIDA
proc tot_depos
local colant
if strzero(recno(),5)$ii_listasi
 xtot   := xtot+importe
 el_tot := el_tot+importe
 *xtot:=xtot+e_importe(SALDO_DOC,EMISION)
else
 xtot:=xtot-importe
 el_tot:=el_tot-importe
 *xtot:=xtot-e_importe(SALDO_DOC,EMISION)
endif
colant:=setcolor()
setcolor(c_tit1)
@  1,14 say len(ii_listasi)/6 PICT '999'
@  1,28 say trans(el_tot,tran21)
setcolor(colant)
RETURN

PROCEDURE DEPOSITA(CUAL_BANCO)
PRIVATE I_MANUAL
PRIVATE XCODMOVBAN,XFECHA_MOV,XTIPBAN,XNUMDOC,XCONCEPTO,XIMPORTE
PRIVATE XNUMORG,XTIPORG,XMULTICAN,XORIGEN,TT_LISTASI,SALIR,LREG
private modifica:=.f.
IF !EMPTY(II_LISTASI)
 I_MANUAL=.T.
 TT_LISTASI=II_LISTASI
 DEP_IMP=0
 BEGIN SEQUENCE
 DO WHILE .T.
    CTL_MAN()
    DEP_IMP=DEP_IMP+IMPORTE
 ENDDO
 END
 LREG=-1
 SALIR=.F.
 DEFTBA()
 XTIPBAN      = SPACE(  2)
 XNUMDOC      = SPACE(  8)

 XCODMOVBAN := IF( EMPTY(CUAL_BANCO), SPACE(5), CUAL_BANCO)
 XFECHA_MOV = CTOD(G_FECHA)
 LXX=LEN(TT_LISTASI)/6
 IF LXX=1
  IF TYPE('LE_TARJE')='C'
   XCONCEPTO=PAD(LE_TARJE+' UN DOCUMENTO',34)
  ELSE
   XCONCEPTO=UN_CONCEPTO
  ENDIF
 ELSE
  IF TYPE('LE_TARJE')='C'
   if lxx-con_debi=1
    XCONCEPTO=PAD(LE_TARJE+' UN DOCUMENTO',34)
   else
    XCONCEPTO=PAD(LE_TARJE+' '+ALLTRIM(STR(LXX-CON_DEBI,3))+[ DOCUMENTOS],34)
   endif
  ELSE
   XCONCEPTO=PAD([DEPOSITO DE CAJA ]+ALLTRIM(STR(LXX,3))+[ DOCUMENTOS],34)
  ENDIF
 ENDIF

 XIMPORTE   = DEP_IMP
 XTIPBAN    = [DP]
 STORE [] TO XTIPORG,XNUMORG
 XMULTICAN=.F.
 SELECT MXTRABAN
 CUR_ON()
 OFF_KEY()
 GETTBA()
 CUR_OFF()
 IF !SALIR
  ADD_REC(0)
  ARC_BAN()
  SELECT MXTRACAJ
  II_LISTASI=TT_LISTASI
  BEGIN SEQUENCE
  WHILE .T.
   CTL_MAN()
   REC_LOCK(0)
   REPLACE CODBAN WITH XCODMOVBAN, DEPOSITO WITH XNUMDOC, FECHA_DEP WITH XFECHA_MOV
   UNLOCK
   Act_Caja(codcaj,-importe,0)
  ENDDO
  END
 ENDIF
 SELECT MXTRABAN
 POSPAG(RECNO())
ENDIF
ON_KEY()
SELECT MXTRACAJ
RETURN

