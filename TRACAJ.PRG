PROCEDURE UBUSCAJ
* BUSQUEDA
@ CONTLIN, 2 GET XFECHA_CAJ VALID !CHK_BLOCK(XFECHA_CAJ)
@ CONTLIN,13 GET XORIGEN  PICT [@!]
@ CONTLIN,17 GET XTIPORG  PICT [@!]
@ CONTLIN,20 GET XNUMORG
@ CONTLIN,29 GET XFORMAPAG PICT [@!]
@ CONTLIN,42 GET XNUMPAG PICT "@S14"
@ CONTLIN,54 GET XNOMPAG PICT "@S14"
@ CONTLIN,66 GET XIMPORTE   PICT PIC12
leer()
SALIR=ESCAPAR()
IF !SALIR

  POR_INDICE=.F.
  IF !EMPTY(XFECHA_CAJ)
   YKEY=DTOS(XFECHA_CAJ)+IF(!EMPTY(XORIGEN),XORIGEN,[])
   POR_INDICE=.T.
  ENDIF

  BCONDICION=IF(EMPTY(XTIPORG),[.T.],[TIPORG=XTIPORG])+IF(EMPTY(XNUMORG),[],[.AND.NUMORG=XNUMORG])+;
  IF(EMPTY(XFORMAPAG),[],[.AND.FORMAPAG=XFORMAPAG])+IF(EMPTY(XNUMPAG),[],[.AND.NUMPAG=XNUMPAG])+;
  IF(EMPTY(XNOMPAG),[],[.AND.NOMPAG=XNOMPAG])+IF(EMPTY(XIMPORTE),[],[.AND.IMPORTE=XIMPORTE])

  POR_AMBOS=!BCONDICION==[.T.] .AND. POR_INDICE

ENDIF
RETURN

