STATIC FUNCTION CUADREDIARIO()
 Local colant:=setcolor()
 Local nLinBox:=6,nColBox:=20,dscrn
 Local nRecno:=Recno(),Fi:=CTOD(G_FECHA),Ff:=CTOD(G_FECHA),nCursor:=SetCursor()
 Private SumPos,SumNeg
 dscrn:=savescreen(nLinBox,ncolBox,nLinBox+10,nColBox+41)
 DO WHILE .T.
    BOXSOM('',nLinBox,ncolBox,nLinBox+8,nColBox+35,1)
    SETCURSOR(1)
    setcolor(c_ACHOICE)
    @ nLinBox+1,nColBox+1 SAY 'Fecha Inicial:' GET FI
    @ nLinBox+2,nColBox+1 SAY 'Fecha Final..:' GET FF
    READ
    IF LASTKEY()= 27
       DBGOTO(nRecno)
       EXIT
    ENDIF
    SET ORDER TO 1
    IF DBSEEK(DTOS(FI))
       SUMPOS:=0
       SUMNEG:=0
       DO WHILE FECHA_CAJ <= FF .AND. !EOF()
          IF(IMPORTE>0,SUMPOS:=SUMPOS+IMPORTE,'')
          IF(IMPORTE<0,SUMNEG:=SUMNEG+IMPORTE,'')
          DBSKIP()
       ENDDO
       SETCOLOR(C_TIT1)
       @ nLinBox+4,nColBox+1 SAY "TOTAL INGRESOS: "+TRANS(SUMPOS,LATI17)
       @ nLinBox+5,nColBox+1 SAY "TOTAL EGRESOS.: "+TRANS(SUMNEG,LATI17)
       @ nLinBox+6,nColBox+1 SAY "================================="
       @ nLinBox+7,nColBox+1 SAY "DIFERENCIA....: "+TRANS(SUMPOS+SUMNEG,LATI17)
       esperar()
    ELSE
      ALERTA("IMTERVALO NO FUE ENCONTRADO...")
    ENDIF
    DBGOTO(nRecno)
    setcolor(colant)
    RESTSCREEN(nLinBox,ncolBox,nLinBox+10,nColBox+41,dscrn)
    EXIT
 ENDDO
 RESTSCREEN(nLinBox,ncolBox,nLinBox+10,nColBox+41,dscrn)
 SETCURSOR(nCursor)
RETURN NIL


FUNCTION SERVCAJA(X1,X2,X3)
   Local ultSel:=Select()
   DO WHILE .T.
      IF ABRIR("MXCTASER",MXCTASER,"S",MXCTSEX1,MXCTSEX2)
         EDIT_VENTANA("CAJSERV")
         IF LASTKEY()=27
            EXIT
         ENDIF
         X1 := PAD(MXCTASER->NOMSER,35)
         X2 := MXCTASER->REFCON
         X3 := MXCTASER->PRESER
         EXIT
      ELSE
         ALERTA("NO PUDO ACCEDER A LA TABLA DE SERVICIOS...")
          EXIT
      ENDIF
   ENDDO
   CERRAR("MXCTASER")
   DBSELECTAR(UltSel)
RETURN .T.




