PROCEDURE GETBRAL
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC
FFF=ROW()
CCC=COL()
yfactor=1
CHKU=.F.
DO CASE
CASE ICAMPO=1
 @ FFF,CCC GET XITEM VALID CHKALITEM()
CASE ICAMPO=2  .AND. !EMPTY(XITEM)
 @ FFF,CCC GET XUNIDAD VALID SEL_UNI(UNIREF,@XUNIDAD,CHKU)
CASE ICAMPO=3  .AND. !EMPTY(XITEM)
 @ FFF,CCC GET XIVA    PICT "!" VALID CHKIVA(XIVA)
CASE ICAMPO=4  .AND. !EMPTY(XITEM)
 @ FFF,CCC GET XBULTO     PICT "99999" VALID XBULTO>0
CASE ICAMPO=5  .AND. !EMPTY(XITEM)
 @ FFF,CCC GET XCANTIDAD  PICT "999999.999" VALID VALCAN1(CAMBUL(XCANTIDAD,xbulto))
CASE ICAMPO=6  .AND. !EMPTY(XITEM)
 @ FFF,CCC GET XPRECIO    PICT cMasPrecAlb VALID XPRECIO>0 .AND. CAMBUL(XCANTIDAD,XBULTO)*XPRECIO<89999999.99
CASE ICAMPO=7  .AND. !EMPTY(XITEM)
 @ FFF,CCC GET XDESC      PICT "999.99"  VALID XDESC>=0 .AND. XDESC<=100.00
CASE ICAMPO=8
 @ FFF,CCC GET XDESCRIP PICT '@S35'
OTHERWISE
 SALIR=.T.
 RETURN
ENDCASE
READ
SALIR=ESCAPAR(1)
FUTREN()

RETURN

