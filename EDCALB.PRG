STATIC FUNCTION INC_PEDALB

private tiene,ulias,Z_NUMERO

tiene = .f.
ulias = select()
IF ABRIR("MXENCPED",MXENCPED,[S],MXENPEX3)
 SEEK(XCLIENTE)
 IF FOUND()
  if vtas_autor='S'
     IF !EMPTY(XCODSUC)
        COPY TO (BUFCON) WHILE CLIENTE = XCLIENTE FOR ESTATUS<>'OK' .AND. autorizado='S' .AND. CODSUC=XCODSUC
     ELSE
        COPY TO (BUFCON) WHILE CLIENTE = XCLIENTE FOR ESTATUS<>'OK' .AND. autorizado='S'
     ENDIF
  else
     IF !EMPTY(XCODSUC)
        COPY TO (BUFCON) WHILE CLIENTE = XCLIENTE FOR ESTATUS<>'OK' .AND. CODSUC=XCODSUC
     ELSE
        COPY TO (BUFCON) WHILE CLIENTE = XCLIENTE FOR ESTATUS<>'OK'
     ENDIF
  endif
  IF ABRIR("BUFcon",bufcon,[S])
   if !eof()
    tiene=.t.
    Z_NUMERO=SPACE(8)
    satelite([ PEDIDOS ],'NUMPED','CODSUC','EMISION', 'FACSELPROG',LISTAPED)
    CERRAR("BUFCON")
    delete file (BUFCON)
    IF !EMPTY(Z_NUMERO)
     IF ABRIR("MXRENPED",MXRENPED,[S],MXREPEX1)
      SEEK(Z_NUMERO)
      IF !FOUND()
       CERRAR("MXRENPED")
      ELSE
       COPY TO (BUFPED) WHILE NUMPED=Z_NUMERO
       CERRAR("MXRENPED")
       ABRIR([BUFPED],BUFPED,[E])
       REPLACE ALL CANTIDAD WITH CANTIDAD-DESPACHO,;
                   PRECIO   WITH IF(XRECARGO$"N2",PRECIO+(PRECIO*IVA(IVA,XEMISION)/100),CALPRECIO() ),;
                   BULTO    WITH IF(BULTO=1,1,BULTO-DESBULTO),;
                   TOT_REN  WITH ROUND(CAMBUL(CANTIDAD,IF(PV_MUL='S',BULTO,1))*PRECIO*(1-DESC/100),3)
       DELETE FOR CANTIDAD=0 .AND. !EMPTY(ITEM)
       //DELETE FOR TOT_REN=0 .AND. !EMPTY(ITEM)
       PACK
       DBGOTOP()
       DBEVAL(BLK("Ex_Virtual(item,cantidad,'BUFFER')"),,BLK("!EOF()"))
       cerrar("BUFPED")
      *******************************************************
       SELECT BUFFER
       APPEND FROM (BUFPED)
       DELETE FILE (BUFPED)

       VER_EX(1)

       IF EN_MENUH
        GO TOP
        NOFLECHA()
        PRIPAG()
        RECAALB()
       ELSE
        RECALCULA:=.T.
       ENDIF

      ENDIF
     ENDIF
    ENDIF
   ELSE
    CERRAR("BUFCON")
   endif
  endif

 ENDIF
 if !tiene
  PARE("Cliente no tiene PEDIDOS")
 endif
ENDIF
CERRAR("MXENCPED")
SELECT (ULIAS)

RETURN 0


