PRIVATE WNUMALB,MODIFICA
MODIFICA=.T.
LNUMALB   = NUMALB
SELECT MXRENALB
IF DBSEEK(LNUMALB)
 STORE [] TO LISTAPED,LISTACOT
 DO WHILE !EOF() .AND. NUMALB=LNUMALB
  IF !NUMPED$LISTAPED .AND. !EMPTY(NUMPED)
   LISTAPED=NUMPED+[/]+LISTAPED
  ENDIF
  IF !NUMCOT$LISTACOT .AND. !EMPTY(NUMCOT)
   LISTACOT=NUMCOT+[/]+LISTACOT
  ENDIF
  SKIP
 ENDDO
ENDIF
SELECT MXRENALB
