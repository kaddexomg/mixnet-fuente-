PROCEDURE GETALB
* CAPTURA REGISTRO
private ed_renglon

SET KEY -7  TO
SET KEY 279 TO

DO WHILE .T.
 ED_RENGLON:=.F.
 IF !DUPLI_DOC
  KEYBOARD SALIDA+IF(PV_EDN='S',SALIDA,'')
 ENDIF
 ED_RENGLON:=.F.
 IF PV_EDN='N'.AND.!MODIFICA
  @ 3,15 SAY SPACE(10)
 ENDIF

 IF vtas_mdcli='N'
    SET KEY -9 TO TOMA_DATO1()
    MENSAJ('F10 = Mas datos del '+IF(GESTION='VEN','Cliente','Proveedor'))
 ENDIF

 @  3,15 GET XNUMALB  PICT [@!] WHEN PV_EDN='S' VALID CHK_CLAVE(XNUMALB,NOMBRE_DOC)
 @  3,32 GET XEMISION VALID CHKEJER(XEMISION)  .AND. !CHK_BLOCK(XEMISION)
 @  3,54 GET XCAMBIO PICT '9999.99' WHEN vtas_edcamb='S' VALID !Empty(xcambio)
 @  7,11 SAY Xestatus
 @  4,15 GET XCLIENTE VALID IF(XCLIENTE='CONTADO',.T.,CHCLI(@XCLIENTE))
 @  4,25 GET XNOMCLI VALID TOMA_DATO1(vtas_mdcli) PICT "@S35"
 @  4,74 GET Xcodsuc  WHEN hay_sucursal VALID BSucursal(@xcodsuc,5,50)
 @  5,15 GET XCODVEN VALID CHVEN(XCODVEN,5,25)
 @  7,63 GET XRECARGO pict '!' VALID XRECARGO$'SN01234'
 @  5,74 GET XTRANSPOR pict '!!' VALID CHTRP(XTRANSPOR)
 @  6,74 GET XALMACEN pict '!!' when g_multi .and. ustr_edalm='S' .and. vtas_almren='N' VALID CHALM(XALMACEN) .and. chk_baf(xalmacen,xemision)
 @  7,74 GET XTARIFA
 @  6,15 GET XCOMEN1
 @  7,15 GET XCOMEN2
 LEER()
 IF ESCAPAR()
  IF ENTRO
   DO BELL
   IF DECIS([¨ Desea cancelar la operaci¢n ?],1)=[S]
    SALIR=.T.
   ELSE
    LOOP
   ENDIF
  ELSE
   SALIR=.T.
  ENDIF
 ENDIF
 IF SALIR
  SET KEY -7 TO DUP_ALB
  DUPLI_DOC:=.F.
  IF PV_EDN='S'
   //CANCNUM(MXNUMALB,XNUMALB)
   CANCNUM(CFILNUM,XNUMALB)
  ENDIF
  SET KEY 279 TO REIMPRIM
  RETURN
 ENDIF
 IF EMPTY(XCLIENTE)
  KEYBOARD REPLICATE(SALIDA,2)
  LOOP
 ENDIF
 WHILE G_MULTI .AND. EMPTY(XALMACEN) .and. vtas_almren='N'
  @  6,74 GET XALMACEN pict '!!' When ustr_edalm='S' .and. vtas_almren='N' VALID CHALM(XALMACEN) .and. chk_baf(xalmacen,xemision)
  LEER()
 END
 ENTRO=.T.
 @  7,63 say XRECARGO
 @  7,74 SAY XTARIFA
 IF ABRIR([MXCTASER],MXCTASER,[S],MXCTSEX1)
 IF ABRIR([BUFFER],BUFFER,[E])
  IF DUPLI_DOC
   REPLACE ALL NUMPED WITH ''
   VER_EX(1)
   DUPLI_DOC:=.F.
  ENDIF
  RECAALB()
  GO TOP

  IF CONFORME<>'N'
   listaserial({||s_origen=='ALB'.and.s_numero==xnumalb})
  ENDIF

  CLEAR TYPEAHEAD

  SETCOLOR(C_TEX2)
  AL_TOTAL()
  SETCOLOR(C_TIT2)

   ed_renglon=.t.

   set key 287 to serializa
   SET KEY -7 TO SER0000
   SET KEY -8 TO albopcion
   SET KEY -9 TO ALBOPCION
   ustre:='USTREVEN'+Alltrim(Str(subopcion))
   ClvT:=&ustre
   &ustre.:='SSS'
   nTReg := LastRec()
   EDC([RAL],[],RSUBTIT,RCAMPO,.T.,.T.,.T.,.F.,.F.,.t.,.t.,.F.,'Alt-S=SERIALES  F8=SERVICIOS  F9=PEDIDOS  F10=COTIZACIONES <ESC>=GRABAR',.T.)
   &ustre.:=ClvT

   SET KEY -9 TO
   SET KEY -8 TO
   SET KEY -7 TO
   set key 287 to

   IF XSALDO+XTOT_ALB>XLIMITE .AND. DIFCERO(XLIMITE)
    PARE('PRECAUCION. L¡mite de cr‚dito: '+alltrim(str(xlimite,10))+' saldo + total : '+alltrim(str(xsaldo+xtot_ALB)) )
   ENDIF
   SELECT BUFFER
   GO TOP
   XPORCDE:=0
   XDESCUE:=0
   DO WHILE !EOF()
      IF SUBSTR(ITEM,1,2)="*D"
         XPORCDE:=DESC
         XDESCUE:=TOT_REN
         EXIT
      ENDIF
      DBSKIP()
   ENDDO
   GO TOP
   IF  LASTREC()=0 .OR. EOF()
    SELECT MXENCALB
    DO PANALB
    CONFORME='N'
   ELSE
    nTReg:=LastRec()
    IF nTReg>0 .AND. pv_rengpag > 0 .AND. nTReg > pv_rengpag
       Alerta('SE INCLUYERON MAS RENGLONES QUE EL LIMITE POR RENGLONES ACEPTADO...')
       Alerta('LIMITE = '+ALLTRIM(STR(pv_rengpag,2))+' REGISTRO(S), DEBE BORRAR='+alltrim(str(ABS(PV_RENGPAG-nTReg))))
       CONFORME='N'
    ELSE
       CALC_IVA()
       ESCVENC(@XVENCE)
       CONFORME=CONFIRMA()
    ENDIF
   ENDIF
   DO CASE
    CASE CONFORME='S'
     IF PV_EDN='N'.AND.!MODIFICA
      //XNUMALB:=PROXINUM(MXNUMALB)
      XNUMALB:=PROXINUM(CFILNUM)
     ENDIF
     SELECT MXENCALB
     XNUMALB:=NEW_NUM(XNUMALB)
     SELECT BUFFER
     REPLACE ALL  NUMALB WITH XNUMALB , EMISION WITH XEMISION,cliente with xcliente,codsuc with xcodsuc
    CASE CONFORME='C'
     IF PV_EDN='S'
      //CANCNUM(MXNUMALB,XNUMALB)
      CANCNUM(CFILNUM,XNUMALB)
     ENDIF
   ENDCASE

   CERRAR([BUFFER])
 ENDIF
 CERRAR('MXCTASER')
 ENDIF
 EXIT
ENDDO
SET KEY -7 TO DUP_ALB
SET KEY 279 TO REIMPRIM
SELECT MXENCALB
RETURN

