FUNCTION CHKALITEM
LOCAL PRICHAR
IF LASTKEY()=5
 RETURN .T.
ENDIF
UNIREF = []
CHKU   = .F.
ES_D   = .F.
PRICHAR=SUBSTR(XITEM,1,1)
DO CASE
 CASE PRICHAR$[*]
  xpeso:=0
  xRAlmacen:=Space(2)
  IF SUBSTR(XITEM,2,1)=[D]
   ES_D=.T.
   XDESCRIP=PAD([* DESCUENTO *],50)
   STORE 0 TO XBULTO,XCANTIDAD
   XIVA=' '
   XDESC=0
  ENDIF
  RETURN .T.
 CASE PRICHAR$[\]
  SELE MXCTASER
  IF !DBSEEK(SUBSTR(XITEM,2,5))
   SER0000()
   SELE BUFFER
   RETURN .F.
  ELSE
   XDESCRIP=PAD(MXCTASER->NOMSER,50)
   XPRECIO=MXCTASER->PRESER
   LPRECIO=MXCTASER->PRESER
   XIVA   =MXCTASER->IVA
   xRAlmacen:=Space(2)
   if !modifica
      if pv_cccli='N'
         XCODCON:=mxctainv->codcon
      else
         xcodcon:=mxctacli->codcon
      endif
   endif
   CHKU=.F.
   if vtas_almren='S'
      KEYBOARD REPLICATE(SALIDA,1)
   else
      IF vtas_pbul='S'
         KEYBOARD REPLICATE(SALIDA,3)
      ELSE
         KEYBOARD REPLICATE(SALIDA,4)
      ENDIF
   endif
  ENDIF
  SELE BUFFER
OTHERWISE
  SELECT MXCTAINV
  SET ORDER TO 1
  LO_ENCONTRO:=.F.
  IF EMPTY(XITEM)
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       xRAlmacen:=Space(2)
       RETURN .T.
    ENDIF
    SELECT BUFFER
    RETURN .F.
  ENDIF
  IF DBSEEK(XITEM)
     LO_ENCONTRO:=.T.
  ELSE
     // LO_ENCONTRO:=.F.
     LO_ENCONTRO:=CHEQ_CODEXT()
  ENDIF
  IF LO_ENCONTRO
    STORE UNIDAD TO XUNIDAD,UNIREF
    CHKU=.T.
    XITEM      := CODART
    XEXMIN     := MXCTAINV->EXMIN
    XEXMAX     := MXCTAINV->EXMAX
    XDESCRIP   := PAD(MXCTAINV->NOMART,50)
    XIVA       := MXCTAINV->IVA
    XULT_COSTO := MXCTAINV->ULT_COSTO
    if !modifica
       if pv_cccli='N'
          XCODCON:=mxctainv->codcon
       else
          xcodcon:=mxctacli->codcon
       endif
    endif
    if pv_asc='S'
       xprecio    := MXCTAINV->costo_act
       lprecio    := xprecio
    else
       IF !MODIFICA
          if vtas_almren='S'.and. vtas_lisalm='S'
             GET_TARIFA(xralmacen)
          else
             GET_TARIFA()
          endif
          LPRECIO:=XPRECIO
          XCANTIDAD  = IF(MXCTAINV->CAN_BUL>0,MXCTAINV->CAN_BUL,1)
       ELSEIF MODIFICA .AND. MITEM <> XITEM
          if vtas_almren='S'.and. vtas_lisalm='S'
             GET_TARIFA(xralmacen)
          else
             GET_TARIFA()
          endif
          LPRECIO:=XPRECIO
       ENDIF
    endif
  ELSE
     SET ORDER TO 2
     IF DBSEEK(XITEM)
        LO_ENCONTRO:=.T.
     ELSE
        LO_ENCONTRO:=.F.
     ENDIF
  ENDIF
  SET ORDER TO 1
  IF LO_ENCONTRO
    STORE UNIDAD TO XUNIDAD,UNIREF
    CHKU=.T.
    XITEM      := CODART
    XEXMIN     := MXCTAINV->EXMIN
    XEXMAX     := MXCTAINV->EXMAX
    XDESCRIP   := PAD(MXCTAINV->NOMART,50)
    XIVA       := MXCTAINV->IVA
    XULT_COSTO := MXCTAINV->ULT_COSTO
    if !modifica
       if pv_cccli='N'
          XCODCON:=mxctainv->codcon
       else
          xcodcon:=mxctacli->codcon
       endif
    endif
    if pv_asc='S'
       xprecio    := MXCTAINV->ult_costo
    else
       IF !MODIFICA
          if vtas_almren='S'.and. vtas_lisalm='S'
             GET_TARIFA(xralmacen)
          else
             GET_TARIFA()
          endif
          LPRECIO:=XPRECIO
          XCANTIDAD  = IF(MXCTAINV->CAN_BUL>0,MXCTAINV->CAN_BUL,1)
       ELSEIF MODIFICA .AND. MITEM <> XITEM
          if vtas_almren='S'.and. vtas_lisalm='S'
             GET_TARIFA(xralmacen)
          else
             GET_TARIFA()
          endif
          LPRECIO:=XPRECIO
       ENDIF
    endif
  ENDIF
  IF !LO_ENCONTRO
    SELINFINV()
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       RETURN .T.
    ENDIF
     SELECT BUFFER
     RETURN .F.
  ELSE
     SELECT BUFFER
     if vtas_almren='S'
        KEYBOARD REPLICATE(SALIDA,1)
     else
       IF vtas_pbul='S'
          KEYBOARD REPLICATE(SALIDA,3)
       ELSE
          KEYBOARD REPLICATE(SALIDA,4)
       ENDIF
     endif
  ENDIF
ENDCASE
SELECT BUFFER
RETURN .T.

PROCEDURE GETRAL
* CAPTURA REGISTRO
MENSAJ([<ENTER>=INVENTARIO  F8=SERVICIOS  F9=PEDIDOS  F10=COTIZACIONES  <ESC>=SALIR],MAXROW())
ES_D    = .F.
CHKU    = .F.
YFACTOR =  1
IF !MODIFICA .AND. vtas_serv='S'
   xITEM:=Pad('\',15)
ENDIF
nTreg:=Lastrec()
IF !MODIFICA .AND. nTReg>0 .AND. pv_rengpag > 0 .AND. nTReg >= pv_rengpag
   Alerta('SE HA REBASADO EL LIMITE DE RENGLONES POR PAGINA, NO PUEDE CONTINUAR INCLUYENDO REGISTROS...')
   salir:=.t.
   RETURN salir
ENDIF
SET KEY  281  TO RECALPRE   // Alt-P
@ CONTLIN, 2 GET XITEM WHEN !VIENE_PED.OR.!VIENE_COT PICT ITEM_MASK VALID CHKALITEM() .AND. BOfertas({xitem,xcliente,xcodsuc,xemision},@XPRECIO)
@ MAXROW()-5,7 GET XDESCRIP PICT '@S35'
@ CONTLIN,18 GET XRALMACEN pict '!!' WHEN w1().and.w2().and.if(vtas_almren='S',exialm(@xralmacen),.t.).and.g_multi.and.ustr_edalm='S'.and.vtas_almren='S'  VALID CHALM(XRALMACEN) .and. chk_baf(xralmacen,xemision)
@ CONTLIN,21 GET XUNIDAD    WHEN W1() PICT [!!!] VALID SEL_UNI(UNIREF,@XUNIDAD,CHKU)
@ CONTLIN,25 GET XIVA       PICT '!'  WHEN W1() VALID CHKIVA(XIVA)
@ CONTLIN,27 GET XBULTO     WHEN W1() PICT "99999" VALID XBULTO>0
@ CONTLIN,33 GET XCANTIDAD  WHEN W1() PICT "99999999.999" VALID VALCAN1(CAMBUL(XCANTIDAD,XBULTO)*YFACTOR)
@ CONTLIN,46 GET XPRECIO    WHEN W1().AND.PV_PVP='S' PICT cMasPrecAlb VALID VALPRE()
@ CONTLIN,59 GET XDESC      PICT "999.99"  VALID XDESC>=0 .AND. XDESC<=100.00
READ
SET KEY  281  TO

nTReg:=LastRec()
IF !MODIFICA .AND. nTReg>0 .AND. pv_rengpag > 0 .AND. nTReg >= pv_rengpag
   Alerta('SE HA REBASADO EL LIMITE DE RENGLONES POR PAGINA, NO PUEDE CONTINUAR INCLUYENDO REGISTROS...')
   salir:=.t.
   RETURN salir
ENDIF

IF CHR(LASTKEY())=PGDN
 if W1()
  keyboard ''
  salir:=!VALCAN1(CAMBUL(XCANTIDAD,XBULTO)*yfactor)
 endif
else
 SALIR=ESCAPAR().or.ABS(cambul(xcantidad,xbulto)*Xprecio*YFACTOR)>=VAL(PIC12)
endif
/*
futren()
IF !SALIR .AND. !EMPTY(XITEM) .AND. PV_CODCON='S'
 CUENTACON()
ENDIF
*/
if !Empty(xitem) .and. !SubStr(xitem,1,2)$'*D'
 RestarIva()
endif
IF !SALIR .AND. !EMPTY(XITEM) .AND. pv_codcon$[S]
 xcodcon:=if(modifica,BUFFER->codcon,xcodcon)
 CuentaCon()
ENDIF
futren()

RETURN

STATIC FUNC W1
RETURN(!EMPTY(XITEM).AND.!ES_D)

STATIC FUNC W2
RETURN(!SUBSTR(XITEM,1,1)$'\*')

static proc futren
IF !SALIR
 if empty(xitem)
  STORE 0 TO XBULTO,XCANTIDAD,XPRECIO,XTOT_REN,XDESC
  XIVA=   ' '
  XUNIDAD='   '
 ELSE
  IF CHKU
   XUNIDAD   = UNIREF
   XCANTIDAD = XCANTIDAD*YFACTOR
  ENDIF
  XPRECIO  := CAMBIO_IMPORTE(XPRECIO,Xemision)

  // XTOT_REN := ROUND( CAMBUL(XCANTIDAD,XBULTO)*XPRECIO*(1-(XDESC/100.00)),G_REDONDO)     ANTERIOR

  // NUEVA FORMA
  XTOT_REN := ROUND(CAMBUL(XCANTIDAD,XBULTO)*XPRECIO,3)
  IF XDESC>0
     XTOT_REN := ROUND(XTOT_REN-(XTOT_REN*XDESC/100),3)
  ENDIF
  ////////

  IF ES_D
     XTOT_REN:=-ROUND(DIV(XTOT_ALB*XDESC,100),2)
     if xtot_ren=0
        @ CONTLIN,66 GET XTOT_REN PICT cMasPrecAlb
        READ
        XDESC := ABS(ROUND(DIV(XTOT_REN,XTOT_ALB)*100,G_REDONDO))
        XTOT_REN:=XTOT_REN*-1
     endif
     XDESCUE:=XTOT_REN
     XPORCDE:=XDESC
  endif
  @ CONTLIN,66 SAY XTOT_REN  PICT cMasPrecAlb
 ENDIF
ENDIF
RETURN

