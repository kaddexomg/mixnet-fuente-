FUNCTION GEN_ALBINV
PRIVATE XPALMACEN,XORIGEN,XCANTIDAD,XUNIDAD,XITEM ,ACT_PED, ACT_COT, YDESPACHO,XBULTO
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)
* GENERA MOVIMIENTOS DE INVENTARIO
ACT_PED=.F.
ACT_COT:=.F.
IF ABRIR([MXCTAINV],MXCTAINV,[S],MXCTINX1)
 IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
 IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX1,MXTRINX2,MXTRINX3)
   *** PEDIDOS  COTIZACION
   ACT_PED=!EMPTY(LISTAPED)
   ACT_COT=!EMPTY(LISTACOT)
   IF ACT_PED
    ABRIR("MXRENPED",MXRENPED,[S],MXREPEX2,MXREPEX1)
   ENDIF
   IF ACT_COT
    ABRIR("MXRENCOT",G_CAMINO+[MXRENCOT.DBF],[S],G_CAMINO+[MXRECZX2.NTX],G_CAMINO+[MXRECZX1.NTX])
   ENDIF
   *****************************************
   SELECT MXRENALB
   SEEK(XNUMALB)
   PALMACEN:=XALMACEN
   DO WHILE !EOF() .AND. NUMALB=XNUMALB
     XITEM=ITEM
     XCODMOVART = ITEM
     XFECHA_MOV = XEMISION
     XTIPINV    = if(cantidad<0,'DV','SA')
     XNUMDOC    = XNUMALB
     XUNIDAD    = UNIDAD
     XCANTIDAD  = ABS(CAMBUL(CANTIDAD,BULTO))
     XBULTO     = BULTO
     XCOSTO_TOT = 0
     XVENTA_TOT = 0
     XORIGEN    = [ALB]
     XPROV_CLI  = XCLIENTE
     YNUMPED    = NUMPED
     YNUMCOT    = NUMCOT
     xCODCON    = CODCON
     xCODDPTO   = CODDPTO
     xalmacen  := if(vtas_almren='S'.and.!empty(almacen),almacen,palmacen)
     SELECT MXCTAINV
     IF DBSEEK(XITEM)
      DO MENSAJ WITH [Generando movimiento en INVENTARIO ...]
      SELECT MXTRAINV
      ADD_REC(0)
      ARC_INV()
     ENDIF
     IF ACT_PED
        ARC_PED(YNUMPED)
     ENDIF
     IF ACT_COT
        ARC_COT(YNUMCOT)
     ENDIF
     SELECT MXRENALB
     SKIP
   ENDDO
   CERRAR([MXTRAINV])
 ENDIF
 CERRAR([MXEXTINV])
ENDIF
CERRAR([MXCTAINV])
ENDIF
IF ACT_PED
 ACTUALPED()
 CERRAR("MXRENPED")
ENDIF
IF ACT_COT
 ACTUALCOT()
 CERRAR("MXRENCOT")
ENDIF
RETURN 0

STATIC FUNCTION RE_GENALB(EL_NUM)

PRIVATE YCANTIDAD,ACT_PED, ACT_COT, YNUMPED,YNUMCOT, YBULTO, YTIPINV
* REVERSA MOVIMIENTOS DE INVENTARIO
ACT_PED=.F.
ACT_COT:=.F.
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)

IF ABRIR([MXCTAINV],MXCTAINV,[S],MXCTINX1)
  IF ABRIR([MXEXTINV],MXEXTINV,[S],MXEXINX1)
  IF ABRIR([MXTRAINV],MXTRAINV,[S],MXTRINX3)

  *** PEDIDOS
   ACT_PED=!EMPTY(LISTAPED)
   IF ACT_PED
    ABRIR("MXRENPED",MXRENPED,[S],MXREPEX2,MXREPEX1)
   ENDIF

   *** COTIZACIONES
   ACT_COT=!EMPTY(LISTACOT)
   IF ACT_COT
    ABRIR("MXRENCOT",G_CAMINO+[MXRENCOT.DBF],[S],G_CAMINO+[MXRECZX2.NTX],G_CAMINO+[MXRECZX1.NTX])
   ENDIF

   SELECT MXRENALB
   SEEK(EL_NUM)
   DO WHILE !EOF() .AND. NUMALB=EL_NUM
    XITEM=ITEM
    if vtas_pedxc='S'
       YCANTIDAD  := CANTIDAD
    else
       YCANTIDAD  := CAMBUL(CANTIDAD,BULTO)  //  estas es la original
    endif
    YTIPINV    := IF(YCANTIDAD>0,'SA','DV')
    YBULTO     = BULTO
    YNUMPED    = NUMPED
    YNUMCOT    = NUMCOT

    SELECT MXTRAINV
    IF DBSEEK(EL_NUM+YTIPINV+XITEM+"ALB")
     Do while numdoc+tipinv+codmovart+origen=el_num+ytipinv+xitem+"ALB" .AND. !eof()
       DO MENSAJ WITH [Reversando movimiento en INVENTARIO ARTICULO: ]+Alltrim(xitem)
       REV_INV()
       SELECT MXTRAINV
       REC_LOCK(0)
       DELETE
       UNLOCK
       DbSkip()
     Enddo
    ENDIF
    IF ACT_PED
     REV_PED(YNUMPED)
    ENDIF
    IF ACT_COT
     REV_COT(YNUMCOT)
    ENDIF
    SELECT MXRENALB
    SKIP
   ENDDO
   CERRAR([MXTRAINV])
  ENDIF
  CERRAR([MXEXTINV])
 ENDIF
 CERRAR([MXCTAINV])
ENDIF
IF ACT_PED
 ACTUALPED()
 CERRAR("MXRENPED")
ENDIF
IF ACT_COT
 ACTUALCOT()
 CERRAR("MXRENCOT")
ENDIF

RETURN 0


