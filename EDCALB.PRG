Function Ex_Virtual(pItem,pCantidad,pBuff)
   Local lValue:=.t.,uSel:=Select(),uReg,nExi,cStr
   Private nQtyBuf:=0
   nExi:=0
   SELECT MXCTAINV
   IF DBSEEK(pItem)
      nExi:=Exist(xEmision,xAlmacen)
   ENDIF
   DBSELECTAR(pBuff)
   DBGOTOP()
   DBEVAL({||nQtyBuf:=nQtyBuf+CANTIDAD},,{||!EOF()})
   IF (nExi-nQtyBuf) <pCantidad
      cStr:='EXISTENCIA FISICA:'+convstr(nExi)+', CANTIDAD EN BUFFER:'+convstr(nQtyBuf)+;
            ', EXISTENCIA VIRTUAL:'+convstr(nExi-nQtyBuf)+', CANTIDAD EN PEDIDO:'+convstr(pCantidad)+;
            ', RENGLON DEBERIA SER:'+convstr(nExi-nQtyBuf)
      Alerta(cStr)
      DBSELECTAR(uSel)
      IF DECIS('¨DESEA REALIZAR EL AJUSTE CONVENIENTE ? ',1)='S'
         REPLACE CANTIDAD WITH (nExi-nQtyBuf)
         DBCOMMIT()
      ENDIF
   ENDIF
   DBSELECTAR(uSel)
Return lValue



