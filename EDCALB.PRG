STATIC FUNCTION VALCAN1(CANT)
LOCAL EXI,EXI1,BCANT:=0,breg

IF LASTKEY()=5
 RETURN .T.
ENDIF

IF CANT=0
 RETURN .F.
ENDIF

if vtas_almren='S'
   xalmacen:=xralmacen
endif

IF CHKU
 SELECT BUFFER

 BREG=RECNO()
 SUM CAMBUL(CANTIDAD,BULTO) TO BCANT FOR ITEM=XITEM
 GOTO BREG

 IF MODIFICA
  BCANT:=BCANT-CAMBUL(CANTIDAD,BULTO)
 ENDIF

 IF CANT>0
   XEXMIN:=IF(XEXMIN=NIL,IF(MXCTAINV->(DBSEEK(XITEM)),MXCTAINV->EXMIN,0),XEXMIN)
   EXI:=EXIST(XEMISION,XALMACEN)+IF(ENTROXMOD.and.MODIFICA,CANTIDAD,0) ;
       -IF(ENTROXMOD,0,BCANT)
   EXI1:=EXIST(XEMISION)+IF(ENTROXMOD.and.MODIFICA,CANTIDAD,0) ;
       -IF(ENTROXMOD,0,BCANT)
   IF (EXI1-CANT)<XEXMIN
      PARE([Atenci¢n: la existencia quedara por debajo del minimo])
   ENDIF

   IF CANT > (exi + bcant)
    PARE("Existencia en almac‚n "+alltrim(XALMACEN)+" al "+DTOC(XEMISION)+" = "+LTRIM(TRANS(EXI,'9,999,999.999')))
    IF PV_NEG='N'
      RETURN .F.
    ENDIF
    KEYBOARD ''
   ENDIF
 ENDIF
 if vtas_almren='S' .and. vtas_lisalm='S'
    TOMAR_TARIFA(XITEM,XRALMACEN,CANT)
 else
    TOMAR_TARIFA(XITEM,XTARIFA,CANT)
 endif
* GERBER -> TOMAR_TARIFA(XITEM,XTARIFA,xbulto)

ENDIF

RETURN(YFACTOR*CANT<999999.999)


