PROCEDURE GETBPRE
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC,BR_CAMPO
SALIR=.T.
DO CASE
 CASE ICAMPO=1
   @  ROW(),COL() GET XCODIGO VALID EVALCOD(@XCODIGO,LCODIGO,[MXCTACON])

 CASE ICAMPO=2
   @ ROW(),COL() GET XNOMBRE

 OTHERWISE
  IF MXCTACON->MARCA
   BR_CAMPO=[X]+SUBSTR(HCAMPO[ICAMPO],11)
   @ ROW(),COL() GET &BR_CAMPO PICT PIC16
  else
   keyboard ""
   salir:=.t.
   return
  ENDIF
ENDCASE
leer()
SALIR:=escapar()
RETURN

PROCEDURE ELIPRE
* ELIMINACION DE REGISTRO
PRIVATE MODIFICA,XCODIGO,XAPU
MODIFICA=.T.

SELECT MXCTACON
XCODIGO=CODIGO
XAPU=RECNO()
SELECT MXPSPCON
GOTO XAPU
DO ASGPRE
FOR I=1 TO 12
 II=STRZERO(I,2)
 XPRE&II=0
NEXT

ACT_PRE(XCODIGO)

SELECT MXCTACON
goto xapu
AUDITORIA([Acceso a mantenimiento de presupuesto],codigo,,[ELI])
DELETE

SELECT MXDAACON
goto xapu
REC_LOCK(0)
DELETE

SELECT MXPSPCON
goto xapu
REC_LOCK(0)
DELETE

SELECT MXCTACON

RETURN

