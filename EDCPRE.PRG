PROCEDURE DEFPRE
* VALORES POR DEFECTO
PRIVATE I,II
STORE SPACE(20) TO XCODIGO,LCODIGO
XNOMBRE    = SPACE( 25)
FOR I=1 TO 12
 II=STRZERO(I,2)
 XPRE&II=0.00
NEXT
RETURN

PROCEDURE ASGPRE
* ASIGNACION DE REGISTRO A MEMORIA
PRIVATE I,II,XAPU
SELECT MXCTACON
STORE CODIGO TO XCODIGO,LCODIGO
XNOMBRE    = NOMBRE
XAPU=RECNO()
SELECT MXPSPCON
GOTO XAPU
FOR I=1 TO 12
 II=STRZERO(I,2)
 STORE PRE&II TO XPRE&II,LPRE&II
NEXT

SELECT MXCTACON
RETURN

PROCEDURE RPLPRE
* REEMPLAZO EN EL REGISTRO

SELECT MXCTACON
AUDITORIA([Acceso a mantenimiento de presupuesto],xcodigo,codigo,IF(MODIFICA,[MOD],[INC]))
REPLACE CODIGO WITH XCODIGO, NOMBRE WITH XNOMBRE,MARCA WITH ES_DET(XCODIGO)
REPLACE NIVCOD WITH NIVEL(XCODIGO)
IF !MODIFICA
 SELECT MXPSPCON
 ADD_REC(0)
 SELECT MXDAACON
 ADD_REC(0)
ENDIF
SELECT MXPSPCON
ACT_PRE(XCODIGO)

UNLOCK
SELECT MXCTACON
RETURN

