PROCEDURE CON0303
* PRESUPUESTO


PARAMETERS P1,P2,P3
DECLARE HCAMPO[14],HSUBTIT[14]
PRIVATE XCODIGO,XNOMBRE,XPRE01,XPRE02,XPRE03,XPRE04,XPRE05,XPRE06,XPRE07,XPRE08,XPRE09,XPRE10,XPRE11,XPRE12
PRIVATE LCODIGO,        LPRE01,LPRE02,LPRE03,LPRE04,LPRE05,LPRE06,LPRE07,LPRE08,LPRE09,LPRE10,LPRE11,LPRE12
PRIVATE BCODIGO, BNOMBRE
PRIVATE D_REFRES:=BLK("DETPRE()")
BCODIGO=SPACE(20)
BNOMBRE=SPACE(25)

DO CAMPRE
DO SUBPRE
IF ABRIR([MXPSPCON],MXPSPCON,[S])
 IF ABRIR([MXDAACON],MXDAACON,[S])
  IF ABRIR([MXCTACON],MXCTACON,[S],MXCTCOX1)
   SET RELATION TO RECNO() INTO MXPSPCON
   INIT_VER()
   DO EDC WITH [PRE],[ PRESUPUESTO ],HSUBTIT,HCAMPO,.T.,.F.,.T.,.F.,.F.,.F.,.T.,.F.
  ENDIF
 ENDIF
ENDIF
DBUNLOCKALL()
RETURN


PROCEDURE SUBPRE
PRIVATE I
HSUBTIT[ 1]=[C¢digo]+SPACE(14)
HSUBTIT[ 2]=[Nombre]+SPACE(19)
FOR I=3 TO 14
 HSUBTIT[I]=MESPER(I-2)
NEXT

RETURN

