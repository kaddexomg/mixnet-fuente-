FUNCTION SUMA_PRE
RETURN (PRE01+PRE02+PRE03+PRE04+PRE05+PRE06+PRE07+PRE08+PRE09+PRE10+PRE11+PRE12)


PROCEDURE LISTA_MES
PRIVATE I
FOR I=1 TO 12
 @ I+5,46 SAY MESPER(I)
NEXT
RETURN


FUNCTION VELIPRE
* VALIDA SI PUEDE ELIMINAR UN REGISTRO
RETURN( !ES_CONTROL(CODIGO,[MXCTACON]) .AND. !HAY_MOV([MXCTACON]) )


FUNCTION ACT_PRE
PARAMETER XCOD
PRIVATE I,II,UAPU,XAPU
DO MENSAJ WITH [Actualizando cuentas de control...]
SELECT MXCTACON
UAPU=RECNO()
DO WHILE !EMPTY(XCOD)
 SELECT MXCTACON
 SEEK(XCOD)
 IF !FOUND()
  DO INCTACON
 ENDIF
 XAPU=RECNO()
 SELECT MXPSPCON
 GOTO XAPU
 REC_LOCK(0)
 IF MODIFICA
  FOR I=1 TO 12
   II=STRZERO(I,2)
   REPLACE PRE&II WITH PRE&II-LPRE&II
  NEXT
 ENDIF

 FOR I=1 TO 12
  II=STRZERO(I,2)
  REPLACE PRE&II WITH PRE&II+XPRE&II
 NEXT

 XCOD=NIV_ANT(XCOD)
ENDDO
SELECT MXCTACON
GOTO UAPU
DO LIMPIA
RETURN 0

PROCEDURE BUSPRE
* BUSQUEDA EN PRESUPUESTO DE CONTABILIDAD
* RECUERDA DECLARAR BCODIGO Bvariable EN EL MODULO EN DONDE SE ABREN LOS ARCHIVOS
PRIVATE TCODIGO,TNOMBRE
BUS([BPREFUN])
RETURN

PROCEDURE BPREFUN
* BUSQUEDA
CLEAR GETS
@  9,11 GET BCODIGO VALID BPREVAL()
@ 11,11 GET BNOMBRE
LEER()
SALIR=ESCAPAR() .OR. ( EMPTY(BCODIGO) .AND. EMPTY(BNOMBRE) )
IF !SALIR
 IF !EMPTY(BCODIGO)
  TCODIGO=UPPER(TRIM(BCODIGO))
  YKEY=TCODIGO
 ELSE
  TNOMBRE=UPPER(TRIM(BNOMBRE))
  BCONDICION=[TNOMBRE$NOMBRE]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN

FUNCTION BPREVAL
IF !EMPTY(BCODIGO) .AND. CHR(LASTKEY())<>PGDN
 KEYBOARD PGDN
ENDIF
RETURN .T.

