 SAVE GET TO UGET
 BOXSOM('',4,25,19,58,1)
 SETCOLOR(C_TEX1)
 @  5,27 SAY 'Agencia..:'
 @  6,27 GET XAGENCIA
 @  7,27 SAY 'Direcci¢n:'
 @  8,27 GET XDIREC1
 @  9,27 GET XDIREC2
 @ 10,27 GET XDIREC3
 @ 11,27 GET XDIREC4
 @ 12,27 SAY 'Tel‚fono:'
 @ 13,27 GET XTLF1
 @ 14,27 GET XTLF2
 @ 15,27 SAY 'Contacto:'
 @ 16,27 GET XCONTACTO
 @ 17,27 SAY 'Comisi¢n (%):'
 @ 18,27 GET XCOMISION PICT '99.99'
 leer()
