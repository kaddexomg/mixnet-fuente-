#INCLUDE "MIXCAB.CH"
PROCEDURE BAN0302
INIT_VER()
BAN0000()
RETURN

PROCEDURE BAN0000
PARAMETERS P1,P2,P3
DECLARE ULT_REC[15],ULT_IND[15],ABIERTA[15]
AFILL(ABIERTA,.F.)
IF EN_CTABAN
 RETURN
ENDIF

EN_CTABAN=.T.

PRIVATE ULT_ALIAS
DECLARE RCAMPO[ 4],RSUBTIT[ 4]
PRIVATE XCODBAN,XNOMBRE,XCUENTA, BCODBAN,BNOMBAN, LCODBAN, XCODCON
PRIVATE XDIREC1,XDIREC2,XDIREC3,XDIREC4,XCONTACTO,XTLF1,XTLF2,XAGENCIA,XCOMISION
Private tSubOpcion,tGestion
BCODBAN    = SPACE(  5)
BNOMBRE    = SPACE( 30)
DO CAMBAN
DO SUBBAN
ULT_ALIAS=ALIAS()
IF ABRIR([MXDAABAN],MXDAABAN,[S])
IF ABRIR([MXCTABAN],MXCTABAN,[S],MXCTBAX1)
 GO TOP
 set key -9 to analiBAN
 tSubOpcion:=subopcion
 tGestion:=Gestion
 subopcion:=2
 gestion:='BAN'
 DO EDC WITH [BAN],[ BANCOS ],RSUBTIT,RCAMPO,.T.,.T.,POPC3[2],.T.,.F.,.F.,.T.,.F.,'F10=GRAFICAR'
 subopcion := tSubopcion
 gestion   := tGestion
 set key -9 to
 CERRAR([MXDAABAN])
 CERRAR([MXCTABAN])
ENDIF
ENDIF
DO RESEL
EN_CTABAN=.F.
RETURN


PROCEDURE SUBBAN
RSUBTIT[ 1]=[C¢digo]
RSUBTIT[ 2]=pad([Nombre],30)
RSUBTIT[ 3]=pad([No. de Cuenta],15)
RSUBTIT[ 4]=pad([C¢digo Contable],20)
RETURN

PROCEDURE CAMBAN
RCAMPO[ 1]=[CODBAN]
RCAMPO[ 2]=[NOMBRE]
RCAMPO[ 3]=[CUENTA]
RCAMPO[ 4]=[CODCON]
RETURN

PROCEDURE DEFBAN
* VALORES POR DEFECTO
SELECT MXCTABAN
GO BOTTOM
XCODBAN=IF(EOF(),'00001',PROX_SIMB(CODBAN))

STORE SPACE(5) TO LCODBAN

XNOMBRE    = SPACE( 30)
XCUENTA    = SPACE( 20)
XCODCON    =SPACE(20)
STORE SPACE(25) TO XDIREC1,XDIREC2,XDIREC3,XDIREC4,XCONTACTO,XAGENCIA
STORE SPACE(15) TO XTLF1, XTLF2
XCOMISION=0
RETURN

PROCEDURE ASGBAN
* ASIGNACION DE REGISTRO A MEMORIA
STORE CODBAN TO XCODBAN, LCODBAN
XNOMBRE    = NOMBRE
XCUENTA    = CUENTA
XCODCON    = CODCON
XDIREC1=DIREC1
XDIREC2=DIREC2
XDIREC3=DIREC3
XDIREC4=DIREC4
XTLF1=TLF1
XTLF2=TLF2
XCONTACTO=CONTACTO
XCOMISION=COMISION
XAGENCIA=AGENCIA
RETURN

PROCEDURE RPLBAN
* REEMPLAZO EN EL REGISTRO
AUDITORIA([Acceso la opcion de mantenimiento de bancos],xcodban,codban,IF(MODIFICA,[MOD],[INC]))
REPLACE CODBAN WITH XCODBAN,NOMBRE WITH XNOMBRE,CUENTA WITH XCUENTA,CODCON WITH XCODCON,;
AGENCIA WITH XAGENCIA,DIREC1 WITH XDIREC1,DIREC2 WITH XDIREC2,DIREC3 WITH XDIREC3,;
DIREC4 WITH XDIREC4, CONTACTO WITH XCONTACTO, COMISION WITH XCOMISION,TLF1 WITH XTLF1,TLF2 WITH XTLF2
SELECT MXDAABAN
ADD_REC(0)
SELECT MXCTABAN
RETURN

PROCEDURE MASBAN
* MASCARA DE LA VENTANA
LINSIM()
RETURN

FUNCTION VCODBAN
PARAMETER TU_XCOD, TU_LCOD
IF LASTKEY()=5
 RETURN .T.
ENDIF
IF EMPTY(TU_XCOD)
 RETURN .F.
ENDIF
IF MODIFICA
 IF TU_LCOD<>TU_XCOD
  IF HAY_MOVBAN()
   TU_XCOD=TU_LCOD
   RETURN .F.
  ENDIF
 ENDIF
ENDIF
RETURN(CHKDUP(TU_XCOD,[Banco]))

PROCEDURE GETBAN
* CAPTURA REGISTRO
@ CONTLIN, 2+MARGEN GET XCODBAN PICT [@!] VALID VCODBAN(@xcodban,LCODBAN)
@ CONTLIN, 9+MARGEN GET XNOMBRE
@ CONTLIN,40+MARGEN GET XCUENTA PICT "@S15"
@ CONTLIN,56+MARGEN GET XCODCON VALID valrefcon(XCODCON)
leer()
SALIR=ESCAPAR()
IF !SALIR
 TOMA_DAF()
 SALIR=ESCAPAR()
ENDIF
RETURN

PROCEDURE DETBAN
* DETALLE
@ CONTLIN, 2+MARGEN SAY CODBAN
@ CONTLIN, 9+MARGEN SAY NOMBRE
@ CONTLIN,40+MARGEN SAY PAD(CUENTA,15)
@ CONTLIN,56+MARGEN SAY CODCON
RETURN


PROCEDURE GETBBAN
* CAPTURA DE CAMPOS EN MODO BROWSE
DO CASE
 CASE ICAMPO=1
   @  ROW(),COL() get XCODBAN pict '@!' valid VCODBAN(@xcodban,LCODBAN)
  CASE ICAMPO=2
   @ ROW(),COL() get XNOMBRE
  CASE ICAMPO=3
   @ ROW(),COL() get XCUENTA
  CASE ICAMPO=4
   @ ROW(),COL() get XCODCON
ENDCASE
leer()
SALIR=ESCAPAR(1)
RETURN

PROCEDURE ELIBAN
* ELIMINACION DE REGISTRO
SELECT MXCTABAN
AUDITORIA([Acceso la opcion de mantenimiento de bancos],codban,,[ELI])
DELETE
SELECT MXDAABAN
REC_LOCK(0)
DELETE
UNLOCK
SELECT MXCTABAN
RETURN

FUNCTION VELIBAN
* VALIDA SI PUEDE ELIMINAR UN REGISTRO
RETURN( !HAY_MOVBAN() )


PROCEDURE BUSBAN
* BUSQUEDA EN BANCOS
PRIVATE TCODBAN,TNOMBRE
VERTBUS([BBANFUN])
RETURN

PROCEDURE BBANFUN
* BUSQUEDA
@ CONTLIN, 2+MARGEN get BCODBAN
@ CONTLIN, 9+MARGEN get BNOMBRE
LEER()
SALIR= ESCAPAR() .OR. ( EMPTY(BCODBAN) .AND. EMPTY(BNOMBRE) )
IF !SALIR
 IF !EMPTY(BCODBAN)
  TCODBAN=UPPER(TRIM(BCODBAN))
  YKEY=TCODBAN
 ELSE
  TNOMBRE=UPPER(TRIM(BNOMBRE))
  BCONDICION=[TNOMBRE$NOMBRE]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN


