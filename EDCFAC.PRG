 if !doschar$'*D'
  if el_monto>0
   if pv_blodesc='S'
    if !CheqClave(pv_clavblo,"Indique clave para descuentos:")
     Pare('Clave incorrecta')
     xdesc:=0
     Return .f.
    endif
   endif
  endif
  if pv_limd='S' .and. !prichar$[*-]
     dev:=if(xdesc1=0,.t.,if(el_monto<=xdesc1,.t.,.f.))
