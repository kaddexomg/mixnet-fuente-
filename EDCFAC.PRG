  IF LO_ENCONTRO
     XEXMIN:=EXMIN
     XEXMAX:=EXMAX
     IF !MODIFICA
        XCODCON:=CODCON
     ENDIF
     xpeso:=peso
     COPI_ART()
     XDESC :=IF(PV_DRG="N",0,XDESC)
