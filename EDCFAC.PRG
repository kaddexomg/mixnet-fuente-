        IF vtas_pbul='S'
           KEYBOARD REPLICATE(SALIDA,3)
        ELSE
           KEYBOARD REPLICATE(SALIDA,4)
        ENDIF
     endif
  ENDIF
ENDCASE

RETURN .T.

