     endif
  ELSE
     SET ORDER TO 2
     IF DBSEEK(XITEM)
        LO_ENCONTRO:=.T.
     ELSE
        LO_ENCONTRO:=.F.
     ENDIF
  ENDIF
  SET ORDER TO 1
  IF LO_ENCONTRO
     XITEM :=CODART
     XEXMIN:=EXMIN
     XEXMAX:=EXMAX
     XCODCON:=CODCON
     XPESO  :=PESO
     COPI_ART()
     XDESC:=IF(PV_DRG="N",0,XDESC)
     if !modifica
        XDESC1:=xdesc
     endif
  ENDIF
  IF !LO_ENCONTRO
    SELINFINV()
    /*
    IF LASTKEY()=27
       KEYBOARD SALIDA
       WAIT
       SELECT BUFFER
       RETURN .T.
    ENDIF
    */
    SELECT BUFFER
    RETURN .F.
  ELSE
     SELECT BUFFER
