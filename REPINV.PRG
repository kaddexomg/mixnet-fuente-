PROCEDURE DINV0405
PRIVATE P_COS,P_VEN,P_CAN,EL_COSTO:=0
CTL_MAN()
IF &I_CRITERIO
  IF !EMPTY(II_ALMACE)
     if tipinv$'E .EN.AC'
        a_cosent := a_cosent+BS(costo_tot)
        a_canent := a_canent+cantidad
        costo_en := div(BS(a_cosent),a_canent)
        el_costo := BS(costo_tot)
     else
        el_costo:=(a_cosent,a_canent*cantidad)
     endif
  ELSE
     el_costo:=BS(costo_tot)
  ENDIF
  IF IMPRE
    P_COS=IF(el_costo=0,SPACE(14),TRANS(el_costo,TRAN14))
    P_CAN=IF(CANTIDAD=0,SPACE(10),STR(CANTIDAD,10,3))
    P_VEN=IF(VENTA_TOT=0,SPACE(14),TRANS(BS(VENTA_TOT),TRAN14))
    *P_COS=IF(COSTO_TOT=0,SPACE(14),TRANS(COSTO_TOT,TRAN14))
    ESCRIBE(DTOC(FECHA_MOV)+[ ]+TIPINV+[ ]+NUMDOC+[ ]+ORIGEN+[ ]+CODMOVART+[ ]+;
            NOMCOD(CODMOVART,[MXCTAINV],[PAD(NOMART,35)])+[ ]+PROV_CLI+[ ]+UNIDAD+[ ]+;
            P_CAN+[ ]+P_COS+[ ]+P_VEN)
  ELSE
    P_COS=IF(el_costo=0,SPACE(12),str(el_costo,12,g_redondo))
    P_CAN=IF(CANTIDAD=0,SPACE(10),STR(CANTIDAD,10,3))
    *P_COS=IF(COSTO_TOT=0,SPACE(12),STR(COSTO_TOT,12,G_REDONDO))
    ESCRIBE(DTOC(FECHA_MOV)+[ ]+TIPINV+[ ]+NUMDOC+[ ]+ORIGEN+[ ]+CODMOVART+[ ]+;
            PROV_CLI+[ ]+P_CAN+[ ]+UNIDAD+[ ]+P_COS)
  ENDIF
ENDIF
IF !I_MANUAL
  SKIP
ENDIF
RETURN

