FUNCTION FOLLOWING
PRIVATE MI_SEL
MI_SEL=ALIAS()
IF !II_ZERO
  DO WHILE .T.
    SELEC MXTRAINV
    SET SOFT ON
    SEEK(MXCTAINV->CODART+TRIM(SUBSTR(DTOS(II_FEC1-1),1,6)))
    SET SOFT OFF
    DO WHILE !EOF() .AND. CODMOVART=MXCTAINV->CODART .AND. FECHA_MOV<=II_FEC1-1
      SKIP
    ENDDO
    IF !EOF() .AND. CODMOVART=MXCTAINV->CODART .AND. FECHA_MOV<=II_FEC2
      EXIT
    ELSE
      GARDNER()
    ENDIF
  ENDDO
ENDIF
SELECT &MI_SEL
RETURN 0

FUNCTION GARDNER
SELECT MXCTAINV
IF ABORT()
  BREAK
ENDIF
IF I_MANUAL
  CTL_MAN()
ELSE
  SKIP
  IF EOF()
    BREAK
  ENDIF
ENDIF
RETURN 0

*** DETALLE MOVIMIENTO DEL ARTICULO ***
PROCEDURE DINV0409
PRIVATE XREG,EL_COSTO:=0
SELECT MXCTAINV
IF EMPTY(II_FEC2)
 II_FEC2=FECMAX
ENDIF
XSALDO=0
STORE 0 TO TENT,TSAL
SELEC MXTRAINV
SEEK(MXCTAINV->CODART)
DO WHILE !EOF() .AND. CODMOVART=MXCTAINV->CODART .AND. FECHA_MOV<=II_FEC1-1
  IF IF(!EMPTY(II_ALMACE),ALMACEN=II_ALMACE,.T.)
   IF TIPINV$[AE,AC,DV] .OR. TIPINV='E' .OR. TIPINV='EN'
     XSALDO=XSALDO+BS(COSTO_TOT)
     TENT=TENT+CANTIDAD
     if !empty(ii_almace)
        a_cosent := a_cosent+BS(costo_tot)
        a_canent := a_canent+cantidad
        costo_en := div(a_cosent,a_canent)
        el_costo := costo_en
     else
        el_costo := div(BS(costo_tot),cantidad)
     endif
   ELSE
     if !empty(ii_almace)
        XSALDO=XSALDO-(costo_en*cantidad)
     else
        XSALDO=XSALDO-BS(COSTO_TOT)
     endif
     TSAL=TSAL+CANTIDAD
   ENDIF
  ENDIF
  SKIP
ENDDO
EX_ACT    = TENT - TSAL
IF EX_ACT<=0
 XSALDO=0
ENDIF

OEX_ACT=EX_ACT

IF IMPRE
  IF !II_SALTO
    ESCRIBE([CODIGO:]+MXCTAINV->CODART)
    ESCRIBE([NOMBRE:]+PAD(MXCTAINV->NOMART,35))
    CONTINUA=.T.
  ENDIF
  ESCRIBE(SPACE(38)+[SALDO AL ]+DTOC(II_FEC1-1)+[ ------->]+[ ]+STR(TENT,10,3)+[   ]+STR(TSAL,10,3)+[ ]+space(12)+[ ]+STR(EX_ACT,10,3)+[ ]+STR(XSALDO,17,G_REDONDO))
ELSE
  SETCOLOR(C_TIT2)
  ESCRIBE(SPACE(23)+[SALDO AL ]+DTOC(II_FEC1-1)+[ Ä>  ]+STR(EX_ACT,10,3)+SPACE(5)+STR(XSALDO,17,G_REDONDO))
  SETCOLOR(C_TEX2)
ENDIF

el_costo:=0
costo_en:=0

SELE MXTRAINV

DO WHILE !EOF() .AND. CODMOVART=MXCTAINV->CODART .AND. FECHA_MOV<=II_FEC2
  MIMES =MONTH(FECHA_MOV)
  XFECHA=DTOC(FECHA_MOV)
  CENT=SPACE(10)
  CSAL=SPACE(11)
  IF IF(!EMPTY(II_ALMACE),ALMACEN=II_ALMACE,.T.)
   IF TIPINV$[AE,AC,DV] .OR. TIPINV='E'.OR. TIPINV='EN'
     XSALDO=XSALDO+BS(COSTO_TOT)
     TENT=TENT+CANTIDAD
     CENT=STR(CANTIDAD,10,3)
     if !empty(ii_almace)
        a_cosent := a_cosent+BS(costo_tot)
        a_canent := a_canent+cantidad
        costo_en := div(a_cosent,a_canent)
        el_costo := costo_en
     else
        el_costo := div(BS(costo_tot),cantidad)
     endif
   ELSE
     if !empty(ii_almace)
        XSALDO=XSALDO-(costo_en*cantidad)
     else
        XSALDO=XSALDO-BS(COSTO_TOT)
     endif
     TSAL=TSAL+CANTIDAD
     CSAL=STR(CANTIDAD,11,3)
   ENDIF

   EX_ACT=TENT-TSAL
   IF EX_ACT<=0 .AND. TIPINV<>[AC]
    XSALDO=0
   ENDIF
   IF TIPINV=[E] .AND. OEX_ACT<0 .AND. EX_ACT>0
    XSALDO=EX_ACT*DIV(BS(COSTO_TOT),CANTIDAD,G_REDONDO)
   ENDIF
   OEX_ACT=EX_ACT
   IF IMPRE
    IF !ORIGEN$[INV,PRO,PVE]
     U_NOM=SUBSTR(NOMCOD(PROV_CLI,IF(TIPINV=[EN],[MXCTAPRO],[MXCTACLI]),[NOMCLI]),1,30)
    ELSE
     U_NOM=SPACE(30)
    ENDIF
    /*
    ESCRIBE(DTOC(FECHA_MOV)+[ ]+TIPINV+[ ]+NUMDOC+[ ]+ORIGEN+[ ]+PROV_CLI+[ ]+;
    U_NOM+[ ]+CENT+[  ]+CSAL+[ ]+STR(COSTO_TOT,12,G_REDONDO)+;
    */
    ESCRIBE(DTOC(FECHA_MOV)+[ ]+TIPINV+[ ]+NUMDOC+[ ]+ORIGEN+[ ]+PROV_CLI+[ ]+;
    U_NOM+[ ]+CENT+[  ]+CSAL+[ ]+STR(el_costo*cantidad,12,G_REDONDO)+;
    [ ]+STR(EX_ACT,10,3)+[ ]+STR(XSALDO,17,G_REDONDO))
   ELSE
    /*
    ESCRIBE(DTOC(FECHA_MOV)+[ ]+TIPINV+[ ]+NUMDOC+[ ]+STR(CANTIDAD,10,3)+[ ]+;
    STR(COSTO_TOT,12,G_REDONDO)+[ ]+STR(EX_ACT,10,3)+SPACE(5)+STR(XSALDO,17,G_REDONDO))
    */
    ESCRIBE(DTOC(FECHA_MOV)+[ ]+TIPINV+[ ]+NUMDOC+[ ]+STR(CANTIDAD,10,3)+[ ]+;
    STR(el_costo*cantidad,12,G_REDONDO)+[ ]+STR(EX_ACT,10,3)+SPACE(5)+STR(XSALDO,17,G_REDONDO))
   ENDIF
  ENDIF
  SKIP
  IF IMPRE
    IF MIMES<>MONTH(FECHA_MOV) .OR. EOF()
     ESCRIBE(SPACE(40)+[TOTAL ]+UPPER(PAD(G_MESES[MIMES],12))+[-------> ]+STR(TENT,10,3)+[  ]+STR(TSAL,11,3)+[ ]+SPACE(12)+[ ]+STR(EX_ACT,10,3)+[ ]+STR(XSALDO,17,G_REDONDO) )
     ESCRIBE([])
    ENDIF
  ELSE
    IF MIMES<>MONTH(FECHA_MOV) .AND. !EOF() .AND. FECHA_MOV<=II_FEC2
       *ESCRIBE([])
    ENDIF
  ENDIF
ENDDO
IF IMPRE
  IF II_SALTO
    ESCRIBE(REPLICATE('Í',I_ANCHO))
  ENDIF
  ESCRIBE(PAD(MXCTAINV->NOMART,35)+[   SALDO AL ]+DTOC(II_FEC2)+[ -------> ]+STR(TENT,10,3)+[  ]+STR(TSAL,11,3)+[ ]+space(12)+[ ]+STR(EX_ACT,10,3)+[ ]+STR(XSALDO,17,G_REDONDO) )
  IF II_SALTO
    ESCRIBE(REPLICATE('Í',I_ANCHO))
  ELSE
    CONTINUA=.F.
    ESCRIBE([])
  ENDIF
ELSE
  SETCOLOR(C_TIT2)
  ESCRIBE(REPL("Ä",79))
  ESCRIBE(SPACE(21)+[  SALDO AL ]+DTOC(II_FEC2)+[ Ä>  ]+STR(EX_ACT,10,3)+SPACE(5)+STR(XSALDO,17,G_REDONDO))
  ESCRIBE(REPL("Ä",79))
  SETCOLOR(C_TEX2)
ENDIF
IF II_SALTO .OR. !IMPRE
  CONTLIN=MAXLIN+1
  PAG=0
ENDIF
STORE 0 TO XSALDO,TENT,TSAL,EX_ACT
SELECT MXCTAINV
IF !I_MANUAL
  SKIP
ELSE
  CTL_MAN()
ENDIF
FOLLOWING()
RETURN

