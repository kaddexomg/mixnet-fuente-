PROCEDURE DINV0410
PRIVATE TOT_DEB,TOT_CRE,EL_COSTO:=0
SELECT MXCTAINV
CTL_MAN()
IF IMPRE
 XCODART=CODART
 QCODART=CODART
 XNOMART=SUBSTR(NOMART,1,35)
 STORE 0.00 TO TOT_ENT,TOT_SAL,TOT_COS, TOT_CSA
 L_FECHA=NPER1
 I=0
 DO WHILE L_FECHA<=NPER2
  el_costo  = ROUND(BS(CALCOS(ULT_DAY(l_fecha),10,ii_almace)),G_REDONDO)
  I=I+1
  IF I>1
   XCODART=SPACE(15)
   XNOMART=SPACE(30)
  ENDIF
  STORE 0 TO ENT,SAL,ACUCOS,ACUSAL
  IF !EMPTY(II_ALMACE)
   CALC_INV(QCODART,L_FECHA,ULT_DAY(L_FECHA),0,0,@ENT,@SAL,@ACUCOS,@ACUSAL,II_ALMACE)
  ELSE
   CALC_INV(QCODART,L_FECHA,ULT_DAY(L_FECHA),0,0,@ENT,@SAL,@ACUCOS,@ACUSAL)
  ENDIF
  EEE = IF(ent=0,SPACE(13),TRANS(ENT,TR13))
  SSS = IF(sal=0,SPACE(13),TRANS(SAL,TR13))
  TOT_ENT  = TOT_ENT+ENT
  TOT_SAL  = TOT_SAL+SAL
  TOT_COS  = TOT_COS+BS(ACUCOS)
  TOT_CSA  = TOT_CSA+BS(ACUSAL)
  if !empty(ii_almace)
     XCOSTO   = el_costo
  else
     XCOSTO   = DIV( (TOT_COS) - (TOT_CSA), (TOT_ENT)-(TOT_SAL),10)
  endif
  EX=TOT_ENT-TOT_SAL
  IF EX<0
   XCOSTO=0
  ENDIF

  ESCRIBE(XCODART+[ ]+PAD(XNOMART,35)+[ ]+SUBSTR(MESFEC(L_FECHA),1,3)+[ ]+EEE+[ ]+SSS+[    ]+TRANS(EX,TR10)+;
  [  ]+TRANS(XCOSTO,TRAN14)+[  ]+TRANS(TOT_COS-TOT_CSA,TRAN17))

  L_FECHA=PRI_DAY(L_FECHA+31)

 ENDDO

 ESCRIBE([TOTAL]+SPACE(51)+TRANS(TOT_ENT,TR13)+[ ]+TRANS(TOT_SAL,TR13)+[ ]+TRANS(TOT_ENT-TOT_SAL,TR13)+;
 [   ]+TRANS(XCOSTO,TRAN13)+[   ]+TRANS(TOT_COS-TOT_CSA,TRAN16))
 ESCRIBE([])

ELSE
 SETCOLOR(C_TIT2)
 ESCRIBE(REPLICATE('Í',79))
 ESCRIBE([CODIGO: ]+CODART)
 ESCRIBE([NOMBRE: ]+PAD(NOMART,35))
 ESCRIBE(REPLICATE('Í',79))
 ESCRIBE([MES         ENTRADA        SALIDA    EXISTENCIA   COSTO UNIT.      COSTO TOTAL])
*         ---   ------------- ------------- ------------- ------------- ----------------
 ESCRIBE(REPLICATE('Ä',79))
 SETCOLOR(C_TEX2)
 STORE 0.00 TO TOT_ENT,TOT_SAL,TOT_COS, TOT_CSA
 QCODART=CODART
 L_FECHA=NPER1
 DO WHILE L_FECHA<=NPER2
  el_costo  = ROUND(BS(CALCOS(ULT_DAY(l_fecha),10,ii_almace)),G_REDONDO)

  STORE 0 TO ENT,SAL,ACUCOS,ACUSAL

  IF !EMPTY(II_ALMACE)
   CALC_INV(QCODART,L_FECHA,ULT_DAY(L_FECHA),0,0,@ENT,@SAL,@ACUCOS,@ACUSAL,II_ALMACE)
  ELSE
   CALC_INV(QCODART,L_FECHA,ULT_DAY(L_FECHA),0,0,@ENT,@SAL,@ACUCOS,@ACUSAL)
  ENDIF

  EEE = IF(ent=0,SPACE(13),TRANS(ENT,TR13))
  SSS = IF(sal=0,SPACE(13),TRANS(SAL,TR13))

  TOT_ENT  = TOT_ENT+ENT
  TOT_SAL  = TOT_SAL+SAL
  TOT_COS  = TOT_COS+BS(ACUCOS)
  TOT_CSA  = TOT_CSA+BS(ACUSAL)
  if !empty(ii_almace)
     XCOSTO   = el_costo
  else
     XCOSTO   = DIV( (TOT_COS) - (TOT_CSA), (TOT_ENT)-(TOT_SAL),10)
  endif
  *XCOSTO   = DIV( (TOT_COS) - (TOT_CSA), (TOT_ENT)-(TOT_SAL),10)
  EX=TOT_ENT-TOT_SAL
  IF EX<0
   XCOSTO=0
  ENDIF

  ESCRIBE(SUBSTR(mesfec(L_FECHA),1,3)+[   ]+EEE+[ ]+SSS+[ ]+TRANS(EX,TR13)+;
  [ ]+TRANS(XCOSTO,TRAN13)+[ ]+TRANS(tot_COS-tot_CSA,TRAN16))

  L_FECHA=PRI_DAY(L_FECHA+31)

 ENDDO

 ESCRIBE([TOTAL ]+TRANS(TOT_ENT,TR13)+[ ]+TRANS(TOT_SAL,TR13)+[ ]+TRANS(TOT_ENT-TOT_SAL,TR13)+;
 [ ]+TRANS(XCOSTO,TRAN13)+[ ]+TRANS(TOT_COS-TOT_CSA,TRAN16),C_TIT2)
 ESCRIBE(REPLICATE('Ä',79))
 CONTLIN=MAXLIN+1
ENDIF
SELECT MXCTAINV
IF !I_MANUAL
 SKIP
ENDIF
RETURN

