SKIP
IF !EOF()
 LOCATE REST FOR TIPINV$[AE,AS] .OR. TIPINV='S' .OR. CODMOVART<>EL_COD
 ES= CODMOVART=EL_COD .AND. !EOF()
ENDIF
GOTO UAPU
RETURN ES

FUNCTION IGUALORG
* IGUAL ORIGEN
IF ORIGEN<>[INV]
 DO CASE
  CASE ORIGEN=[PRO]
   AUX=[la orden de producci¢n No.(]+TRIM(NUMDOC)+[)]
  CASE ORIGEN=[REC]
   AUX=[la recepci¢n No.(]+TRIM(NUMDOC)+[)]
  CASE ORIGEN=[CPA]
   AUX=[la compra No.(]+TRIM(NUMDOC)+[)]
  CASE ORIGEN$[FAC,PVE]
   AUX= [la Factura No.(]+TRIM(NUMDOC)+[)]
  CASE ORIGEN=[ALB]
   AUX=[la nota de entrega No.(]+NUMDOC+[)]
  OTHERWISE
   RETURN .T.
 ENDCASE
 PARE([Doc. debe ser alterado desde ]+AUX)
 RETURN .F.
ENDIF
RETURN .T.


