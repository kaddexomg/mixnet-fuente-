PROCEDURE UBUSTIN
SET KEY -18 TO
* BUSQUEDA
@ CONTLIN, 2 GET BCODMOVART PICT [@!]
@ CONTLIN,18 GET BALMACEN
@ CONTLIN,21 GET BFECHA_MOV
@ CONTLIN,30 GET BTIPINV PICT [@!]
@ CONTLIN,35 GET BNUMDOC PICT [@!]
@ CONTLIN,44 GET BUNIDAD PICT [!!!]
@ CONTLIN,48 GET BCANTIDAD  PICT "999999999.999"
@ CONTLIN,59 GET BCOSTO_TOT
@ CONTLIN,75 GET BORIGEN PICT '@!'
LEER()
SALIR=ESCAPAR()
SET KEY -18 TO ACT_COSTO
IF !SALIR
 IF !EMPTY(BCODMOVART)
  BNUMDOC:=SPACE(8)
  TITEM=UPPER(TRIM(BCODMOVART))
  YKEY=TITEM
  DBSETORDER(1)
  TRAINV_ORD:=1
  MASTIN()
 ELSE
  IF !EMPTY(BNUMDOC)
   TITEM=UPPER(TRIM(BNUMDOC))
   YKEY=TITEM
   DBSETORDER(3)
   TRAINV_ORD:=3
   MASTIN()
  ELSE
   POR_INDICE=.F.
  ENDIF
 ENDIF
 BCONDICION=IF(EMPTY(BALMACEN),[.T.],[ALMACEN=TRIM(BALMACEN)])+ IF(EMPTY(BFECHA_MOV),[],[.AND. FECHA_MOV=BFECHA_MOV]) +;
 IF(EMPTY(BTIPINV),[],[.AND. TIPINV=TRIM(BTIPINV)])+IF(EMPTY(BNUMDOC),[],[.AND.NUMDOC=TRIM(BNUMDOC)])+;
 IF(EMPTY(BUNIDAD),[],[.AND.UNIDAD=TRIM(BUNIDAD)])+IF(EMPTY(BCANTIDAD),[],[.AND.CANTIDAD=BCANTIDAD])+;
 IF(EMPTY(BORIGEN),[],[.AND.ORIGEN=TRIM(BORIGEN)])+IF(EMPTY(BCOSTO_TOT),[],[.AND.COSTO_TOT=BCOSTO_TOT])
 IF LEN(BCONDICION)>3 .AND. POR_INDICE
  POR_AMBOS:=.T.
 ENDIF
ENDIF
RETURN


FUNCTION DETECTA
