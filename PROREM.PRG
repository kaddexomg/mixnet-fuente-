PROCEDURE DO_REMESA
* QRY **************************************************************
PRIVATE R_MAXCAMPO:=0
PRIVATE P_CRITERIO:=I_CRITERIO:=".T.", USR_CRITERIO:=''
DECLARE RC_CAMPO:={}, TIT:={},DCRIT1:={},DCRIT2:={}
*********************************************************************

* CJO ***************************************************************
DECLARE A1:={}
PRIVATE CAMINO
private rep_camino:=g_camino
*********************************************************************

DECLARE ORDEN:={},CAMORD:={},FILEORD:={}
PRIVATE II_ORDEN:=1

DECLARE TOT_C:={}
DECLARE COD_C:={}


PRIVATE SEMILLA:=G_CAMINO+'MXNUMREM.DBF'
PRIVATE BUFFER :=G_CAMINO+[BUFrem]+estacion+[.DBF]
PRIVATE NTX_BUF:=G_CAMINO+[BUFrem]+estacion+[.NTX]

PRIVATE ii_listasi:=''

NOMBVEN()

INIT_VER()
  P_CRITERIO:="TIPO$'FC,GR'"
  CARGA_CRIT('BAN10')
  DCRIT1[1]:=PRI_DAY(CTOD(G_FECHA))
  DCRIT2[1]:=ULT_DAY(CTOD(G_FECHA))
  TOMACRIT(' REMESA ',1)
  IF EMPTY(DCRIT2[1])
   DCRIT2[1]:=FECMAX
  ENDIF
  IF !ESCAPAR()
   CONSCRIT()
   IF COPBUF1()
    DO WHILE .T.
     EDITAR_REMESA()
     IF DECIS('¨ TERMINAR SESION ?')='S'
      EXIT
     ENDIF
    ENDDO
   ENDIF
  ENDIF
RETURN

STATIC FUNC COPBUF1
LOCAL I_CRIT:=BLOQUE(I_CRITERIO),XREG, VACIO:=.T.
MENSAJ(MEN4)
DBCREATE(BUFFER,{{'CTABANCO','C',15,0},{'BANCO','C',5,0},;
        {'IMPORTE','N',12,2},{'EMISION','D',8,0},{'VENCE','D',8,0},;
        {'NUMDOC','C',8,0},{'REGISTRO','N',6,0}  })
IF ABRIR('MXTRACOB',MXTRACOB,'S',MXTRCBX1,MXTRCBX2)
IF ABRIR('BUFFER',BUFFER,'E')
 SELECT MXTRACOB
 SET SOFT ON
 SEEK(DTOS(DCRIT1[1]))
 SET SOFT OFF
 DO WHILE EMISION <= DCRIT2[1] .and. !eof()
  IF EMPTY(REMESA).AND.EVAL(I_CRIT)
   IF ES_UNICO(MXTRACOB->NUMDOC)
    XREG:=RECNO()
    SELECT BUFFER
    APPEND BLANK
    REPLACE CTABANCO WITH MXTRACOB->CTABANCO,;
            BANCO    WITH MXTRACOB->BANCO,;
            IMPORTE  WITH MXTRACOB->IMPORTE,;
            EMISION  WITH MXTRACOB->EMISION,;
            VENCE    WITH MXTRACOB->VENCE,;
            NUMDOC   WITH MXTRACOB->NUMDOC,;
            REGISTRO WITH XREG
    ENDIF
  ENDIF
  SELECT MXTRACOB
  SKIP
 ENDDO
 SELEC BUFFER
 VACIO:=EOF()
 IF VACIO
  PARE('NO HAY DOCUMENTOS PARA ESTA REMESA.')
 ENDIF
 CERRAR('MXTRACOB')
 cerrar('BUFFER')
 IF !VACIO
  INDEXA(BUFFER,NTX_BUF,'CTABANCO')
 ENDIF
ENDIF
ENDIF

RETURN !VACIO

FUNC ES_UNICO(NUMERO)
LOCAL UREG, DEVO
SELECT MXTRACOB
UREG:=RECNO()
SET ORDER TO 2
SEEK(NUMERO)
SKIP
DEVO:=MXTRACOB->NUMDOC<>NUMERO.OR.EOF()
SET ORDER TO 1
GOTO UREG
RETURN DEVO

