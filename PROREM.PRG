STATIC proc actualizar_remesa(xremesa)

 MENSAJ('ACTUALIZANDO REMESA '+XREMESA)
 IF ABRIR('MXCTABAN',MXCTABAN,'S',MXCTBAX1)
 IF ABRIR('MXTRACOB',MXTRACOB,'S',MXTRCBX1)
  SELECT BUFFER
  GO TOP
  DO WHILE !EOF()
   SELECT MXTRACOB
   GOTO (BUFFER->REGISTRO)
   REC_LOCK(0)
   REPLACE REMESA   WITH XREMESA,;
           CTABANCO WITH BUFFER->CTABANCO,;
           BANCO    WITH BUFFER->BANCO
   UNLOCK
   SELECT MXCTABAN
   SEEK(BUFFER->BANCO)
   IF FOUND()
    REC_LOCK(0)
    REPLACE EN_REMESA WITH EN_REMESA+BUFFER->IMPORTE
    UNLOCK
   ENDIF

   SELECT BUFFER
   SKIP
  ENDDO
  CERRAR('MXTRACOB')
 ENDIF
 ENDIF
SELECT BUFFER
RETURN

* SCRMENSA=SAVESCREEN(MAXROW()-1,0,MAXROW(),79)

* RESTSCREEN(MAXROW()-1,0,MAXROW(),79,SCRMENSA)



STATIC PROC ELI_REMESA
LOCAL XREMESA:=SPACE(8)
SETCOLOR(C_ACHOICE)
BOXSOM(' EMINAR REMESA ',14,40,16,59,1)
@ 15,42 SAY 'N£mero:' GET XREMESA
LEER()
IF !ESCAPAR()
NOMBVEN()
IF ABRIR([MXCTABAN],MXCTABAN,[E],MXCTBAX1)
if abrir('MXTRACOB',MXTRACOB,'E')
 LOCATE FOR REMESA==XREMESA
 DO WHILE !EOF()
  REPLACE REMESA WITH ''
  SELECT MXCTABAN
  SEEK(MXTRACOB->BANCO)
  IF FOUND()
   REPLACE EN_REMESA WITH EN_REMESA - MXTRACOB->IMPORTE
  ENDIF
  SELECT MXTRACOB
  CONTINUE
 ENDDO
 CERRAR('MXTRACOB')
ENDIF
CERRAR('MXCTABAN')
ENDIF
ENDIF
RETURN

