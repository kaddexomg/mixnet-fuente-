PROC CAMBIAR_REMESA
LOCAL XCTABANCO,XBANCO
if !empty(ii_listasi)
 IF DECIS('¨ Cambiar el # de cuenta de los registros marcados en la remesa ?')='S'
  XBANCO   :=MXCTABAN->CODBAN
  XCTABANCO:=MXCTABAN->CUENTA
  PRIREG   :=VAL(SUBSTR(II_LISTASI,1,5))
  HUBO_SEL:=.T.
  SELECT BUFFER
  DO WHILE !EMPTY(II_LISTASI)
   GOTO VAL(SUBSTR(II_LISTASI,1,5))
   II_LISTASI=STRTRAN(II_LISTASI,SUBSTR(II_LISTASI,1,6))
   REPLACE CTABANCO WITH XCTABANCO,;
           BANCO    WITH XBANCO
  ENDDO
  XTOT:=0
 ELSE
  EN_SEL:=.T.
 endif
ELSE
 EN_SEL:=.T.
endif
SELECT MXCTABAN
RETURN


PROC TOT_CUENTA
LOCAL TOT_CTA:=0,UCTA
*MENSAJ('CALCULANDO...')
TOT_C:={}
COD_C:={}
SELECT BUFFER
GO TOP
UCTA:=CTABANCO
DO WHILE !EOF()
 DO WHILE CTABANCO=UCTA .AND. !EOF()
  TOT_CTA += IMPORTE
  xTOT_rem += IMPORTE
  SKIP
 ENDDO
 AADD(TOT_C,TOT_CTA)
 AADD(COD_C,UCTA)
 TOT_CTA := 0
 UCTA    := CTABANCO
ENDDO
xnumreg:=lastrec()
disremtot()
RETURN

