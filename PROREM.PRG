ENDIF
XMULTI=PROX_MULTI
PROX_MULTI=PROX_SIMB(PROX_MULTI)
SAVE TO (MULTIFILE) ALL LIKE PROX_MULTI
RETURN XMULTI
****************************************************************


FUNCTION HAZNEWCAN
DO WHILE !EMPTY(II_LISTASI)
 SELECT BUFFER
 IF CTL_LISTA()
  SELE MXTRACOB
  ADD_REC(0)
  ARC_COB()
 ENDIF
ENDDO
RETURN 0


STATIC FUNC CTL_LISTA
LOCAL XREG,DEVO:=.F.
SELECT BUFFER
IF !EMPTY(II_LISTASI)
 GOTO VAL(SUBSTR(II_LISTASI,1,5))
 II_LISTASI=STRTRAN(II_LISTASI,SUBSTR(II_LISTASI,1,6))
 XREG:=REGISTRO
 DELETE
 SELECT MXTRACOB
 GOTO XREG
 XCODMOVCLI:=CODMOVCLI
 XTIPO     :='CA'
 XNUMDOC   :=NUMDOC
 XEMISION  :=YFECHA
 XVENCE    := VENCE
 XREFER    :=''
 XCONCEPTO :='CANCELACION '+TIPO+' '+XNUMDOC
 XIMPORTE  := -IMPORTE
 XFORMAPAG :='DP'
 XNUMPAG   :=YNUMDOC
 XNOMPAG   :=XBANCO
 XNUMORG   :=YNUMDOC
 XTIPDOCAN = TIPO
 DEVO :=.T.
ENDIF
RETURN DEVO

STATIC FUNCTION ARC_COB
* ARCHIVA MOVIMIENTOS DE CUENTAS POR COBRAR Y PAGAR

SELECT MXCTACLI
SEEK(XCODMOVCLI)

*************************************
REC_LOCK(0)
*************************************

REPLACE SALDO WITH SALDO + XIMPORTE
REPLACE FEC_UPAG WITH XEMISION

UNLOCK

REC_LOCK(0)

SELECT MXTRACOB
 REPLACE CODMOVCLI WITH XCODMOVCLI,;
         TIPO      WITH XTIPO,;
         NUMDOC    WITH XNUMDOC,;
         EMISION   WITH XEMISION   ,;
         VENCE     WITH XVENCE,;
         REFER     WITH XREFER,;
         CONCEPTO  WITH XCONCEPTO,;
         IMPORTE   WITH XIMPORTE,;
         FORMAPAG  WITH XFORMAPAG,;
         NUMPAG    WITH XNUMPAG,;
         NOMPAG    WITH XNOMPAG,;
         ORIGEN    WITH DOC_ORIGEN ,;
         NUMORG    WITH XNUMORG,;
         MULTICAN  WITH XMULTICAN,;
         MULTIDOC  WITH XMULTIDOC,;
         BANCO     WITH XBANCO,;
         CTABANCO  WITH XCTABANCO,;
         TIPDOCAN  WITH XTIPDOCAN


 IF TYPE([XREFCON])=[C]
  REPLACE REFCON WITH XREFCON
 ENDIF
 IF TYPE('XCOMPROBA')='C'
  REPLACE COMPROBA WITH XCOMPROBA
 ENDIF
 IF TYPE('XREMESA')='C'
  REPLACE REMESA WITH XREMESA
 ENDIF

UNLOCK

RETURN 0


STATIC PROC GEN_BAN
