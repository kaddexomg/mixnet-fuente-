STATIC FUNC TOMA_IMP
PRIVATE XCODMOVCLI,XTIPO,XNUMDOC,XEMISION,XVENCE,XREFER,XCONCEPTO,XIMPORTE,XFORMAPAG,XNUMORG
PRIVATE XNUMPAG,XNOMPAG,XMULTICAN:=.F.,XMULTIDOC, XTIPDOCAN, XREFCON, XCOMPROBA
PRIVATE YNOMBAN,XBANCO,XCTABANCO
PRIVATE DOC_ORIGEN:='IMP',MULTIPLE,CONFORME
PRIVATE YNUMDOC,YCONCEPTO, YFECHA:=CTOD(G_FECHA)

IF EMPTY(II_LISTASI)
 PARE('NO HA SELECIONADO NINGUN DOCUMENTO')
ELSE
 IF ABRIR('MXCTABAN',MXCTABAN,[S],MXCTBAX1)
  IF ABRIR('MXTRACOB',MXTRACOB,[S],MXTRCBX3,MXTRCBX2,MXTRCBX1,MXTRCBX4,MXTRCBX5)
   IF ABRIR('MXCTACLI',MXCTACLI,[S],MXCTCLX1)

      SELECT BUFFER
      MULTIPLE:=LEN(II_LISTASI)>6
      CONFORME:=CONFIRMA()
      IF CONFORME='S'
       ACTU_IMP()
       KEYBOARD HOME
      ENDIF

      setcolor(c_tit1)
      @  9,62 say space(3)
      @ 11,62 say space(16)
      setcolor(c_tex)
    CERRAR('MXCTACLI')
   ENDIF
   CERRAR('MXTRACOB')
  ENDIF
  CERRAR('MXCTABAN')
 ENDIF
ENDIF

SELECT BUFFER
GO TOP
IF EOF()
 KEYBOARD ESCAPE
ENDIF
RETURN


STATIC PROCEDURE ACTU_IMP
LOCAL YREG
PRIVATE XREMESA
MENSAJ('GENERANDO CANCELACION EN CARTERA ...')

XCOMPROBA =PROXINUM(MXNUMCRE)

SELECT MXTRACOB

IF !MULTIPLE
 * CANCELACION UNICA
 CTL_IMP()
 YREG=RECNO()
 XMULTIDOC:=''
 XMULTICAN :=.F.
 ADD_REC(0)
 ARC_COB()
 GOTO YREG
 GEN_IMP()

ELSE

 * CANCELACION MULTIPLE
 XMULTIDOC=PROXIMO_MUL()
 XMULTICAN = .T.
 HAZ_IMPCAN()
ENDIF
II_LISTASI=[]
XTOT:=0
RETURN


STATIC FUNCTION HAZ_IMPCAN
LOCAL UREG
DO WHILE !EMPTY(II_LISTASI)
 SELECT BUFFER
 IF CTL_IMP()
  SELE MXTRACOB
  UREG=RECNO()
  ADD_REC(0)
  ARC_COB()
  GOTO UREG
  GEN_IMP()
 ENDIF
ENDDO
RETURN 0


