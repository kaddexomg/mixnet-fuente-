FUNCTION SIGSIN
PRIVATE MI_SEL
MI_SEL=SELECT()
IF !II_ZERO
  DO WHILE .T.
    SELEC MXTRACOB
    SEEK(MXCTACLI->CODCLI)
    IF II_RENG=1
      DO WHILE !EOF() .AND. CODMOVCLI=MXCTACLI->CODCLI .AND. EMISION<=II_FEC1-1
        SKIP
      ENDDO
      IF !EOF() .AND. CODMOVCLI=MXCTACLI->CODCLI .AND. EMISION<=II_FEC2
        DO WHILE !EOF() .AND. CODMOVCLI=MXCTACLI->CODCLI .AND. !&I_CRIT2
          SKIP
        ENDDO
        IF !EOF() .AND. CODMOVCLI=MXCTACLI->CODCLI .AND. &I_CRIT2
          EXIT
        ELSE
          AVA()
        ENDIF
      ELSE
        AVA()
      ENDIF
    ELSE
      IF EOF()
        AVA()
      ELSE
        EXIT
      ENDIF
    ENDIF
  ENDDO
ENDIF
SELECT (MI_SEL)
RETURN 0

FUNCTION AVA
SELECT MXCTACLI
IF ABORT()
  BREAK
ENDIF
IF I_MANUAL
  CTL_MAN()
ELSE
  SKIP
  IF EOF()
    BREAK
  ENDIF
ENDIF
RETURN 0

PROCEDURE DVEN0408
PRIVATE XREG
SELECT MXCTACLI
IF EMPTY(II_FEC2)
 II_FEC2=FECMAX
ENDIF
SELEC MXTRACOB
SEEK(MXCTACLI->CODCLI)
STORE 0 TO XDEBITOS,XCREDITOS,XSALDO,DEBMES,CREMES
IF II_RENG=1
  DO WHILE !EOF() .AND. CODMOVCLI=MXCTACLI->CODCLI .AND. EMISION<=II_FEC1-1
    XSALDO=XSALDO+E_IMPORTE(IMPORTE,EMISION)
    SKIP
  ENDDO
ENDIF
IF IMPRE
  IF !II_SALTO
    ESCRIBE([CODIGO:]+MXCTACLI->CODCLI+[ NOMBRE:]+pad(MXCTACLI->NOMCLI,35))
    CONTINUA=.T.
  ENDIF
  IF II_RENG=1
*    XSALDO    = TDEB_ANT-TCRE_ANT
*    XDEBITOS  = TDEB_ANT
*    XCREDITOS = TCRE_ANT
*    ESCRIBE(SPACE(41)+[SALDO AL ]+DTOC(II_FEC1-1)+[ ----------------> ]+TRANS(TDEB_ANT,TRAN17)+[  ]+TRANS(TCRE_ANT,TRAN17)+[ ]+TRANS(XSALDO,TRAN17))
    ESCRIBE(SPACE(41)+[SALDO AL ]+DTOC(II_FEC1-1)+[ ----------------> ]+SPACE(36)+TRANS(XSALDO,TRAN17))
  ENDIF
ELSE
  IF II_RENG=1
*    XSALDO=TDEB_ANT-TCRE_ANT
    SETCOLOR(C_TIT2)
    ESCRIBE(SPACE(40)+' SALDO AL '+DTOC(II_FEC1-1)+'    '+STR(XSALDO,15,2))
    SETCOLOR(C_TEX2)
  ENDIF
ENDIF
SELE MXTRACOB
Y_COND=IF(II_RENG=1,[EMISION<=II_FEC2],[.T.])
DO WHILE !EOF() .AND. CODMOVCLI=MXCTACLI->CODCLI .AND. &Y_COND
  MIMES =MONTH(EMISION)
  XFECHA=DTOC(EMISION)
  IF &I_CRIT2
    XSALDO=XSALDO+E_IMPORTE(IMPORTE,EMISION)
    I_PONER=TIPO$[FCoGRoND]
    IF IMPRE
      ESCRIBE(NUMDOC+' '+TIPO+' '+DTOC(EMISION)+' '+IF(I_PONER,DTOC(VENCE),[    --    ])+;
      ' '+REFER+' '+PAD(CONCEPTO,30)+' '+IF(I_PONER,DIVEN(VENCE,CTOD(G_FECHA)),[----])+' '+;
      IF(IMPORTE>0,TRANS(E_IMPORTE(IMPORTE,EMISION),TRAN16)+SPACE(17),SPACE(17)+TRANS(ABS(E_IMPORTE(IMPORTE,EMISION)),TRAN16))+' '+;
      TRANS(XSALDO,TRAN17))
      IF IMPORTE>0
        XDEBITOS=XDEBITOS+E_IMPORTE(IMPORTE,EMISION)
        DEBMES=DEBMES+E_IMPORTE(IMPORTE,EMISION)
      ELSE
        XCREDITOS=XCREDITOS-E_IMPORTE(IMPORTE,EMISION)
        CREMES=CREMES-E_IMPORTE(IMPORTE,EMISION)
      ENDIF
    ELSE
      ESCRIBE(NUMDOC+[ ]+TIPO+[ ]+DTOC(EMISION)+[ ]+;
      IF(I_PONER,DTOC(VENCE),[   --     ])+[ ]+REFER+[ ]+TRANS(E_IMPORTE(IMPORTE,EMISION),PIC13)+[ ]+;
      IF(I_PONER,DIVEN(VENCE,CTOD(G_FECHA)),[----])+' '+TRANS(XSALDO,PIC15))
    ENDIF
  ENDIF
  SKIP
  IF II_RENG=1
    IF IMPRE
      IF MIMES<>MONTH(EMISION) .OR. EOF()
        ESCRIBE(SPACE(39)+[  TOTAL ]+UPPER(PAD(G_MESES[MIMES],12))+[  ---------------->   ]+TRANS(DEBMES,TRAN16)+[ ]+TRANS(CREMES,TRAN16)+[ ]+TRANS(XSALDO,TRAN17))
        ESCRIBE([])
        STORE 0 TO DEBMES,CREMES
      ENDIF
    ELSE
      IF MIMES<>MONTH(EMISION) .AND. !EOF() .AND. EMISION<=II_FEC2
        ESCRIBE([])
      ENDIF
    ENDIF
 ENDIF
ENDDO
IF II_RENG=1
