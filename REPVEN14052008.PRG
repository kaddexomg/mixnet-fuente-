PROCEDURE CVEN0407
PARAMETER PPP
PRIVATE XYALIAS,INIDIA,FINDIA,I,J
*RES_DET=IF(II_RESUMIR,[R],[D])
DECLARE DIARIO[13]
XYALIAS=ALIAS()
SELE AUXIL
FOR I=1 TO 13
 J=STRZERO(I,2)
 DIARIO[I]=DIA&J
NEXT
I_BOTCRI=22
SETCOLOR(C_TIT2)
@ 10,16 SAY '    Al:'
@ 11,16 SAY '  Modo: '+IF(II_RES='R','Resumen  ',IF(II_RES='D','Detallado','Sumario  '))+space(14)
@ 12,16 SAY '  Zona:'
@ 13,16 SAY ' Grupo:'
@ 14,16 SAY ' Separadores (S/N):'
FOR I=15 TO 20
@ I,16 SAY  [  De:       a:       Dias]
NEXT
@ 21,16 SAY [+ De:                Dias]

SETCOLOR(C_TEX2)
IF PCOUNT()=1
  @ 10,24 SAY II_FEC
  @ 12,24 SAY II_ZONA
  @ 13,24 SAY II_GRUPO
  @ 14,35 SAY II_SEPA
  J=15
  FOR I=1 TO 11 STEP 2
  INIDIA=STRZERO(I,2)
  FINDIA=STRZERO(I+1,2)
  @ J,22 SAY DIA&INIDIA
  @ J,31 SAY DIA&FINDIA
  J=J+1
  NEXT
  @ j,22 SAY DIA13
ELSE
  CUR_ON()
  @ 10,24 GET II_FEC VALID !EMPTY(II_FEC)
  @ 11,16 SAY [Resumen/Detalle/Sumario:] GET II_RES PICT "!" VALID II_RES$[RDS]
  @ 12,24 GET II_ZONA
  @ 13,24 GET II_GRUPO
  @ 14,35 GET II_SEPA WHEN II_RES='R' VALID II_SEPA$'SN'
  READ
  CLEAR GETS
  J=15
  FOR I=1 TO 11 STEP 2
  @ J,22 GET DIARIO[I]
  @ J,31 GET DIARIO[I+1]
  J=J+1
  NEXT
  @ J,22 GET DIARIO[13]
  READ
  CLEAR GETS
  REC_LOCK(0)
  FOR I=1 TO 13
  J=STRZERO(I,2)
