PROCEDURE DINV0408
LOCAL XIMP:=0
private yiva
CTL_MAN()
CANT_ANT  = 0.000  && CANTIDAD VENDIDA HASTA EL PERIODO ANTERIOR
VENT_ANT  = 0.00   && VENTA HASTA EL PERIODO ANTERIOR
COSTO_ANT = 0.00   && COSTO HASTA EL PERIODO ANTERIOR
CANT_ACT  = 0.000  && CANTIDAD VENDIDA HASTA EL PERIODO ANTERIOR
VENT_ACT  = 0.00   && VENTA HASTA EL PERIODO ANTERIOR
COSTO_ACT = 0.00   && COSTO HASTA EL PERIODO ANTERIOR

XCODART=MXCTAINV->CODART
SELECT MXTRAINV
SEEK(XCODART)

DO WHILE CODMOVART=XCODART .AND. !EOF()
 IF ORIGEN$'FAC,PVE'
  QQSIGNO=IF(TIPINV='DV',-1,1)
*  IF MONTH(FECHA_MOV)<MONTH(II_FECRES) .and. year(fecha_mov)<=year(ii_fecres)
  if periodo(fecha_mov)<periodo(ii_fecres)
   COSTO_ANT=COSTO_ANT+QQSIGNO*E_IMPORTE(COSTO_TOT,FECHA_MOV)
   IF ORIGEN='PVE'
    VENT_ANT=VENT_ANT+QQSIGNO*E_IMPORTE(VENTA_TOT,FECHA_MOV)
    CANT_ANT=CANT_ANT+QQSIGNO*CANTIDAD
   ENDIF
  ELSE
  if periodo(fecha_mov)=periodo(ii_fecres)
*   IF MONTH(FECHA_MOV)=MONTH(II_FECRES).and. year(fecha_mov)=year(ii_fecres)
      M->COSTO_ACT=M->COSTO_ACT+QQSIGNO*E_IMPORTE(COSTO_TOT,FECHA_MOV)
    IF ORIGEN='PVE'
       VENT_ACT=VENT_ACT+QQSIGNO*E_IMPORTE(VENTA_TOT,FECHA_MOV)
       CANT_ACT=CANT_ACT+QQSIGNO*CANTIDAD
    ENDIF
   ENDIF
  ENDIF
 ENDIF

 SKIP
ENDDO
SELECT MXTRAINV
SET ORDER TO 2

SELECT MXRENFAC
SEEK(XCODART)
DO WHILE ITEM=XCODART .AND. !EOF()
 COSTO_ALB=0
 IF !EMPTY(MXRENFAC->NUMALB)
  XK=NUMALB+'SA'+ITEM+'ALB'
  SELECT MXTRAINV
  SEEK(XK)
  IF FOUND()
   COSTO_ALB = E_IMPORTE(MXTRAINV->COSTO_TOT,MXTRAINV->FECHA_MOV)
  ENDIF
  SELECT MXRENFAC
 ENDIF

 IF MXENCFAC->RECARGO$'N2'
  if !empty(yiva:=E_IMPORTE(mxrenfac->iva,MXRENFAC->EMISION))
   XIMP:= E_IMPORTE(MXRENFAC->TOT_REN/(1+m->IVA_&yiva/100),MXRENFAC->EMISION)
  endif
 ELSE
  XIMP:=E_IMPORTE(MXRENFAC->TOT_REN,MXRENFAC->EMISION)
 ENDIF

* IF MONTH(EMISION)<MONTH(II_FECRES).and. year(emision)<year(ii_fecres)
 if periodo(emision)<periodo(ii_fecres)
  COSTO_ANT = COSTO_ANT+COSTO_ALB
  VENT_ANT  = VENT_ANT+ XIMP
  CANT_ANT  = CANT_ANT+CANTIDAD
 ELSE
 if periodo(emision)=periodo(ii_fecres)
*  IF MONTH(EMISION)=MONTH(II_FECRES)   .and. year(emision)=year(ii_fecres)
     M->COSTO_ACT=M->COSTO_ACT+COSTO_ALB
     VENT_ACT=VENT_ACT+ XIMP
     CANT_ACT=CANT_ACT+CANTIDAD
   ENDIF
 ENDIF
 SKIP
ENDDO

SELECT MXTRAINV
SET ORDER TO 1

GANAN_ANT = VENT_ANT-COSTO_ANT      && GANANCIAS BRUTAS HASTA EL PERIODO ANTERIOR
GANAN_ACT = VENT_ACT - M->COSTO_ACT   && GANANCIAS BRUTAS DEL PERIODO ACTUAL

SELECT MXCTAINV

XGRUPO=GRUPO
IF II_ORDEN=3.OR.II_ORDEN=4
  IF XGRUPO<>GRUZOX
    ESCRIBE([])
    ESCRIBE([GRUPO = ]+XGRUPO+[ ( ]+NOMCOD(XGRUPO,[MXGRUINV],[NOMGRUART])+[ ) ])
    ESCRIBE([])
  ENDIF
ENDIF
IF !IMPRE
  ESCRIBE(CODART+[ ]+TRAN(CANT_ANT,[999,999.999])+[  ]+TRANS(GANAN_ANT,tran16)+;
          [     ]+TRANS(CANT_ACT,[999,999.999])+[  ]+TRANS(GANAN_ACT,tran16))
ELSE
  ESCRIBE(CODART+[ ]+SUBSTR(NOMART,1,12)+[ ]+STR(CANT_ANT,10,3)+[ ]+STR(COSTO_ANT,12,G_REDONDO)+[ ]+;
  STR(VENT_ANT,13,G_REDONDO)+[ ]+STR(GANAN_ANT,13,G_REDONDO)+[ ]+STR(CANT_ACT,10,3)+[ ]+STR(M->COSTO_ACT,12,G_REDONDO)+;
  [ ]+STR(VENT_ACT,13,G_REDONDO)+[ ]+STR(GANAN_ACT,13,G_REDONDO))
ENDIF
CT_ANT_GRU=CT_ANT_GRU+COSTO_ANT
VT_ANT_GRU=VT_ANT_GRU+VENT_ANT
CT_ACT_GRU=CT_ACT_GRU+M->COSTO_ACT
VT_ACT_GRU=VT_ACT_GRU+VENT_ACT
GB_ANT_GRU=GB_ANT_GRU+GANAN_ANT
GB_ACT_GRU=GB_ACT_GRU+GANAN_ACT
CT_ANT_GEN=CT_ANT_GEN+COSTO_ANT
VT_ANT_GEN=VT_ANT_GEN+VENT_ANT
CT_ACT_GEN=CT_ACT_GEN+M->COSTO_ACT
VT_ACT_GEN=VT_ACT_GEN+VENT_ACT
GB_ANT_GEN=GB_ANT_GEN+GANAN_ANT
GB_ACT_GEN=GB_ACT_GEN+GANAN_ACT
IF II_ORDEN=3.OR.II_ORDEN=4
  GRUZOX=GRUPO
  IF EOF().OR.!&I_CONDICION
    GRUZOX=[****]
  ENDIF
ENDIF


IF !I_MANUAL
  SKIP
ENDIF

XGRUPO=GRUPO
IF II_ORDEN=3.OR.II_ORDEN=4
  IF XGRUPO<>GRUZOX
    IF IMPRE
      ESCRIBE(REPLICATE([Ä],I_ANCHO))
      ESCRIBE([TOTAL ]+NOMCOD(GRUZOX,[MXGRUINV],[PAD(NOMGRUART,33)])+[ ]+STR(CT_ANT_GRU,12,G_REDONDO)+;
             [ ]+STR(VT_ANT_GRU,13,G_REDONDO)+[ ]+STR(GB_ANT_GRU,13,G_REDONDO)+SPACE(12)+;
             STR(CT_ACT_GRU,12,G_REDONDO)+[ ]+STR(VT_ACT_GRU,13,G_REDONDO)+[ ]+STR(GB_ACT_GRU,13,G_REDONDO))
      ESCRIBE(REPLICATE([Ä],I_ANCHO))
      ESCRIBE([])
    ELSE
      ESCRIBE(REPLICATE([Ä],79),C_TIT2)
      ESCRIBE([TOTAL ]+GRUZOX+SPACE(18)+TRANS(GB_ANT_GRU,TRAN16)+SPACE(18)+TRANS(GB_ACT_GRU,TRAN16),C_TIT2)
      ESCRIBE(REPLICATE([Ä],79))
      ESCRIBE([])
    ENDIF
    STORE 0.00 TO CT_ANT_GRU,VT_ANT_GRU,VT_ACT_GRU,CT_ACT_GRU,GB_ANT_GRU,GB_ACT_GRU
  ENDIF
ENDIF
RETURN



