      ESCRIBE(REPLICATE('Í',I_ANCHO))
    ENDIF
    ESCRIBE(PAD(MXCTACLI->NOMCLI,35)+[      SALDO AL ]+DTOC(II_FEC2)+[ ---------------->   ]+TRANS(XDEBITOS,TRAN16)+[ ]+TRANS(XCREDITOS,TRAN16)+[ ]+TRANS(XSALDO,TRAN17))
    IF II_SALTO
      ESCRIBE(REPLICATE('Í',I_ANCHO))
    ELSE
      CONTINUA=.F.
      ESCRIBE([])
    ENDIF
  ELSE
    SETCOLOR(C_TIT2)
    ESCRIBE(SPACE(43)+' SALDO AL '+DTOC(II_FEC2)+' '+STR(XSALDO,15,2))
    SETCOLOR(C_TEX2)
  ENDIF
ELSE
 IF !II_SALTO
  CONTINUA=.F.
  ESCRIBE([])
 ENDIF
ENDIF
IF II_SALTO .OR. !IMPRE
  CONTLIN=MAXLIN+1
  PAG=0
ENDIF
STORE 0 TO XDEBITOS,XCREDITOS,XSALDO,TSALDO_ACT,TOT_DEBI,TOT_CRED,TDEB_ANT,TCRE_ANT
SELECT MXCTACLI
IF !I_MANUAL
  SKIP
ELSE
  CTL_MAN()
ENDIF
SIGSIN()
RETURN

PROCEDURE CVEN0408
PARAMETER PPP
STORE 0 TO XDEBITOS,XCREDITOS,XSALDO,TSALDO_ACT,TOT_DEBI,TOT_CRED,TDEB_ANT,TCRE_ANT
CONTINUA=.F.
I_BOTCRI=22
UNA_VEZ=.T.
SETCOLOR(C_TEX2)
IF PCOUNT()=1
 @ 11,16 SAY [ Fechas     >= ]+FC(DTOC(II_FEC1))
 @ 12,16 SAY [ Fechas     <= ]+FC(DTOC(II_FEC2))
 @ 13,16 SAY [ Documentos >= ]+FC(II_NUM1)
 @ 14,16 SAY [ Documentos <= ]+FC(II_NUM2)
 @ 15,16 SAY [  ¨ Cuentas sin movimiento ?]+FC(IF(II_ZERO,[Si],[No]),.T.)
 @ 16,16 SAY [ ¨ Salto de p gina por cta.?]+FC(IF(II_SALTO,[Si],[No]),.T.)
 @ 17,16 SAY [         Tipo: ]+FC(II_TIPO)
 @ 18,16 SAY [   Referencia: ]+FC(II_REF)
 @ 19,16 SAY [     Concepto: ]+FC(SUBSTR(II_CON,1,15))
 @ 20,16 SAY [  Importe   >= ]+FC(IF(II_IMP1=0,SPACE(14),TRANS(II_IMP1,PIC14)))
 @ 21,16 SAY [  Importe   <= ]+FC(IF(II_IMP2=0,SPACE(14),TRANS(II_IMP2,PIC14)))
ELSE
 @ 15,46 SAY [ ]
 @ 16,46 SAY [ ]
 XZERO =IF(II_ZERO,[S],[N])
 XSALTO=IF(II_SALTO,[S],[N])
 CUR_ON()
 @ 11,31 GET II_FEC1
 @ 12,31 GET II_FEC2 VALID II_FEC1<=II_FEC2
 @ 13,31 GET II_NUM1
 @ 14,31 GET II_NUM2
 @ 15,45 GET XZERO  PICT [!] VALID XZERO$[SN]
 @ 16,45 GET XSALTO PICT [!] VALID XSALTO$[SN]
 @ 17,31 GET II_TIPO PICT [!!] VALID II_TIPO$[FCoGRoNDoCAoABoNCo  oC oA oN ]
 @ 18,31 GET II_REF
 @ 19,31 GET II_CON PICTURE "@S15"
 @ 20,31 GET II_IMP1 PICT PIC14
 @ 21,31 GET II_IMP2 PICT PIC14
 READ
 CUR_OFF()
 II_SALTO=XSALTO=[S]
 II_ZERO =XZERO=[S]
ENDIF
SUBTIT2=IF(EMPTY(II_FEC1),[],[ DESDE ]+DTOC(II_FEC1))+[ ]+IF(EMPTY(II_FEC2),[],[ HASTA ]+DTOC(II_FEC2))
I_CRIT2=IF(EMPTY(II_TIPO),[.T.],[ALLTRIM(II_TIPO)$TIPO])+IF(EMPTY(II_REF),[],[.AND. ALLTRIM(II_REF)$REFER])+;
           IF(EMPTY(II_CON),[],[.AND.UPPER(ALLTRIM(II_CON))$UPPER(CONCEPTO)])+;
           IF(II_IMP1=0,[],[.AND.IMPORTE>=II_IMP1])+IF(II_IMP2=0,[],[.AND.IMPORTE<=II_IMP2])
I_CRIT2=I_CRIT2+IF(EMPTY(II_NUM1),[],[.AND. NUMDOC>=II_NUM1])+IF(EMPTY(II_NUM2),[],[.AND.NUMDOC<=II_NUM2])
SUBTIT2=SUBTIT2+IF(EMPTY(II_NUM1),[],[ DOCUMENTOS>=]+II_NUM1)+IF(EMPTY(II_NUM2),[],[ DOCUMENTOS<=]+II_NUM2)
SUBTIT3=IF(EMPTY(II_TIPO),[],[TIPO=]+II_TIPO)+IF(EMPTY(II_REF),[],[ REFERENCIA=]+ALLTRIM(II_REF))+;
        IF(EMPTY(II_CON),[],[ CONCEPTO=]+ALLTRIM(II_CON))+IF(II_IMP1=0,[],[ IMPORTE>=]+LTRIM(STR(II_IMP1,12,2)))+;
        IF(II_IMP2=0,[],[ IMPORTE<=]+LTRIM(STR(II_IMP2,12,2)))
IF II_RENG=2
  I_CRIT2=I_CRIT2+IF(EMPTY(II_FEC1),[],[.AND. EMISION>=II_FEC1])+IF(EMPTY(II_FEC2),[],[.AND.EMISION<=II_FEC2])
ENDIF
IF II_ORDEN=1.OR.II_ORDEN=2
  QUE_CAMPO=II_ORDEN
  I_PLAN=[SELINFCLI]
  PREPOPC[5]=.T.
ELSEIF II_ORDEN=3.OR.II_ORDEN=4
  QUE_CAMPO=13
  I_PLAN=[SELINFGRU]
  PREPOPC[5]=.T.
ELSE
  QUE_CAMPO=9
  I_PLAN=3
  PREPOPC[5]=.F.
ENDIF
RETURN

