FUNCTION TABLAPAG
PARAMETER FORMA
PRIVATE DEVO
IF FORMA=[EF]
  DEVO=[]
ELSEIF FORMA=[CH]
  DEVO=SPACE(10)+[No. CHEQUE: ]+NUMPAG+[   BANCO: ]+NOMPAG
ELSEIF FORMA=[TA]
  DEVO=SPACE(9)+[No. TARJETA: ]+NUMPAG+[ TARJETA: ]+NOMPAG
ELSEIF FORMA=[DP]
  DEVO=SPACE(8)+[No. DEPOSITO: ]+NUMPAG+[   BANCO: ]+NOMPAG
ELSE
  DEVO=SPACE(7)+[No. DOCUMENTO: ]+NUMPAG+[REF. PAGO: ]+NOMPAG
ENDIF
RETURN(DEVO)

