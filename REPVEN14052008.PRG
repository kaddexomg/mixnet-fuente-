RETURN

PROCEDURE DVEN0407
*DETALLE ANALISIS DE VENCIMIENTO
SELECT MXCTACLI
UZONA=ZONA
CTL_MAN()
IF &I_CRITERIO
 XCODMOVCLI=CODCLI
 XNOMBRE=PAD(NOMCLI,35)
 XZONA=ZONA
 SELE MXTRACOB
 SEEK(XCODMOVCLI)
 IF FOUND()
  //SELE MXTRACOB
  XYFECHA := II_FEC
  XNUMERO := '='
  DO WHILE !EOF() .AND. CODMOVCLI=XCODMOVCLI
   IF EMISION <= xYFECHA
   IF NUMDOC<>XNUMERO
    XDIAS=VENCE-XYFECHA
    XNUMERO=NUMDOC
   ENDIF
   IF XDIAS<0
    DIAS=-XDIAS
    DO CASE
     CASE DIAS>AUXIL->DIA13
      VENCE07=VENCE07+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA11 .AND. DIAS<=AUXIL->DIA12
      VENCE06=VENCE06+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA09 .AND. DIAS<=AUXIL->DIA10
      VENCE05=VENCE05+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA07 .AND. DIAS<=AUXIL->DIA08
      VENCE04=VENCE04+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA05 .AND. DIAS<=AUXIL->DIA06
      VENCE03=VENCE03+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA03 .AND. DIAS<=AUXIL->DIA04
      VENCE02=VENCE02+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA01 .AND. DIAS<=AUXIL->DIA02
      VENCE01=VENCE01+E_IMPORTE(IMPORTE,EMISION)
    ENDCASE
    SKIP
    LOOP
   ELSE
    DIAS=XDIAS
    DO CASE
     CASE DIAS>=AUXIL->DIA01 .AND. DIAS<=AUXIL->DIA02
      PVENCE01=PVENCE01+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA03 .AND. DIAS<=AUXIL->DIA04
      PVENCE02=PVENCE02+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA05 .AND. DIAS<=AUXIL->DIA06
      PVENCE03=PVENCE03+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA07 .AND. DIAS<=AUXIL->DIA08
      PVENCE04=PVENCE04+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA09 .AND. DIAS<=AUXIL->DIA10
      PVENCE05=PVENCE05+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>=AUXIL->DIA11 .AND. DIAS<=AUXIL->DIA12
      PVENCE06=PVENCE06+E_IMPORTE(IMPORTE,EMISION)
     CASE DIAS>AUXIL->DIA13
      PVENCE07=PVENCE07+E_IMPORTE(IMPORTE,EMISION)
    ENDCASE
    SKIP
   ENDIF
   ELSE
    SKIP
   ENDIF
  ENDDO

  SUBT_VEN= VENCE07+VENCE06+VENCE05+VENCE04+VENCE03+VENCE02+VENCE01
  SUBT_POR= PVENCE07+PVENCE06+PVENCE05+PVENCE04+PVENCE03+PVENCE02+PVENCE01
  SUBT_GEN= SUBT_VEN+SUBT_POR

  TOT_VEN1=TOT_VEN1+VENCE01
  TOT_VEN2=TOT_VEN2+VENCE02
  TOT_VEN3=TOT_VEN3+VENCE03
  TOT_VEN4=TOT_VEN4+VENCE04
  TOT_VEN5=TOT_VEN5+VENCE05
  TOT_VEN6=TOT_VEN6+VENCE06
  TOT_VEN7=TOT_VEN7+VENCE07

  TOT_POR1=TOT_POR1+PVENCE01
  TOT_POR2=TOT_POR2+PVENCE02
  TOT_POR3=TOT_POR3+PVENCE03
  TOT_POR4=TOT_POR4+PVENCE04
  TOT_POR5=TOT_POR5+PVENCE05
  TOT_POR6=TOT_POR6+PVENCE06
  TOT_POR7=TOT_POR7+PVENCE07

  TOTF_VEN=TOT_VEN1+TOT_VEN2+TOT_VEN3+TOT_VEN4+TOT_VEN5+TOT_VEN6+TOT_VEN7
  TOTF_POR=TOT_POR1+TOT_POR2+TOT_POR3+TOT_POR4+TOT_POR5+TOT_POR6+TOT_POR7
  TOTF_GEN=TOTF_VEN+TOTF_POR

  DO SUTAZON

  IF II_RES='R'
   IF IMPRE
    IF II_SEPA='S'
     ESCRIBE( 'CODIGO : '+XCODMOVCLI+' '+XNOMBRE+' ZONA:'+XZONA)
     ESCRIBE( 'TOTAL POR VENCER :'+TRANS(SUBT_POR,LATI17)+' '+TRANS(PVENCE01,LATI16)+' '+;
     TRANS(PVENCE02,LATI16)+' '+TRANS(PVENCE03,LATI16)+' '+TRANS(PVENCE04,LATI16)+' '+;
     TRANS(PVENCE05,LATI16)+' '+TRANS(PVENCE06,LATI16)+' '+TRANS(PVENCE07,LATI16))
     ESCRIBE( 'TOTAL VENCIDOS   :'+TRANS(SUBT_VEN,LATI17)+' '+TRANS(VENCE01,LATI16)+' '+;
     TRANS(VENCE02,LATI16)+' '+TRANS(VENCE03,LATI16)+' '+TRANS(VENCE04,LATI16)+' '+;
     TRANS(VENCE05,LATI16)+' '+TRANS(VENCE06,LATI16)+' '+TRANS(VENCE07,LATI16))
     ESCRIBE( 'TOTAL            :'+TRANS(SUBT_GEN,LATI17))
    ELSE
     ESCRIBE( 'CODIGO : '+XCODMOVCLI+' '+XNOMBRE+' ZONA:'+XZONA)
     ESCRIBE( 'TOTAL POR VENCER :'+STR(SUBT_POR,14,G_REDONDO)+' '+STR(PVENCE01,13,G_REDONDO)+' '+;
     STR(PVENCE02,13,G_REDONDO)+' '+STR(PVENCE03,13,G_REDONDO)+' '+STR(PVENCE04,13,G_REDONDO)+' '+;
     STR(PVENCE05,13,G_REDONDO)+' '+STR(PVENCE06,13,G_REDONDO)+' '+STR(PVENCE07,13,G_REDONDO))
     ESCRIBE( 'TOTAL VENCIDOS   :'+STR(SUBT_VEN,14,G_REDONDO)+' '+STR(VENCE01,13,G_REDONDO)+' '+;
     STR(VENCE02,13,G_REDONDO)+' '+STR(VENCE03,13,G_REDONDO)+' '+STR(VENCE04,13,G_REDONDO)+' '+;
     STR(VENCE05,13,G_REDONDO)+' '+STR(VENCE06,13,G_REDONDO)+' '+STR(VENCE07,13,G_REDONDO))
     ESCRIBE( 'TOTAL           :'+STR(SUBT_GEN,15,G_REDONDO))
    ENDIF
    ESCRIBE([])
   ELSE
    ESCRIBE(REPLICATE('=',79),C_TIT2)
    ESCRIBE("CODIGO: " +XCODMOVCLI+' '+'NOMBRE: '+XNOMBRE+' ZONA: '+XZONA,C_TIT2)
    ESCRIBE(REPLICATE('-',79),C_TIT2)
    ESCRIBE(SPACE(39)+'VENCIDOS           POR VENCER',C_TIT2)
    ESCRIBE(SPACE(13)+STR(AUXIL->DIA01,3)+' A  '+STR(AUXIL->DIA02,3),C_TIT2)
    ESCRIBE(SPACE(13)+STR(AUXIL->DIA03,3)+' A  '+STR(AUXIL->DIA04,3),C_TIT2)
    ESCRIBE(SPACE(13)+STR(AUXIL->DIA05,3)+' A  '+STR(AUXIL->DIA06,3),C_TIT2)
    ESCRIBE(SPACE(13)+STR(AUXIL->DIA07,3)+' A  '+STR(AUXIL->DIA08,3),C_TIT2)
    ESCRIBE(SPACE(13)+STR(AUXIL->DIA09,3)+' A  '+STR(AUXIL->DIA10,3),C_TIT2)
    ESCRIBE(SPACE(13)+STR(AUXIL->DIA11,3)+' A  '+STR(AUXIL->DIA12,3),C_TIT2)
    ESCRIBE(SPACE(15)+'+ DE '+STR(AUXIL->DIA13,3),C_TIT2)
    SETCOLOR(C_TEX2)
    @ 07,31 SAY TRANS(VENCE01,TRAN16)
    @ 07,52 SAY TRANS(PVENCE01,TRAN16)
    @ 08,31 SAY TRANS(VENCE02,TRAN16)
    @ 08,52 SAY TRANS(PVENCE02,TRAN16)
    @ 09,31 SAY TRANS(VENCE03,TRAN16)
    @ 09,52 SAY TRANS(PVENCE03,TRAN16)
    @ 10,31 SAY TRANS(VENCE04,TRAN16)
    @ 10,52 SAY TRANS(PVENCE04,TRAN16)
    @ 11,31 SAY TRANS(VENCE05,TRAN16)
    @ 11,52 SAY TRANS(PVENCE05,TRAN16)
    @ 12,31 SAY TRANS(VENCE06,TRAN16)
    @ 12,52 SAY TRANS(PVENCE06,TRAN16)
    @ 13,31 SAY TRANS(VENCE07,TRAN16)
    @ 13,52 SAY TRANS(PVENCE07,TRAN16)
    ESCRIBE( REPLICATE('-',79),C_TIT2)
    ESCRIBE( '             TOTAL            ',C_TIT2)
    ?? TRANS(SUBT_VEN,TRAN17)+'    '+TRANS(SUBT_POR,TRAN17)
    ESCRIBE( '             TOTAL GENERAL    ',C_TIT2)
    ?? TRANS(SUBT_GEN,TRAN17)
    CONTLIN=MAXLIN+1
   ENDIF
  ENDIF
  STORE 0 TO VENCE01,VENCE02,VENCE03,VENCE04,VENCE05,VENCE06,VENCE07
  STORE 0 TO PVENCE01,PVENCE02,PVENCE03,PVENCE04,PVENCE05,PVENCE06,PVENCE07
 ENDIF
ENDIF
SELE MXCTACLI
IF !I_MANUAL
  SKIP
ENDIF
DO TOTAZON
RETURN

