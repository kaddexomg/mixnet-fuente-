DO CASE

 CASE ICAMPO=1
  @ FFF,CCC GET XCODCLI PICT '@!' VALID (CHKDUP(XCODCLI,[Proveedor]) .AND. !EMPTY(XCODCLI)) .OR. LASTKEY()=5

 OTHERWISE
  @ FFF,CCC GET &BR_CAMPO

