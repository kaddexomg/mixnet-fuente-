static function activdes()
 local mens
 IF USTR_DESPRO='N'
   PARE('USUARIO NO AUTORIZADO PARA REALIZAR ESTA ACCION')
   RETURN NIL
 ENDIF
 SET KEY -7 TO
 mens:=if(!inactivo,' ¨ Desea Desactivar al Proveedor Actual ? ',' ¨ Desea Activar al Proveedor Actual ? ')
 if decis(mens,2)='S'
    if rlock()
       mxctapro->inactivo := if(inactivo,.f.,.t.)
       mxctapro->(dbunlock())
    endif
    detpro()
 endif
 SET KEY -7 TO activdes()
return nil




