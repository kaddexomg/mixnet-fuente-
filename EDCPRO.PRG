PROCEDURE RPLPRO
* REEMPLAZO EN EL REGISTRO

LOCAL COUNT:=0

SELECT MXCTAPRO
set order to 1

UNLOCK
WHILE !FLOCK() .AND. COUNT<=1000
 COUNT++
ENDDO
AUDITORIA([Acceso a mantenimiento de proveedores],xcodcli,codcli,IF(MODIFICA,[MOD],[INC]))
REPLACE CODCLI     WITH XCODCLI
REPLACE NOMCLI     WITH XNOMCLI
REPLACE EMAIL      WITH XEMAIL
REPLACE GRUPO      WITH XGRUPO
REPLACE CIF        WITH XCIF
REPLACE NIT        WITH XNIT
REPLACE DIREC1     WITH XDIREC1
REPLACE DIREC2     WITH XDIREC2
REPLACE DIREC3     WITH XDIREC3
REPLACE DIREC4     WITH XDIREC4
REPLACE TLF1       WITH XTLF1
REPLACE TLF2       WITH XTLF2
REPLACE FAX        WITH XFAX
REPLACE ESTATUS    WITH XESTATUS
REPLACE LIM_CRE    WITH XLIM_CRE
*REPLACE DIA_CRE    WITH XDIA_CRE
REPLACE DESCUENTO  WITH XDESCUENTO
REPLACE OBSERVA    WITH XOBSERVA
REPLACE CONTACTO   WITH XCONTACTO
REPLACE ZONA       WITH XZONA , CODCON WITH XCODCON,;
 REGIMEN    WITH XREGIMEN,;
 CTABANCO   WITH XCTABANCO,;
 BANCO      WITH XBANCO,;
 FORMA      WITH XFORMA,;
 FECHA_MOD  WITH Date(),;
 HORA_MOD   WITH STRTRAN(TIME(),':'),;
 PORRIVA    WITH XPORRIVA,;
 TPROV      WITH XTPROV
UNLOCK
xcodcli:=new_num(xcodcli)

RETURN

