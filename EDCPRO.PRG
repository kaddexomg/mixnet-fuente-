PRIVATE TCODCLI,TNOMCLI
BUS([BPROFUN])
*SET ORDER TO 1
SETCOLOR(C_TIT2)
RETURN

PROCEDURE BPROFUN
* BUSQUEDA
@  4,20 GET BCODCLI PICT '@!'
@  5,20 GET BNOMCLI PICT '@!S55'
LEER()
SALIR=ESCAPAR() .OR. ( EMPTY(BCODCLI) .AND. EMPTY(BNOMCLI) )

IF !SALIR
 IF !EMPTY(BCODCLI)
  TCODCLI=TRIM(BCODCLI)
  YKEY=TCODCLI
  SET ORDER TO 1
 ELSE
  TNOMCLI=TRIM(BNOMCLI)
  YKEY=TNOMCLI
  SET ORDER TO 2
 ENDIF
ENDIF
RETURN

STATIC FUNCTION CHZON(LA_ZON)
LOCAL USEL,DEVO:=.T.
IF LASTKEY()=5
 RETURN .T.
ENDIF
IF !EMPTY(LA_ZON)
 USEL =SELECT()
 SELECT MXCTAZON
 SEEK(LA_ZON)
 IF !FOUND()
  ZON0000()
  DEVO=.F.
  IF LASTKEY()=27
   KEYBOARD SALIDA
   WAIT
   DEVO=.T.
  ENDIF
* ELSE
*  @ fil,col SAY NOMCOD(EL_VEN,[MXCTATRP],[NOMTRP])
 ENDIF
 SELE (USEL)
ENDIF
RETURN DEVO

PROCEDURE NUEVOPRO
PRIVATE XCODCLI,XNOMCLI,XEMAIL,XGRUPO,XCIF,XDIREC1,XDIREC2,XDIREC3,XDIREC4,XTLF1,XTLF2,XFAX,XESTATUS
PRIVATE XLIM_CRE,XDIA_CRE,XDESCUENTO,XOBSERVA,XCONTACTO,XZONA,XCOBRADOR,XVENDEDOR,XCODCON
PRIVATE XREGIMEN,XCTABANCO,XFORMA,XBANCO
PRIVATE XNIT,XFECHAING
PRIVATE MODIFICA,UREG,PROXCLI,LREG, XCIF
PRIVATE XPORRIVA:=0.00
PRIVATE XTPROV
PRIVATE PVFILE:=CE([MXCOMPPG.MTD])
IF FILE(PVFILE)
 RESTORE FROM (PVFILE) ADDITIVE
ENDIF

SELECT MXCTAPRO
LREG=-1
UREG=RECNO()
SAVE SCREEN
IF ABRIR([MXGRUCLI],MXGRUCLI,[S],MXGRCLX1)
 IF ABRIR([MXCTAZON],MXCTAZON,[S],MXCTZOX1)
  SELECT MXCTAPRO
  XGRUPO=GRUPO
  MODIFICA=.F.
  INIT_VER()
  DO MENSAJ WITH MEN2
  DO MASPRO
  DO DEFPRO
  CUR_ON()
  DO GETPRO
  CUR_OFF()
  IF !SALIR
   SELECT MXCTAPRO
   ADD_REC(0)
   RPLPRO()
   UREG=RECNO()
   INC_CLI=.T.
   KEYBOARD ESCAPE
  ENDIF
  SELEC MXCTAPRO
  GOTO UREG
  RESTORE SCREEN
 CERRAR([MXCTAZON])
 ENDIF
 CERRAR([MXGRUCLI])
ENDIF
SELECT MXCTAPRO
RETURN


STATIC FUNCTION CHCODBAN(EL_COD)
LOCAL USEL:=SELECT(),DEVO, LA_CU:=.T.
IF LASTKEY()=5
 RETURN .T.
ENDIF
DEVO =.T.
if !empty(el_cod)
IF ABRIR([MXCTABAN],MXCTABAN,[S],MXCTBAX1)
 SEEK(EL_COD)
 IF !FOUND()
  BAN0000()
  DEVO=LASTKEY()=27
  XCTABANCO  := SPACE(15)
 ELSE
  XCTABANCO=MXCTABAN->CUENTA
 ENDIF
 CERRAR('MXCTABAN')
else
 XCTABANCO  := SPACE(15)
ENDIF
SELE (USEL)
ENDIF
RETURN DEVO


