STATIC FUNCTION CHREGIMEN(TU_TIPO)
IF LASTKEY()=5
 RETURN .T.
ENDIF
IF TU_TIPO$'0123'
 RETURN .T.
ENDIF
PARE([0= EXENTO, 1 = NACIONAL, 2 = IMPORTACION ])
RETURN .F.

STATIC FUNCTION CHGRU
 PARAMETER EL_CODGRU
 PRIVATE ENC
 ENC=.T.
 IF EMPTY(EL_CODGRU)
    RETURN(.T.)
 ENDIF
 SELE MXGRUCLI
 SEEK(EL_CODGRU)
 IF !FOUND()
  DO GRC0000
  IF LASTKEY()=27
   KEYBOARD SALIDA
   WAIT
  ENDIF
  ENC=.F.
 ELSE
  @ 6,26 SAY NOMCOD(EL_CODGRU,[MXGRUCLI],[NOMGRUCLI])
 ENDIF
 SELECT MXCTAPRO
RETURN ENC

PROCEDURE DETPRO
SETCOLOR(C_TIT2)
IF !EOF()
@  2,60 SAY 'PROVEEDOR '+if(!inactivo,'ACTIVO  ','INACTIVO')
@  4,20 SAY CODCLI
@  5,20 SAY PAD(NOMCLI,55)
@  6,20 SAY GRUPO
@  6,26 SAY IF(!EMPTY(GRUPO),NOMCOD(GRUPO,[MXGRUCLI],[NOMGRUCLI]),SPACE(40))
@  7,20 SAY CIF
@  8,20 SAY NIT
@  9,20 SAY DIREC1
@ 10,20 SAY DIREC2
@ 11,20 SAY DIREC3
@ 12,20 SAY DIREC4
@ 13,20 SAY TLF1
@ 14,20 SAY TLF2
@ 15,20 SAY FAX
@ 16,20 SAY BS(LIM_CRE) PICT '999999999'
@ 16,37 SAY ESTATUS
@ 18,19 SAY DESCUENTO
@ 19,20 SAY OBSERVA

@  7,63 SAY REGIMEN
@  8,63 SAY PORRIVA
@  9,63 SAY FORMA
@ 10,63 SAY BANCO
@ 11,63 SAY CTABANCO
@ 12,54 SAY PAD(EMAIL,24)

@ 13,55 SAY CONTACTO
@ 14,55 SAY ZONA
@ 15,55 SAY CODCON
@ 16,55 SAY TPROVEE()
@ 17,55 SAY PAD(TRANSFORM(BS(SALDO),TRAN16),16)
ENDIF
RETURN

STATIC FUNCTION TPROVEE()
RETURN(pad(IF(TPROV='SR','Sin RIF.',IF(TPROV='NR','No Residenciado',IF(TPROV='ND','No Domiciliado','Normal'))),15))

PROCEDURE GETBPRO
* CAPTURA DE CAMPOS EN MODO BROWSE
PRIVATE FFF,CCC
FFF=ROW()
CCC=COL()
