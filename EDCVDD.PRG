PROCEDURE SELINFVEN
PARAMETERS P1,P2,P3
edit_ventana('SELVDD')
RETURN


FUNCTION CHVEN
PARAMETER EL_VEN, fil,col
PRIVATE USEL,DEVO:=.t.
IF LASTKEY()=5
 RETURN .T.
ENDIF
IF !EMPTY(EL_VEN)
 USEL =SELECT()
 SELE MXCTAVDD
 SEEK(EL_VEN)
 IF !FOUND()
  SELINFVEN()
  DEVO=.F.
  IF LASTKEY()=27
   KEYBOARD SALIDA
   WAIT
   DEVO=.T.
  ENDIF
 ELSE
  IF TYPE('FIL')<>'U'
   @ fil,col SAY NOMCOD(EL_VEN,[MXCTAVDD],[NOMVEN])
  ENDIF
  XCOMISION=COMISION
 ENDIF
 SELE (USEL)
ENDIF
RETURN DEVO

