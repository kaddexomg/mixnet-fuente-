PROCEDURE GETBVDD
* CAPTURA DE CAMPOS EN MODO BROWSE
DO CASE
 CASE ICAMPO=1
  @ ROW(),COL() GET XCODVEN  PICT [@!] VALID CHK_CLAVE(XCODVEN,[Vendedor])
 CASE ICAMPO=2
  @ ROW(),COL() GET XNOMVEN   
 CASE ICAMPO=3
  @ ROW(),COL() GET XCOMISION  PICT "99.99"
 CASE ICAMPO=4
  @ ROW(),COL() GET XCOMISION1 PICT "99.99"
 CASE ICAMPO=5
  @ ROW(),COL() GET XCOMISION2  PICT "99.99"
 CASE ICAMPO=6
  @ ROW(),COL() GET XCOMISION3  PICT "99.99"
ENDCASE
READ
SALIR=ESCAPAR()
RETURN

