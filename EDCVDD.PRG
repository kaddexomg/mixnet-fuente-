PROCEDURE BUSVDD
PRIVATE TCODVEN,TNOMVEN
VERTBUS([BFUNVDD])
RETURN

PROCEDURE BFUNVDD
* BUSQUEDA
@  CONTLIN,2+MARGEN GET BCODVEN
@  CONTLIN,9+MARGEN GET BNOMVEN 
LEER()

SALIR=ESCAPAR() .OR. ( EMPTY(BCODVEN) .AND. EMPTY(BNOMVEN) )

IF !SALIR
 IF !EMPTY(BCODVEN)
  TCODVEN=TRIM(BCODVEN)
  YKEY=TCODVEN
 ELSE
  TNOMVEN=TRIM(BNOMVEN)
  BCONDICION=[TNOMVEN$NOMVEN]
  POR_INDICE=.F.
 ENDIF
ENDIF
RETURN

