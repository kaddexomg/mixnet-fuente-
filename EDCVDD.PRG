PROCEDURE SELINFVEN
PARAMETERS P1,P2,P3
PRIVATE ULT_ALIAS, uctl2:=ctl_men[2],uctl3:=ctl_men[3]
DECLARE ULT_REC[10],ULT_IND[10],ABIERTA[10],RSUBTIT[ 2],RCAMPO[2]
